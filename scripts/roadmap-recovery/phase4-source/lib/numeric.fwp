# Numerical computing: statically sized vectors and matrices, complex
# numbers and dense linear algebra.
#
# `vector [1.0, 2.0]` has type Vector[F64, 2] and `matrix [[1, 2], [3, 4]]`
# has type Matrix[I64, 2, 2]: dimensions come from the literal and take
# part in type checking, so `a | matmul b` with mismatched inner
# dimensions is a compile error. A size known only when the program runs
# is abstract: `vector.from-list : List[t] -> Vector[t, _]` gives each
# call a size of its own, unknown but rigid, and `vector.same-size` checks
# at run time that two vectors agree. Performance: abstract sizes cost a
# length comparison and an `Option` at each such check.

Vector[T, N] = { data: Array[T] }
Matrix[T, M, N] = { rows: I64, cols: I64, data: Array[T] }

# A vector or matrix whose sizes are hidden, so that values of different
# sizes have one type: a list may hold vectors of any lengths. `unpack`
# gives the sizes back as abstract ones, a fresh size for each value.
AnyVector[T] = { data: Array[T] }
AnyMatrix[T] = { rows: I64, cols: I64, data: Array[T] }

# ---------------------------------------------------------------- vectors

# The size parameter is taken from the literal argument.
vector : List[t] -> Vector[t, n]
vector = array.from-list | make Vector { data = id }

vector.wrap : Array[t] -> Vector[t, n]
vector.wrap = make Vector { data = id }

# forget the size: the result has a size of its own
vector.forget : Vector[t, n] -> Vector[t, _]
vector.forget = .data | vector.wrap

# hide the size (see `AnyVector`)
vector.pack : Vector[t, n] -> AnyVector[t]
vector.pack = make AnyVector { data = .data }

# a packed vector with a size of its own
vector.unpack : AnyVector[t] -> Vector[t, _]
vector.unpack = .data | vector.wrap

# the size is the length of the list, known when the program runs
vector.from-list : List[t] -> Vector[t, _]
vector.from-list = array.from-list | vector.wrap

# `ys | vector.same-size xs` is `ys` with the size of `xs` when their
# lengths agree
vector.same-size : Vector[a, m] -> Vector[b, n] -> Option[Vector[b, m]]
vector.same-size = curry (if
    (fork eq (.0 | vector.length) (.1 | vector.length))
    (.1 | .data | vector.wrap | Some)
    (const None))

vector.to-list : Vector[t, n] -> List[t]
vector.to-list = .data | array.to-list

vector.length : Vector[t, n] -> I64
vector.length = .data | array.length

vector.get : I64 -> Vector[t, n] -> Option[t]
vector.get = array.get | compose .data

# `a | vector.append b` is the elements of `a`, then those of `b`: its
# size is the sum of theirs
vector.append : Vector[t, m] -> Vector[t, n] -> Vector[t, n + m]
vector.append =
    curry (both (.0 | .data) (.1 | .data) | uncurry array.append | vector.wrap)

# `v | vector.push x` is `v` with `x` at the end
vector.push : t -> Vector[t, n] -> Vector[t, n + 1]
vector.push = curry (both .0 (.1 | .data) | uncurry array.push | vector.wrap)

# A vector whose size is `n + 1` has an element whatever n is, so these
# need no `Option`: the checker proves the vector is not empty.

# the first element
vector.head : Vector[t, n + 1] -> t
vector.head = .data | array.get 0 | vector._present

# the last element
vector.last : Vector[t, n + 1] -> t
vector.last = .data | fork array.get (array.length | sub 1) id | vector._present

# all but the first element
vector.tail : Vector[t, n + 1] -> Vector[t, n]
vector.tail =
    .data | fork (array.slice 1) (array.length | sub 1) id | vector.wrap

# all but the last element
vector.init : Vector[t, n + 1] -> Vector[t, n]
vector.init =
    .data | fork (array.slice 0) (array.length | sub 1) id | vector.wrap

vector._present : Option[t] -> t
vector._present = match
    Some _ -> id
    None -> prim.trap "vector: no element in a vector of size n + 1"

# `v | vector.non-empty` is `v` with a size of the form `_ + 1`, so that
# `vector.head` applies, when it has an element
vector.non-empty : Vector[t, n] -> Option[Vector[t, _ + 1]]
vector.non-empty =
    if (vector.length | lt 1) (const None) (.data | vector.wrap | Some)

# the first k elements (all of them when there are fewer)
vector.take : I64 -> Vector[t, n] -> Vector[t, _]
vector.take = curry (both (.0 | max 0) (.1 | .data)
    | uncurry (array.slice 0)
    | vector.wrap)

# `v | vector.split w` is the first elements of `v`, as many as `w` has,
# and the rest: a size `n + m` less `m` is `n`, so splitting never runs
# out of elements
vector.split : Vector[a, m] -> Vector[t, n + m] -> (Vector[t, m], Vector[t, n])
vector.split = curry (both (.0 | vector.length) (.1 | .data)
    | uncurry vector._cut
    | both (.0 | vector.wrap) (.1 | vector.wrap))

# the first k elements of an array, and the rest
# internal
vector._cut : I64 -> Array[t] -> (Array[t], Array[t])
vector._cut = curry (both
    (uncurry (array.slice 0))
    (fork apply .1 (fork array.slice .0 (fork sub .0 (.1 | array.length)))))

# the elements that satisfy p
vector.filter : (t -> Bool) -> Vector[t, n] -> Vector[t, _]
vector.filter = curry (both .0 (.1 | vector.to-list)
    | uncurry filter
    | array.from-list
    | vector.wrap)

# Lift an array function to vectors of the same size.
vector.via : (Array[a] -> Array[b]) -> Vector[a, n] -> Vector[b, n]
vector.via = compose .data | flip compose vector.wrap

vector.map : (a -> b) -> Vector[a, n] -> Vector[b, n]
vector.map = array.map | vector.via

# `xs | vector.zip-with f ys` combines elements at the same position as
# `f y x` (the subject last, like zip-with): `a | vector.sub b` is a - b
vector.zip-with : (b -> a -> c) -> Vector[b, n] -> Vector[a, n] -> Vector[c, n]
vector.zip-with = curry3 (both
        (both .0 (.1 | vector.to-list) | uncurry zip-with)
        (.2 | vector.to-list)
    | uncurry id
    | array.from-list
    | vector.wrap)

vector.add : Vector[t, n] -> Vector[t, n] -> Vector[t, n] where Add[t]
vector.add = vector.zip-with add

vector.sub : Vector[t, n] -> Vector[t, n] -> Vector[t, n] where Sub[t]
vector.sub = vector.zip-with sub

vector.scale : t -> Vector[t, n] -> Vector[t, n] where Mul[t]
vector.scale = mul | vector.map

# dot product of two lists
matrix.dot-list : List[t] -> List[t] -> t where Ring[t]
matrix.dot-list = zip-with mul | flip compose sum

dot : Vector[t, n] -> Vector[t, n] -> t where Ring[t]
dot = vector.zip-with mul | flip compose (vector.to-list | sum)

norm : Vector[a, n] -> a where Ring[a], Floating[a], Dup[a]
norm = fork dot id id | sqrt

# --------------------------------------------------------------- matrices

matrix : List[List[t]] -> Matrix[t, m, n]
matrix = make Matrix {
    rows = length,
    cols = head | option.map length | option.unwrap-or 0,
    data = flatten | array.from-list,
}

# the elements row by row: an m by n matrix gives a vector of m * n
matrix.flatten : Matrix[t, m, n] -> Vector[t, m * n]
matrix.flatten = .data | vector.wrap

# `a | matrix.stack b` is the rows of `a`, then those of `b` (the types
# make the column counts agree)
matrix.stack : Matrix[t, k, n] -> Matrix[t, m, n] -> Matrix[t, m + k, n]
matrix.stack = curry (make Matrix {
    rows = fork add (.0 | .rows) (.1 | .rows),
    cols = fork max (.0 | .cols) (.1 | .cols),
    data = both (.0 | .data) (.1 | .data) | uncurry array.append,
})

# `a | matrix.beside b` is `a` with the columns of `b` to its right (the
# types make the row counts agree)
matrix.beside : Matrix[t, m, k] -> Matrix[t, m, n] -> Matrix[t, m, n + k]
matrix.beside = curry (make Matrix {
    rows = fork max (.0 | .rows) (.1 | .rows),
    cols = fork add (.0 | .cols) (.1 | .cols),
    data =
        both (.0 | matrix.rows-of) (.1 | matrix.rows-of)
        | uncurry (zip-with append)
        | flatten
        | array.from-list,
})

# `a | matrix.split-rows v` is the first rows of `a`, as many as `v` has
# elements, and the rows after them
matrix.split-rows : Vector[a, m] -> Matrix[t, k + m, n] -> (Matrix[t, m, n], Matrix[t, k, n])
matrix.split-rows = curry (both (.0 | vector.length) .1 | matrix._split-rows)

# internal
matrix._split-rows : (I64, Matrix[t, j, n]) -> (Matrix[t, m, n], Matrix[t, k, n])
matrix._split-rows = fork matrix._row-halves id (both
        (fork mul .0 (.1 | .cols))
        (.1 | .data)
    | uncurry vector._cut)

# internal
matrix._row-halves : (I64, Matrix[t, j, n]) -> (Array[t], Array[t]) -> (Matrix[t, m, n], Matrix[t, k, n])
matrix._row-halves = curry (both
    (make Matrix { rows = .0 | .0, cols = .0 | .1 | .cols, data = .1 | .0 })
    (make Matrix {
        rows = fork sub (.0 | .0) (.0 | .1 | .rows),
        cols = .0 | .1 | .cols,
        data = .1 | .1,
    }))

# `a | matrix.split-columns v` is the first columns of `a`, as many as
# `v` has elements, and the columns after them
matrix.split-columns : Vector[a, m] -> Matrix[t, r, k + m] -> (Matrix[t, r, m], Matrix[t, r, k])
matrix.split-columns =
    curry (both (.0 | vector.length) .1 | matrix._split-columns)

# internal
matrix._split-columns : (I64, Matrix[t, r, j]) -> (Matrix[t, r, m], Matrix[t, r, k])
matrix._split-columns =
    both
        (make Matrix {
            rows = .1 | .rows,
            cols = .0,
            data =
                fork map (.0 | take) (.1 | matrix.rows-of)
                | flatten
                | array.from-list,
        })
        (make Matrix {
            rows = .1 | .rows,
            cols = fork sub .0 (.1 | .cols),
            data =
                fork map (.0 | drop) (.1 | matrix.rows-of)
                | flatten
                | array.from-list,
        })

# the same matrix, with sizes the caller names (unchecked)
matrix.cast : Matrix[t, j, k] -> Matrix[t, m, n]
matrix.cast = make Matrix { rows = .rows, cols = .cols, data = .data }

# hide the sizes (see `AnyMatrix`)
matrix.pack : Matrix[t, m, n] -> AnyMatrix[t]
matrix.pack = make AnyMatrix { rows = .rows, cols = .cols, data = .data }

# a packed matrix with sizes of its own
matrix.unpack : AnyMatrix[t] -> Matrix[t, _m, _n]
matrix.unpack = make Matrix { rows = .rows, cols = .cols, data = .data }

# forget the sizes: the result has sizes of its own
matrix.forget : Matrix[t, m, n] -> Matrix[t, _m, _n]
matrix.forget = matrix.cast

# `b | matrix.same-shape a` is `b` with the sizes of `a` when their row
# and column counts agree
matrix.same-shape : Matrix[a, m, n] -> Matrix[b, j, k] -> Option[Matrix[b, m, n]]
matrix.same-shape = curry (if
    (fork
        and
        (fork eq (.0 | .rows) (.1 | .rows))
        (fork eq (.0 | .cols) (.1 | .cols)))
    (.1 | matrix.cast | Some)
    (const None))

matrix.square : I64 -> Array[t] -> Matrix[t, n, n]
matrix.square = curry (make Matrix { rows = .0, cols = .0, data = .1 })

matrix.rows-of : Matrix[t, m, n] -> List[List[t]]
matrix.rows-of =
    if
        (.cols | lt 1)
        (.rows | flip repeat [])
        (both .cols (.data | array.to-list) | uncurry chunks)

# `m | matrix.as-square` is `m` as a square matrix when it has as many
# rows as columns
matrix.as-square : Matrix[t, m, n] -> Option[Matrix[t, m, m]]
matrix.as-square = if (fork eq .rows .cols) (matrix.cast | Some) (const None)

# the sizes are those of the rows, known when the program runs
matrix.from-rows : List[List[t]] -> Matrix[t, _m, _n]
matrix.from-rows = matrix

# `m | matrix.get i j` is the element in row i, column j; None when either
# index is out of range (like `nth` and `array.get`)
matrix.get : I64 -> I64 -> Matrix[t, m, n] -> Option[t]
matrix.get = curry3 (if
    matrix.in-bounds
    (both
            (both (both .0 (.2 | .cols) | uncurry mul) .1 | uncurry add)
            (.2 | .data)
        | uncurry array.get)
    (const None))

matrix.in-bounds : (I64, I64, Matrix[t, m, n]) -> Bool
matrix.in-bounds =
    fork
        and
        (fork and (.0 | ge 0) (fork lt (.2 | .rows) .0))
        (fork and (.1 | ge 0) (fork lt (.2 | .cols) .1))

transpose : Matrix[t, m, n] -> Matrix[t, n, m]
transpose = make Matrix {
    rows = .cols,
    cols = .rows,
    data = matrix.rows-of | list.transpose | flatten | array.from-list,
}

# each row of the subject times every column in `cols`
matrix.row-products : List[List[t]] -> List[t] -> List[t] where Ring[t]
matrix.row-products = flip map | compose (flip matrix.dot-list)

# `a | matmul b` is the matrix product a·b
matmul : Matrix[t, k, n] -> Matrix[t, m, k] -> Matrix[t, m, n] where Ring[t]
matmul = curry (make Matrix {
    rows = .1 | .rows,
    cols = .0 | .cols,
    data =
        both
            (.0 | transpose | matrix.rows-of | matrix.row-products)
            (.1 | matrix.rows-of)
        | uncurry map
        | flatten
        | array.from-list,
})

# `m | matrix.apply v` is the product m·v
matrix.apply : Vector[t, n] -> Matrix[t, m, n] -> Vector[t, m] where Ring[t]
matrix.apply = curry (both
        (.0 | vector.to-list | matrix.dot-list)
        (.1 | matrix.rows-of)
    | uncurry map
    | array.from-list
    | vector.wrap)

bool.to-num : Bool -> t where Zero[t], One[t]
bool.to-num = match
    True -> one
    False -> zero

identity : I64 -> Matrix[t, _n, _n] where Zero[t], One[t]
identity = make Matrix {
    rows = id,
    cols = id,
    data =
        fork
            array.generate
            (fork mul id id)
            (both div rem | uncurry (fork eq) | flip compose bool.to-num),
}

# ------------------------------------------------- dense linear algebra (F64)

foreign "fwp" linalg.lu-solve : I64 -> Array[F64] -> Array[F64] -> Option[Array[F64]]
foreign "fwp" linalg.det : I64 -> Array[F64] -> F64
foreign "fwp" linalg.inverse : I64 -> Array[F64] -> Option[Array[F64]]
foreign "fwp" linalg.cholesky : I64 -> Array[F64] -> Option[Array[F64]]
foreign "fwp" linalg.qr : I64 -> I64 -> Array[F64] -> (Array[F64], Array[F64])
foreign "fwp" linalg.cg : I64 -> F64 -> I64 -> Array[F64] -> Array[F64] -> Array[F64]
foreign "fwp" list.transpose : List[List[a]] -> List[List[a]]

# `b | solve a` solves a·x = b (None when a is singular)
solve : Matrix[F64, n, n] -> Vector[F64, n] -> Option[Vector[F64, n]]
solve = curry (both
        (both (.0 | .rows) (.0 | .data) | uncurry linalg.lu-solve)
        (.1 | .data)
    | uncurry id
    | option.map vector.wrap)

determinant : Matrix[F64, n, n] -> F64
determinant = both .rows .data | uncurry linalg.det

inverse : Matrix[F64, n, n] -> Option[Matrix[F64, n, n]]
inverse =
    both .rows (both .rows .data | uncurry linalg.inverse)
    | uncurry (matrix.square | option.map)

# lower-triangular L with a = L·Lᵀ (None if a is not positive definite)
cholesky : Matrix[F64, n, n] -> Option[Matrix[F64, n, n]]
cholesky =
    both .rows (both .rows .data | uncurry linalg.cholesky)
    | uncurry (matrix.square | option.map)

# a = Q·R with orthonormal columns in Q (m×n) and upper-triangular R (n×n)
qr : Matrix[F64, m, n] -> (Matrix[F64, m, n], Matrix[F64, n, n])
qr = make {
    0 = make Matrix { rows = .rows, cols = .cols, data = qr._raw | .0 },
    1 = make Matrix { rows = .cols, cols = .cols, data = qr._raw | .1 },
}

qr._raw : Matrix[F64, m, n] -> (Array[F64], Array[F64])
qr._raw = both (both .rows .cols | uncurry linalg.qr) .data | uncurry id

# `b | cg iterations tolerance a`: conjugate gradient for symmetric
# positive-definite a
cg : I64 -> F64 -> Matrix[F64, n, n] -> Vector[F64, n] -> Vector[F64, n]
cg = curry3 (cg._raw | vector.via)

cg._raw : (I64, F64, Matrix[F64, n, n]) -> Array[F64] -> Array[F64]
cg._raw =
    both
        (both (both .0 .1 | uncurry linalg.cg) (.2 | .rows) | uncurry id)
        (.2 | .data)
    | uncurry id

# ----------------------------------------------------------- complex numbers

Complex[T] = { re: T, im: T }

complex : t -> t -> Complex[t]
complex = curry (make Complex { re = .0, im = .1 })

complex.conj : Complex[t] -> Complex[t] where Neg[t]
complex.conj = update { im = neg }

complex.abs : Complex[a] -> a where Ring[a], Floating[a], Dup[a]
complex.abs = fork add (.re | fork mul id id) (.im | fork mul id id) | sqrt

# component-wise pair of fields from the two operands
# internal
complex.re2 : (Complex[t], Complex[t]) -> (t, t)
complex.re2 = both (.0 | .re) (.1 | .re)
# internal
complex.im2 : (Complex[t], Complex[t]) -> (t, t)
complex.im2 = both (.0 | .im) (.1 | .im)

impl Add[Complex[t]] where Add[t] =
    add = curry (make Complex {
        re = complex.re2 | uncurry add,
        im = complex.im2 | uncurry add,
    })

impl Sub[Complex[t]] where Sub[t] =
    sub = curry (make Complex {
        re = complex.re2 | uncurry sub,
        im = complex.im2 | uncurry sub,
    })

# (a + bi)(c + di) = (ac - bd) + (ad + bc)i
impl Mul[Complex[t]] where Ring[t], Dup[t] =
    mul = curry (make Complex {
        re =
            both (complex.im2 | uncurry mul) (complex.re2 | uncurry mul)
            | uncurry sub,
        im =
            both
                (both (.0 | .re) (.1 | .im) | uncurry mul)
                (both (.0 | .im) (.1 | .re) | uncurry mul)
            | uncurry add,
    })

# data-last: `y | div x` is y / x = y·conj(x) / |x|²
impl Div[Complex[t]] where Field[t], Dup[t] =
    div = curry (make Complex {
        re =
            both
                (.0 | fork add (.re | fork mul id id) (.im | fork mul id id))
                (both
                        (both (.1 | .re) (.0 | .re) | uncurry mul)
                        (both (.1 | .im) (.0 | .im) | uncurry mul)
                    | uncurry add)
            | uncurry div,
        im =
            both
                (.0 | fork add (.re | fork mul id id) (.im | fork mul id id))
                (both
                        (both (.1 | .re) (.0 | .im) | uncurry mul)
                        (both (.1 | .im) (.0 | .re) | uncurry mul)
                    | uncurry sub)
            | uncurry div,
    })

impl Neg[Complex[t]] where Neg[t] =
    neg = update { re = neg, im = neg }

impl Zero[Complex[t]] where Zero[t] =
    zero = Complex { re = zero, im = zero }

impl One[Complex[t]] where Zero[t], One[t] =
    one = Complex { re = one, im = zero }

impl FromInt[Complex[t]] where FromInt[t], Zero[t] =
    from-int = make Complex { re = from-int, im = const zero }

impl FromFloat[Complex[t]] where FromFloat[t], Zero[t] =
    from-float = make Complex { re = from-float, im = const zero }

test "vector" = vector [1, 2, 3] | vector.to-list | eq [1, 2, 3]
test "vector.length" = vector [1.0, 2.0] | vector.length | eq 2
test "vector.get" = vector [5, 6] | vector.get 1 | eq (Some 6)
test "vector.get out of range" = vector [5, 6] | vector.get 2 | eq None
test "vector.append" =
    vector [1, 2] | vector.append (vector [3]) | vector.to-list | eq [1, 2, 3]
test "vector.push" =
    vector [1, 2] | vector.push 3 | vector.to-list | eq [1, 2, 3]
test "matrix.stack" =
    matrix [[1, 2]]
    | matrix.stack (matrix [[3, 4], [5, 6]])
    | matrix.rows-of
    | eq [[1, 2], [3, 4], [5, 6]]
test "matrix.beside" =
    matrix [[1], [2]]
    | matrix.beside (matrix [[3, 4], [5, 6]])
    | matrix.rows-of
    | eq [[1, 3, 4], [2, 5, 6]]
test "matrix.flatten" =
    matrix [[1, 2], [3, 4], [5, 6]]
    | matrix.flatten
    | vector.to-list
    | eq [1, 2, 3, 4, 5, 6]
test "vector.map" =
    vector [1, 2] | vector.map (mul 3) | vector.to-list | eq [3, 6]
test "vector.add" =
    vector [1, 2] | vector.add (vector [10, 20]) | vector.to-list | eq [11, 22]
test "vector.sub" =
    vector [10, 20] | vector.sub (vector [1, 2]) | vector.to-list | eq [9, 18]
test "vector.zip-with order" =
    vector [1, 2]
    | vector.zip-with (curry id) (vector ["a", "b"])
    | vector.to-list
    | eq [("a", 1), ("b", 2)]
test "vector.scale" =
    vector [1, 2] | vector.scale 4 | vector.to-list | eq [4, 8]
test "vector.from-list" = [1, 2, 3] | vector.from-list | vector.length | eq 3
test "dot" = vector [1, 2, 3] | dot (vector [4, 5, 6]) | eq 32
test "norm" = vector [3.0, 4.0] | norm | eq 5.0
test "matrix" = matrix [[1, 2], [3, 4]] | both .rows .cols | eq (2, 2)
test "matrix.rows-of" =
    matrix [[1, 2, 3], [4, 5, 6]] | matrix.rows-of | eq [[1, 2, 3], [4, 5, 6]]
test "matrix.get" = matrix [[1, 2], [3, 4]] | matrix.get 1 0 | eq (Some 3)
test "matrix.get column out of range" =
    matrix [[1, 2], [3, 4]] | matrix.get 0 2 | eq None
test "matrix.get row out of range" =
    matrix [[1, 2], [3, 4]] | matrix.get 2 0 | eq None
test "matrix.get negative" = matrix [[1, 2], [3, 4]] | matrix.get -1 1 | eq None
test "empty matrix" =
    []
    | matrix.from-rows
    | matrix._test-im
    | both matrix.rows-of (transpose | matrix.rows-of)
    | eq ([], [])
test "empty matrix get" =
    [] | matrix.from-rows | matrix._test-im | matrix.get 0 0 | eq None
test "empty matrix product" =
    matrix [] | matrix._test-im | matmul (matrix []) | matrix.rows-of | eq []
test "matrix with empty rows" =
    [[], []] | matrix.from-rows | matrix._test-im | matrix.rows-of | eq [[], []]
test "transpose" =
    matrix [[1, 2, 3], [4, 5, 6]]
    | transpose
    | matrix.rows-of
    | eq [[1, 4], [2, 5], [3, 6]]
test "matmul" =
    matrix [[1, 2], [3, 4]]
    | matmul (matrix [[0, 1], [1, 0]])
    | matrix.rows-of
    | eq [[2, 1], [4, 3]]
test "matmul shapes" =
    matrix [[1, 2, 3], [4, 5, 6]]
    | matmul (matrix [[1], [1], [1]])
    | matrix.rows-of
    | eq [[6], [15]]
test "matrix.apply" =
    matrix [[1, 2], [3, 4]]
    | matrix.apply (vector [1, 1])
    | vector.to-list
    | eq [3, 7]
test "identity" =
    2 | identity | matrix._test-im | matrix.rows-of | eq [[1, 0], [0, 1]]
test "solve" =
    vector [3.0, 5.0]
    | solve (matrix [[2.0, 0.0], [0.0, 4.0]])
    | option.map vector.to-list
    | eq (Some [1.5, 1.25])
test "solve singular" =
    vector [1.0, 1.0]
    | solve (matrix [[1.0, 2.0], [2.0, 4.0]])
    | option.map vector.to-list
    | eq None
test "determinant" =
    matrix [[2.0, 1.0], [1.0, 3.0]] | determinant | sub 5.0 | abs | lt 1e-12
test "inverse" =
    matrix [[2.0, 0.0], [0.0, 4.0]]
    | inverse
    | option.map matrix.rows-of
    | eq (Some [[0.5, 0.0], [0.0, 0.25]])
test "cholesky" =
    matrix [[4.0, 0.0], [0.0, 9.0]]
    | cholesky
    | option.map matrix.rows-of
    | eq (Some [[2.0, 0.0], [0.0, 3.0]])
test "cholesky not positive definite" =
    matrix [[1.0, 2.0], [2.0, 1.0]]
    | cholesky
    | option.map matrix.rows-of
    | eq None
test "qr reconstructs" =
    matrix [[1.0, 2.0], [3.0, 4.0]]
    | qr
    | fork matmul .1 .0
    | matrix.rows-of
    | flatten
    | zip-with sub [1.0, 2.0, 3.0, 4.0]
    | all (abs | lt 1e-9)
test "cg" =
    vector [2.0, 8.0]
    | cg 10 1e-12 (matrix [[2.0, 0.0], [0.0, 4.0]])
    | vector.to-list
    | zip-with sub [1.0, 2.0]
    | all (abs | lt 1e-9)
test "complex add" =
    complex 1.0 2.0 | add (complex 3.0 -1.0) | eq (complex 4.0 1.0)
test "complex sub" =
    complex 1.0 2.0 | sub (complex 3.0 -1.0) | eq (complex -2.0 3.0)
test "complex mul" =
    complex 1.0 2.0 | mul (complex 3.0 -1.0) | eq (complex 5.0 5.0)
test "complex div" =
    complex 5.0 5.0 | div (complex 3.0 -1.0) | eq (complex 1.0 2.0)
test "complex.conj" = complex 1.0 2.0 | complex.conj | eq (complex 1.0 -2.0)
test "complex.abs" = complex 3.0 4.0 | complex.abs | eq 5.0
test "complex from-int" = 3 | from-int | eq (complex 3.0 0.0)

matrix._test-im : Matrix[I64, m, n] -> Matrix[I64, m, n]
matrix._test-im = id
