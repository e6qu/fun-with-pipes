# A weather service, a module that forecast-client.fwp splits off with
# `--service weather` (tests/tls.rs serves it over TLS). Its functions'
# types say how each is called: one request and one response, a stream of
# responses from an `Iterator` result or a `Channel` parameter, a stream of
# requests from an `Iterator` parameter.
#
# grpc: weather.Weather

Place = { name: String, lat: F64 }

Reading = { place: String, celsius: F64 }

Day = { day: I64, high: F64, low: F64 }

Summary = { count: I64, mean: F64 }

places : List[Place]
places = [
    Place { name = "Oslo", lat = 60.0 },
    Place { name = "Lisbon", lat = 38.7 },
    Place { name = "Quito", lat = -0.2 },
]

# a place by its name; NOT_FOUND for an unknown one
export lookup : String -> Place ! {Error[GrpcError]}
lookup =
    fork
        or-fail
        (make GrpcError {
            code = const grpc.not-found,
            message = concat " is not a known place",
        })
        (eq | compose .name | find | apply places)

# the temperature at a place now (a model: colder away from the equator)
export now : Place -> Reading
now = make Reading {
    place = .name,
    celsius = .lat | abs | mul 0.4 | flip sub 30.0,
}

# the next days' forecast, computed as the client reads it
export forecast : I64 -> Place -> Iterator[Day]
forecast = curry (fork
    iter.take
    .0
    (.1 | now | .celsius | day-after | iter.iterate next-day))

day-after : F64 -> Day
day-after = make Day { day = const 1, high = add 3.0, low = sub 4.0 }

next-day : Day -> Day
next-day = update { day = add 1, high = add 0.5, low = add 0.25 }

# three readings, 100 ms apart
export watch : Place -> Channel[Reading] -> () ! {Async}
watch = curry (fork each (curry watch-step) (const (range 1 4)))

# wait, then send the i-th reading
watch-step : ((Place, Channel[Reading]), I64) -> () ! {Async}
watch-step =
    tap (const 100ms | task.sleep)
    | fork channel.send (.0 | .1) (make { 0 = .0 | .0, 1 = .1 } | reading)
    | ignore

reading : (Place, I64) -> Reading
reading = make Reading {
    place = .0 | .name,
    celsius = fork add (.0 | now | .celsius) (.1 | int.to-float | mul 0.1),
}

# the count and mean of a stream of readings
export summarize : Iterator[Reading] -> Summary
summarize =
    iter.to-list
    | map .celsius
    | make Summary {
        count = length,
        mean = fork div (length | int.to-float | max 1.0) sum,
    }
