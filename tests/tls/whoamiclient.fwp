# Calls whoami.fwp over gRPC with a client certificate (`grpc.with-tls`)
# through the module that `fwp proto --import` makes of its .proto file
# (tests/tls.rs). The server's address is the first argument.

import whoamigen

# a call with TLS options
call : (TlsOptions, String) -> String ! {Network, Error[GrpcError]}
call = fork grpc.with-tls .0 (.1
    | iter.later (flip whoamigen.whoami.grpc-peer () | .value))

shown : Result[String, GrpcError] -> String
shown = match
    Ok _ -> format "  {}"
    Err _ -> .code | grpc.code-name | format "  {}"

trusted : TlsOptions
trusted = tls.options | tls.with-ca "ca.pem"

attempts : List[(String, TlsOptions)]
attempts = [
    ("with a certificate", trusted | tls.with-cert "client.pem" "client.key"),
    ("without a certificate", trusted),
    (
        "with the certificate again",
        trusted | tls.with-cert "client.pem" "client.key",
    ),
]

main =
    ()
    | args
    | head
    | option.unwrap-or "tls://localhost:50051"
    | fork
        each
        (curry
            (tap (.1 | .0 | print)
                | both (.1 | .1) .0
                | attempt call
                | shown
                | print))
        (const attempts)
