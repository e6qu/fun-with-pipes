{
  "openapi": "3.1.0",
  "info": {
    "title": "books",
    "version": "1.0.0",
    "description": "A small bookstore: a catalog and price quotes.\n\nThe same exported functions are a REST API, a command-line program and a\ngRPC service, with no change to this file:\n\n  fwp serve --rest books.fwp                 REST, interpreted\n  fwp build books.fwp --rest -o books-api    REST, native\n  fwp openapi books.fwp                      its OpenAPI document\n  fwp build books.fwp --cli -o books         a command-line program\n  fwp build shop.fwp --service books -o out  a gRPC service (see shop.fwp)\n\nAs a REST API, quotes need a bearer token (see `authenticate`), and\npages served from http://localhost:3000 may call it from a browser."
  },
  "paths": {
    "/books/{id}": {
      "get": {
        "operationId": "book",
        "summary": "A book by its id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "invalid arguments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/books": {
      "get": {
        "operationId": "books",
        "summary": "The books that match a filter, cheapest first.",
        "parameters": [
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "only books by this author"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "only books with this tag"
          },
          {
            "name": "max-price",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            },
            "description": "only books at most this price"
          },
          {
            "name": "in-stock",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "only books in stock"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid arguments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "post": {
        "operationId": "quote-order",
        "summary": "Quote an order: the price of each line and the total, with a 10% discount for the coupon `FWP10`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "400": {
            "description": "invalid arguments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or refused credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/OrderError"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/OrderError"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/OrderError"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Whether the store is up.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "the price in euros"
          },
          "format": {
            "$ref": "#/components/schemas/Format"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stock": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "price",
          "format",
          "tags",
          "stock"
        ]
      },
      "Format": {
        "type": "string",
        "enum": [
          "Paperback",
          "Hardcover",
          "Ebook"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "coupon": {
            "type": "string",
            "description": "a discount code"
          }
        },
        "required": [
          "lines"
        ]
      },
      "Line": {
        "type": "object",
        "properties": {
          "book": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "book",
          "quantity"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteLine"
            }
          },
          "discount": {
            "type": "number",
            "format": "double"
          },
          "total": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "lines",
          "discount",
          "total"
        ]
      },
      "QuoteLine": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "title",
          "quantity",
          "amount"
        ]
      },
      "OrderError": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OrderError.UnknownBook"
          },
          {
            "$ref": "#/components/schemas/OrderError.OutOfStock"
          },
          {
            "$ref": "#/components/schemas/OrderError.BadCoupon"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "UnknownBook": "#/components/schemas/OrderError.UnknownBook",
            "OutOfStock": "#/components/schemas/OrderError.OutOfStock",
            "BadCoupon": "#/components/schemas/OrderError.BadCoupon"
          }
        }
      },
      "OrderError.UnknownBook": {
        "type": "object",
        "properties": {
          "type": {
            "const": "UnknownBook"
          },
          "value": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "OrderError.OutOfStock": {
        "type": "object",
        "properties": {
          "type": {
            "const": "OutOfStock"
          },
          "value": {
            "type": "object",
            "properties": {
              "available": {
                "type": "integer",
                "format": "int64"
              },
              "book": {
                "type": "integer",
                "format": "int64"
              },
              "wanted": {
                "type": "integer",
                "format": "int64"
              }
            },
            "required": [
              "available",
              "book",
              "wanted"
            ]
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "OrderError.BadCoupon": {
        "type": "object",
        "properties": {
          "type": {
            "const": "BadCoupon"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
