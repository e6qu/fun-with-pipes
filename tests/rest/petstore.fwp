# A client of `Petstore` 1.0.7, generated from its OpenAPI document by
# `fwp openapi --import`.
#
# Each function takes the server's base URL first (`http://host:port`),
# then its credential (a bearer token or an API key) if it needs one, the
# path parameters, records of the query, header and cookie parameters,
# and the body. A response other than a success raises
# `Error[RestError]`.

# the header parameters of `get-pet-by-id`
GetPetByIdHeaders = {
    # json: X-Trace
    x-trace: Option[String],
}

Category = { id: Option[I64], name: Option[String] }

Tag = { id: Option[I64], name: Option[String] }

PetOwner = {
    first-name: Option[String],
    # json: 2nd
    f2nd: Option[Bool],
}

# A pet for sale.
Pet = {
    id: Option[I64],
    name: String,
    category: Option[Category],
    photoUrls: List[String],
    tags: Option[List[Tag]],
    # pet status in the store
    status: Option[String],
    birth_date: Option[String],
    owner: Option[PetOwner],
}

# the header parameters of `delete-pet`
DeletePetHeaders = { api_key: String }

# the query parameters of `find-pets-by-status`
FindPetsByStatusQuery = { status: List[String], maxResults: Option[I32] }

# the cookie parameters of `update-pet-with-form`
UpdatePetWithFormCookies = { session: Option[String] }

UpdatePetWithFormBody = { name: Option[String], status: Option[String] }

DogOwner = {
    first-name: Option[String],
    # json: 2nd
    f2nd: Option[Bool],
}

# A pet that barks.
Dog = {
    id: Option[I64],
    name: String,
    category: Option[Category],
    photoUrls: List[String],
    tags: Option[List[Tag]],
    # pet status in the store
    status: Option[String],
    birth_date: Option[String],
    owner: Option[DogOwner],
    bark: Bool,
}

Kind =
    | Admin
    | Guest

# the query parameters of `login-user`
LoginUserQuery = {
    username: Option[String],
    # json: type
    type-field: Option[Kind],
}

# json: untagged
OwnerValue =
    | OwnerValue.Tag Tag
    | OwnerValue.Text String

Owner = Option[OwnerValue]

# json: untagged
SessionData =
    | SessionData.Text String
    | SessionData.Int I64

Session = {
    owner: Owner,
    token: String,
    expires: Option[Duration],
    extra: Option[Tag],
    data: Option[SessionData],
    # json: match
    match-field: Option[String],
}

# Find a pet by its id
# GET /pet/{petId}
get-pet-by-id : String -> I64 -> GetPetByIdHeaders -> Option[Pet] ! {Async, Network, Error[RestError]}
get-pet-by-id = curry (curry
    (make RestRequest {
        method = const "GET",
        url = make RestTarget {
            base = .0 | .0,
            path = const "/pet/{petId}",
            params = rest.texts [.0 | .1 | rest.param-text],
            query = const [],
        } | rest.url,
        headers = .1 | rest.query-pairs,
        body = const None,
    } | rest.fetch-option))

# DELETE /pet/{petId}
delete-pet : String -> I64 -> DeletePetHeaders -> () ! {Async, Network, Error[RestError]}
delete-pet = curry (curry
    (make RestRequest {
        method = const "DELETE",
        url = make RestTarget {
            base = .0 | .0,
            path = const "/pet/{petId}",
            params = rest.texts [.0 | .1 | rest.param-text],
            query = const [],
        } | rest.url,
        headers = .1 | rest.query-pairs,
        body = const None,
    } | rest.fetch))

# POST /pet
# auth: bearer (the token after the base URL)
add-pet : String -> String -> Pet -> Pet ! {Async, Network, Error[RestError]}
add-pet = curry (curry
    (make RestRequest {
        method = const "POST",
        url = make RestTarget {
            base = .0 | .0,
            path = const "/pet",
            params = rest.texts [],
            query = const [],
        } | rest.url,
        headers = .0 | .1 | rest.bearer,
        body = .1 | json.write | Some,
    } | rest.fetch))

