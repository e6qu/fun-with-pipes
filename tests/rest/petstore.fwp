# POST /pet/{petId}/form
# auth: api-key header X-API-Key (the key after the base URL)
update-pet-with-form : String -> String -> I64 -> UpdatePetWithFormCookies -> Option[UpdatePetWithFormBody] -> Dog ! {Async, Network, Error[RestError]}
update-pet-with-form = curry (curry
    (curry
        (curry
            (make RestRequest {
                method = const "POST",
                url = make RestTarget {
                    base = .0 | .0 | .0 | .0,
                    path = const "/pet/{petId}/form",
                    params = rest.texts [.0 | .0 | .1 | rest.param-text],
                    query = const [],
                } | rest.url,
                headers = rest.pairs [
                    .0 | .0 | .0 | .1 | curry id "x-api-key" | singleton,
                    .0 | .1 | rest.query-pairs | rest.cookie-header,
                    const [
                        ("content-type", "application/x-www-form-urlencoded"),
                    ],
                ],
                body = .1 | option.map rest.form-body,
            } | rest.fetch))))

