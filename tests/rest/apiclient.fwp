# Four parameters: two from the path, one from the query, the body.
# POST /sum/{a}/{b}
sum4 : String -> I64 -> I64 -> Sum4Query -> List[I64] -> I64 ! {Async, Network, Error[RestError]}
sum4 = curry (curry
    (curry
        (curry
            (make RestRequest {
                method = const "POST",
                url = make RestTarget {
                    base = .0 | .0 | .0 | .0,
                    path = const "/sum/{a}/{b}",
                    params = rest.texts [
                        .0 | .0 | .0 | .1 | rest.param-text,
                        .0 | .0 | .1 | rest.param-text,
                    ],
                    query = .0 | .1 | rest.query-pairs,
                } | rest.url,
                body = .1 | json.write | Some,
            } | rest.fetch))))

