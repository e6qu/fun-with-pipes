health = make RestRequest {
    method = const "GET",
    url = make RestTarget {
        base = id,
        path = const "/health",
        params = rest.texts [],
        query = const [],
    } | rest.url,
    headers = const [],
    body = const None,
} | rest.fetch

# Create an item: 201 with its location.
# POST /items
# auth: bearer (the token after the base URL)
create : String -> String -> Item -> Item ! {Async, Network, Error[RestError]}
create = curry (curry
    (make RestRequest {
        method = const "POST",
        url = make RestTarget {
            base = .0 | .0,
            path = const "/items",
            params = rest.texts [],
            query = const [],
        } | rest.url,
        headers = .0 | .1 | rest.bearer,
        body = .1 | json.write | Some,
    } | rest.fetch))

# An item, or a redirect to its new id.
# GET /items/{id}
item : String -> I64 -> Item ! {Async, Network, Error[RestError]}
item = curry (make RestRequest {
    method = const "GET",
    url = make RestTarget {
        base = .0,
        path = const "/items/{id}",
        params = rest.texts [.1 | rest.param-text],
        query = const [],
    } | rest.url,
    headers = const [],
    body = const None,
} | rest.fetch)

# Delete an item: an empty reply.
