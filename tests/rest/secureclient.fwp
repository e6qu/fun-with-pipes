    } | rest.fetch))

# Headers, a cookie and a query parameter through an options record.
# GET /seen
seen : String -> SeenQuery -> SeenHeaders -> SeenCookies -> String ! {Async, Network, Error[RestError]}
seen = curry (curry
    (curry
        (make RestRequest {
            method = const "GET",
            url = make RestTarget {
                base = .0 | .0 | .0,
                path = const "/seen",
                params = rest.texts [],
                query = .0 | .0 | .1 | rest.query-pairs,
            } | rest.url,
            headers = rest.pairs [
                .0 | .1 | rest.query-pairs,
                .1 | rest.query-pairs | rest.cookie-header,
            ],
            body = const None,
        } | rest.fetch)))

# A required header and an optional cookie bound to parameters.
