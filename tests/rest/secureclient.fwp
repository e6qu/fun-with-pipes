# A client of `secure` 0.1.0, generated from its OpenAPI document by
# `fwp openapi --import`.
#
# Each function takes the server's base URL first (`http://host:port`),
# then its credential (a bearer token or an API key) if it needs one, the
# path parameters, records of the query, header and cookie parameters,
# and the body. A response other than a success raises
# `Error[RestError]`.

User = { name: String, admin: Bool }

Item = { id: I64, name: String }

# the query parameters of `seen`
SeenQuery = { limit: Option[I64] }

# the header parameters of `seen`
SeenHeaders = {
    # json: X-Trace-Id
    x-trace-id: Option[String],
}

# the cookie parameters of `seen`
SeenCookies = { theme: Option[String] }

# the header parameters of `hello`
HelloHeaders = {
    # json: X-Name
    x-name: String,
}

# the cookie parameters of `hello`
HelloCookies = { session: Option[String] }

# Who is calling.
# GET /me
# auth: bearer (the token after the base URL)
me : String -> String -> User ! {Async, Network, Error[RestError]}
me = curry (make RestRequest {
    method = const "GET",
    url = make RestTarget {
        base = .0,
        path = const "/me",
        params = rest.texts [],
        query = const [],
    } | rest.url,
    headers = .1 | rest.bearer,
    body = const None,
} | rest.fetch)

# A public health check.
