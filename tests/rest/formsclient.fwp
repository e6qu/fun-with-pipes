book : String -> I64 -> Option[Book] ! {Async, Network, Error[RestError]}
book = curry (make RestRequest {
    method = const "GET",
    url = make RestTarget {
        base = .0,
        path = const "/books/{id}",
        params = rest.texts [.1 | rest.param-text],
        query = const [],
    } | rest.url,
    headers = const [],
    body = const None,
} | rest.fetch-option)

