# The books as CSV only.
# GET /books.csv
books-csv : String -> String ! {Async, Network, Error[RestError]}
books-csv = make RestRequest {
    method = const "GET",
    url = make RestTarget {
        base = id,
        path = const "/books.csv",
        params = rest.texts [],
        query = const [],
    } | rest.url,
    headers = const [("accept", "text/csv")],
    body = const None,
} | rest.request | rest.send | rest.text-body

# A greeting, as text only.
# GET /hello/{name}
hello : String -> String -> String ! {Async, Network, Error[RestError]}
hello = curry (make RestRequest {
    method = const "GET",
    url = make RestTarget {
        base = .0,
        path = const "/hello/{name}",
        params = rest.texts [.1 | rest.param-text],
        query = const [],
    } | rest.url,
    headers = const [("accept", "text/plain")],
    body = const None,
} | rest.request | rest.send | rest.text-body)
