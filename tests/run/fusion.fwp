# List pipelines fused into one loop (src/fuse.rs) must behave as if each
# stage ran over the whole list.

# range, map, filter and a fold
sum-of : I64 -> I64
sum-of = range 0 | map (mul 3) | filter (rem 2 | eq 0) | sum

# a list producer, filter before map
lengths : List[String] -> I64
lengths = filter (string.length | gt 1) | map string.length | fold add 0

# a captured local: the step reads it from the loop state
plus-all : I64 -> List[I64] -> I64
plus-all = add | map | flip compose sum

# floats, with no traps at all
mean-square : List[F64] -> F64
mean-square = map (fork mul id id) | sum

# unsigned elements
small : U8 -> U8
small = range 0u8 | sum

# other consumers: `length` (and `count`), `find` (and `any`, `all`)
evens : I64 -> I64
evens = range 0 | filter (rem 2 | eq 0) | length

first-square-over : I64 -> List[I64] -> Option[I64]
first-square-over = gt | find | compose (map (fork mul id id))

main = [
    1000 | sum-of | echo,
    0 | sum-of | echo,
    ["a", "bb", "ccc", ""] | lengths | echo,
    [1, 2, 3] | plus-all 10 | echo,
    [1.5, 2.0] | mean-square | echo,
    10u8 | small | echo,
    10 | evens | echo,
    [1, 2, 3, 4] | count (gt 2) | echo,
    [3, 1, 4, 1, 5] | first-square-over 5 | echo,
    [1, 2] | first-square-over 5 | echo,
    range 0 100 | any (gt 98) | echo,
    range 0 100 | all (lt 100) | echo,
    [] | map (add 1) | find (eq 2) | echo,
    # one trap kind in two stages: the overflow is reported either way
    range 0 3 | map (mul 4611686018427387904) | sum | echo,
] | ignore
