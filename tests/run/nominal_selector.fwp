# A field predicate must preserve the named record used by the other branches.
Gauge = { value: I64 }
impl Neg[Gauge] =
    neg = update { value = neg }
positive : Gauge -> Gauge
positive = if (.value | lt 0) neg id
twice : Gauge -> (Gauge, Gauge)
twice = both (if (.value | lt 0) neg id) (if (.value | lt 0) neg id)
Box = { item: Gauge }
impl Neg[Box] =
    neg = update { item = neg }
positive-box : Box -> Box
positive-box = if (.item.value | lt 0) neg id
Call = { run: () -> I64 ! {IO}, value: I64 }
impl Neg[Call] =
    neg = update { value = neg }
positive-call : Call -> Call ! {IO}
positive-call = if (.run | apply () | lt 0) neg id
read-negative : () -> I64 ! {IO}
read-negative = tap (const "called" | print) | const -1
main = [
    Gauge { value = -3 } | positive | .value | echo,
    Box { item = Gauge { value = -4 } } | positive-box | .item.value | echo,
    { value = 5, other = 7 } | both .value .other | echo,
    Call { run = read-negative, value = -5 } | positive-call | .value | echo,
    Gauge { value = -6 } | twice | both (.0 | .value) (.1 | .value) | echo,
] | ignore
