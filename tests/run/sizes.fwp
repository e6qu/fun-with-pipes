# Sizes computed in types (`n + m`, `m * n`): the program builds vectors
# whose sizes the checker adds and multiplies.

doubled : Vector[t, n] -> Vector[t, 2 * n]
doubled = fork vector.append id id

three : Vector[I64, 3]
three = vector [1, 2] | vector.push 3

five : Vector[I64, 5]
five = three | vector.append (vector [4, 5])

six : Vector[I64, 6]
six = matrix [[1, 2, 3], [4, 5, 6]] | matrix.flatten

# a 3 by 2 matrix: rows add up when stacking, columns beside
tall : Matrix[I64, 3, 2]
tall = matrix [[1, 2]] | matrix.stack (matrix [[3, 4], [5, 6]])

wide : Matrix[I64, 2, 3]
wide = matrix [[1], [2]] | matrix.beside (matrix [[3, 4], [5, 6]])

# 3 rows less 1 are 2, and 2 columns less 1 are 1
bottom : Matrix[I64, 2, 2]
bottom = tall | matrix.split-rows (vector [()]) | .1

right : Matrix[I64, 2, 1]
right = wide | matrix.split-columns (vector [(), ()]) | .1

main = [
    five | vector.to-list | echo,
    three | doubled | vector.to-list | echo,
    six | dot (three | doubled) | echo,
    five | vector.length | echo,
    tall | matrix.rows-of | echo,
    wide | matrix.rows-of | echo,
    tall | matmul wide | matrix.rows-of | echo,
    tall | matrix.split-rows (vector [()]) | .0 | matrix.rows-of | echo,
    bottom | matrix.rows-of | echo,
    wide | matrix.split-columns (vector [(), ()]) | .0 | matrix.rows-of | echo,
    right | matrix.rows-of | echo,
] | ignore
