# Literal patterns over the whole 128-bit range.
big : I128 -> String
big = match
    170141183460469231731687303715884105727 -> "max"
    -170141183460469231731687303715884105728 -> "min"
    18446744073709551616 -> "2^64"
    _ -> const "other"

ubig : U128 -> String
ubig = match
    340282366920938463463374607431768211455 -> "umax"
    18446744073709551616 -> "u2^64"
    _ -> const "uother"

main = [
    170141183460469231731687303715884105727i128 | big | print,
    -170141183460469231731687303715884105728i128 | big | print,
    18446744073709551616i128 | big | print,
    0i128 | big | print,
    340282366920938463463374607431768211455u128 | ubig | print,
    18446744073709551616u128 | ubig | print,
    5u128 | ubig | print,
] | ignore
