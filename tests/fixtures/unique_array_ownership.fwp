# Local arrays may use count-free storage only when their full lifetime is known.
read : Array[I64] -> I64
read = both array.length (array.get 0 | option.unwrap-or 0) | uncurry add

export local : I64 -> I64
local = flip array.generate id | both read array.length | uncurry add

checked-index : I64 -> I64 ! {Error[String]}
checked-index = if (eq 2) (const "expected index failure" | fail) id
export partial : I64 -> I64 ! {Error[String]}
partial = flip array.generate checked-index | read

export completed : I64 -> I64 ! {Error[String]}
completed =
    flip array.generate id
    | both (array.length | checked-index) read
    | uncurry add

export reader : () -> {callback: Array[I64] -> I64}
reader = const { callback = read }

export shared : I64 -> (Array[I64], Array[I64])
shared = flip array.generate id | both id id

export unknown : (Array[I64] -> I64) -> I64 -> I64
unknown = curry (both .0 (.1 | flip array.generate id) | uncurry (flip apply))

close-over : Array[I64] -> () -> I64
close-over = const | flip compose read
export captured : I64 -> {callback: () -> I64}
captured = flip array.generate id | close-over | make { callback = id }

yield-index : I64 -> I64 ! {Async}
yield-index = tap (const () | task.yield)
export yielded : I64 -> I64 ! {Async}
yielded = flip array.generate yield-index | read
copy-task : I64 -> () -> I64 ! {Async}
copy-task = curry (.0 | yielded)
export cancelled : I64 -> Option[I64] ! {Async}
cancelled =
    copy-task
    | task.spawn
    | tap (const () | task.yield)
    | tap task.cancel
    | task.await

main = [
    0 | local | echo,
    16 | local | echo,
    4 | attempt partial | echo,
    2 | attempt completed | echo,
    4 | shared | echo,
    4 | unknown read | echo,
    4 | captured | .callback | apply () | echo,
    4 | yielded | echo,
    4 | cancelled | echo,
] | ignore
