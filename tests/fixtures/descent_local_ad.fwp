# Experimental structured gradient: differentiate each neighboring pair locally.
# The edge formula contains no handwritten derivatives. Dual propagates them.
local-edge : (Dual[F64], Dual[F64]) -> Dual[F64]
local-edge = fn (x, y) ->
    let distance = y - x * x
    in let offset = 1.0 - x
    in distance * distance * 100.0 + offset * offset

local-coordinate : I64 -> Array[F64] -> F64
local-coordinate = array.get | flip compose (match
    Some -> id
    None -> prim.trap "local derivative coordinate is outside the input")

# Each coordinate receives its preceding edge's second partial, then its
# following edge's first partial. Endpoints have just one contribution.
local-gradient-at : ((Dual[F64], Dual[F64]) -> Dual[F64]) -> Array[F64] -> I64 -> F64
local-gradient-at = fn edge -> fn values -> fn index ->
    let current = local-coordinate index values
    in let before = index == 0 | match
        True -> 0.0
        False ->
            edge (dual.const (local-coordinate (index - 1) values), dual.var current)
            | .eps
    in let after = index + 1 == array.length values | match
        True -> 0.0
        False ->
            edge (dual.var current, dual.const (local-coordinate (index + 1) values))
            | .eps
    in before + after

local-gradient : ((Dual[F64], Dual[F64]) -> Dual[F64]) -> Array[F64] -> Array[F64]
local-gradient = fn edge -> fn values ->
    array.generate (array.length values) (local-gradient-at edge values)

local-update-at : Array[F64] -> I64 -> F64
local-update-at = fn values -> fn index ->
    local-coordinate index values - 0.001 * local-gradient-at local-edge values index

local-descend : Array[F64] -> Array[F64]
local-descend = fn values -> array.generate (array.length values) (local-update-at values)
