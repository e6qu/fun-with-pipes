# Hashes use the bytes of the typed binary encoding. Widths and ordering matter.
Choice = | Missing | Present (String, List[I64])
check : String -> (U64, String)
check = both hash id
empty : List[I64]
empty = []
main = [
    (-128i8, -32768i16, -2147483648i32, -9223372036854775808i64) | hash | echo,
    (255u8, 65535u16, 4294967295u32, 18446744073709551615u64) | hash | echo,
    (-170141183460469231731687303715884105728i128, 340282366920938463463374607431768211455u128) | hash | echo,
    (1.5f16, -0.0bf16, 1.25f32, -0.0, 1.0000000000000000000000000000000002f128) | hash | echo,
    "λ\u{0}tail" | check | echo,
    "λ\u{0}tail" | string.to-bytes | both hash bytes.length | echo,
    () | hash | echo,
    empty | hash | echo,
    range 0 129 | hash | echo,
    range 0 129 | array.from-list | both hash (array.slice 2 99 | hash) | echo,
    [1i128, -2i128, 18446744073709551616i128] | array.from-list | hash | echo,
    [1.0f128, -0.0f128, 1.0000000000000000000000000000000002f128] | array.from-list | hash | echo,
    ["z", "λ", "a"] | array.from-list | hash | echo,
    [("z", [3, 4]), ("a", [1, 2])] | map.from-list | both hash map.to-list | echo,
    [3, 1, 3, 2] | set.from-list | both hash set.to-list | echo,
    [Missing, Present ("value", [7, 8])] | hash | echo,
    range 0 64 | map (show | check) | length | echo,
] | ignore
