# Record 256 identity operations, then seed the final node with derivative 1.
push-one : I64 -> I64
push-one = fn node -> ad.push node 1.0 -1 0.0
record-chain : I64 -> I64
record-chain =
    ad.tape
    | make { 0 = const 256, 1 = id, 2 = id }
    | loop (if
        (.0 | eq 0)
        Stop
        (make { 0 = .0 | sub 1, 1 = .1 | push-one, 2 = .2 } | Again))
    | make {
        0 = .2,
        1 = .1 | singleton | array.from-list,
        2 = const [1.0] | array.from-list,
    }
    | uncurry3 ad.backward
    | array.get 0
    | option.unwrap-or 0.0
    | float.to-int
    | option.unwrap-or 0
main = 1 | ad.scope record-chain | echo
