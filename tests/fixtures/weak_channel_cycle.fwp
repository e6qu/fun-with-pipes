# Acquiring an owner is not permission to store it back into its own queue.
make : I64 -> Channel[() -> () ! {Async}] ! {Async}
make = channel.make

capture : Channel[() -> () ! {Async}] -> () -> () ! {Async}
capture = const | flip compose channel.close

enqueue : Channel[() -> () ! {Async}] -> () ! {Async}
enqueue = both id capture | uncurry channel.send | ignore

main = make 1 | channel.downgrade | channel.upgrade | option.map enqueue | ignore
