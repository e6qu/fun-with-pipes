export reduce64 : Array[F64] -> F64
reduce64 = array.map (mul 3.0) | array.map (add 1.0) | array.fold add 0.0
export reduce32 : Array[F32] -> F32
reduce32 = array.map (mul 3.0f32) | array.map (add 1.0f32) | array.fold add 0.0f32
export count8 : Array[I8] -> I64
count8 = array.map (add 1i8) | array.length
export reduce8 : Array[I8] -> I8
reduce8 = array.map (add 1i8) | array.fold add 0i8
main = [
    [1.5, -0.0, 0.25, -2.0] | array.from-list | array.slice 0 4 | reduce64 | echo,
    [1.5f32, -0.0f32, 0.25f32, -2.0f32] | array.from-list | reduce32 | echo,
    [-128i8, 0i8, 12i8] | array.from-list | count8 | echo,
    [1i8, 2i8, 3i8] | array.from-list | reduce8 | echo,
    [] | array.from-list | reduce64 | echo,
] | ignore
