# Each printed True is one exact gradient or unchanged-input check.
# Concatenated after descent_local_ad.fwp and structured_ad_objectives.fwp.
empty : List[F64]
empty = []
point = [-1.25, 0.5, 0.75]
weights = [[1.0, 0.25, -0.5], [-0.25, 1.0, 0.5], [0.5, -0.25, 1.0]]

main = [
    point | grad neighbours | eq [-535.75, -313.5, 100.0] | echo,
    point | gradient neighbours | eq [-535.75, -313.5, 100.0] | echo,
    point
    | array.from-list
    | local-gradient edge
    | array.to-list
    | eq [-535.75, -313.5, 100.0]
    | echo,
    point | grad independent | eq [-2.8125, -1.5, -1.3125] | echo,
    point | gradient independent | eq [-2.8125, -1.5, -1.3125] | echo,
    point | independent-local | eq [-2.8125, -1.5, -1.3125] | echo,
    point | independent-tensor | eq [-2.8125, -1.5, -1.3125] | echo,
    point | grad (dense weights) | eq [-1.796875, 0.8125, 1.34375] | echo,
    point | gradient (dense weights) | eq [-1.796875, 0.8125, 1.34375] | echo,
    point | grad smooth | eq [-3.5, 3.0, 0.5] | echo,
    point | gradient smooth | eq [-3.5, 3.0, 0.5] | echo,
    point
    | array.from-list
    | local-gradient squared-edge
    | array.to-list
    | eq [-3.5, 3.0, 0.5]
    | echo,
    empty | grad neighbours | eq [] | echo,
    [2.0] | grad neighbours | eq [0.0] | echo,
    empty | gradient neighbours | eq [] | echo,
    [2.0] | gradient neighbours | eq [0.0] | echo,
    empty | grad independent | eq [] | echo,
    [2.0] | grad independent | eq [24.0] | echo,
    empty | gradient independent | eq [] | echo,
    [2.0] | gradient independent | eq [24.0] | echo,
    empty | independent-local | eq [] | echo,
    [2.0] | independent-local | eq [24.0] | echo,
    empty | independent-tensor | eq [] | echo,
    [2.0] | independent-tensor | eq [24.0] | echo,
    empty | grad (dense []) | eq [] | echo,
    [2.0] | grad (dense [[3.0]]) | eq [18.0] | echo,
    empty | gradient (dense []) | eq [] | echo,
    [2.0] | gradient (dense [[3.0]]) | eq [18.0] | echo,
    point | eq [-1.25, 0.5, 0.75] | echo,
    weights
    | eq [[1.0, 0.25, -0.5], [-0.25, 1.0, 0.5], [0.5, -0.25, 1.0]]
    | echo,
] | ignore
