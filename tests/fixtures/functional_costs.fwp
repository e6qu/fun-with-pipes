# Each pair computes the same scalar result. Exports keep the unknown-call or
# escaping-result boundary available to the native caller used by the test.
export pipe : I64 -> I64
pipe = add 1 | mul 2
export unknown-pipe : (I64 -> I64) -> I64 -> I64
unknown-pipe = flip compose (mul 2)
export increment : () -> I64 -> I64
increment = const (add 1)

export partial : I64 -> I64
partial = both add id | uncurry (flip apply)
export escaped-partial : I64 -> I64 -> I64
escaped-partial = add

export borrowed : I64 -> I64
borrowed = flip array.generate id | array.map (add 1) | array.fold add 0
export unknown-borrowed : (I64 -> I64) -> I64 -> I64
unknown-borrowed = curry (both .0 (.1 | flip array.generate id)
    | uncurry array.map
    | array.fold add 0)

export captured : I64 -> I64
captured = both (add | flip compose (mul 2)) (const 3) | uncurry (flip apply)
export escaped-captured : I64 -> I64 -> I64
escaped-captured = add | flip compose (mul 2)

Pair = { left: I64, right: I64 }
export produce : I64 -> Option[Pair]
produce = make { left = id, right = add 1 } | Some
export consume : Option[Pair] -> I64
consume = option.map (both .left .right | uncurry add) | option.unwrap-or 0
export result : I64 -> I64
result = produce | consume

export each-count : I64 -> I64
each-count = range 0 | run-state 0 (each (add | modify)) | .1
export unknown-each : (I64 -> () ! {State[I64]}) -> I64 -> I64
unknown-each = curry (run-state 0 (both .0 (.1 | range 0) | uncurry each) | .1)
export accumulate : () -> I64 -> () ! {State[I64]}
accumulate = const (add | modify)

export folded : I64 -> I64
folded = range 0 | fold add 0
export unknown-fold : (I64 -> I64 -> I64) -> I64 -> I64
unknown-fold =
    curry (both (fork fold .0 (const 0)) (.1 | range 0) | uncurry (flip apply))
export addition : () -> I64 -> I64 -> I64
addition = const add

state-step : I64 -> Step[I64, ()] ! {State[I64]}
state-step = if (eq 0) (const () | Stop) (tap (add | modify) | sub 1 | Again)
export state-loop : I64 -> I64
state-loop = run-state 0 (loop state-step) | .1
export unknown-state : (I64 -> Step[I64, ()] ! {State[I64]}) -> I64 -> I64
unknown-state = curry (run-state 0 (both .0 .1 | uncurry loop) | .1)
export state-callback : () -> I64 -> Step[I64, ()] ! {State[I64]}
state-callback = const state-step

# A direct-call export alone does not need runtime callback metadata. This
# export makes the native caller's callback identities first-class values too.
# The measurement does not construct this record; partial inputs are counted.
Callables = {
    increment: () -> I64 -> I64,
    partial: I64 -> I64 -> I64,
    captured: I64 -> I64 -> I64,
    accumulate: () -> I64 -> () ! {State[I64]},
    addition: () -> I64 -> I64 -> I64,
    state: () -> I64 -> Step[I64, ()] ! {State[I64]},
}
export callable-values : () -> Callables
callable-values = make {
    increment = const increment,
    partial = const escaped-partial,
    captured = const escaped-captured,
    accumulate = const accumulate,
    addition = const addition,
    state = const state-callback,
}

main = [
    32 | both pipe (unknown-pipe (increment ())) | echo,
    32 | both partial (both escaped-partial id | uncurry (flip apply)) | echo,
    32 | both borrowed (unknown-borrowed (increment ())) | echo,
    32 | both captured (escaped-captured | apply 3) | echo,
    32 | both result (produce | consume) | echo,
    32 | both each-count (unknown-each (accumulate ())) | echo,
    32 | both folded (unknown-fold (addition ())) | echo,
    32 | both state-loop (unknown-state (state-callback ())) | echo,
    32 | both pipe named-pipe | echo,
    32 | both partial named-partial | echo,
    32 | both borrowed named-borrowed | echo,
    32 | both captured named-captured | echo,
    32 | both result named-result | echo,
    32 | both each-count named-each-count | echo,
    32 | both folded named-folded | echo,
    32 | both state-loop named-state-loop | echo,
    32 | local-tuple | echo,
    32 | local-record | echo,
    32 | local-text-record | echo,
    32 | local-variant | echo,
    32 | local-alias | echo,
    32 | local-owner-loop | echo,
    32 | local-loop-alias | echo,
    32 | local-map-filter | echo,
] | ignore

# The same work with lexical values: names must not introduce runtime costs.
export named-pipe : I64 -> I64
named-pipe = fn n -> let incremented = n + 1 in incremented * 2
export named-partial : I64 -> I64
named-partial = fn n -> let add-n = add n in add-n n
export named-borrowed : I64 -> I64
named-borrowed = fn n ->
    let values = array.generate n (fn i -> i)
    in values | array.map (fn x -> x + 1) | array.fold add 0
export named-captured : I64 -> I64
named-captured = fn n -> let calculate = fn x -> (x + n) * 2 in calculate 3
export named-result : I64 -> I64
named-result = fn n -> let result = produce n in consume result
export named-each-count : I64 -> I64
named-each-count = fn n ->
    let values = range 0 n
    in values | run-state 0 (each (fn value -> modify (add value))) | .1
export named-folded : I64 -> I64
named-folded = fn n ->
    let values = range 0 n
    in values | fold (fn total -> fn value -> total + value) 0
export named-state-loop : I64 -> I64
named-state-loop = fn n ->
    let step = match
        0 -> Stop ()
        remaining -> let _ = modify (add remaining) in Again (remaining - 1)
    in n | run-state 0 (loop step) | .1

# Selected ownership/representation paths. The String itself is a required
# allocation; local records, tuples and immediate variants need no heap box.
export local-tuple : I64 -> I64
local-tuple = fn n -> let (left, right) = (n, n + 1) in left + right
export local-record : I64 -> I64
local-record = fn n ->
    let { left, right } = Pair { left = n, right = n + 1 } in left + right
TextRecord = { text: String, number: I64 }
export local-text-record : I64 -> I64
local-text-record = fn n ->
    let record = TextRecord { text = show n, number = n }
    in let { text, number } = record
    in string.length text + number
export local-variant : I64 -> I64
local-variant = fn n ->
    let result = produce n
    in result | match
        Some { left, right } -> left + right
        None -> 0
read-text : String -> I64
read-text = string.length
export local-alias : I64 -> I64
local-alias = fn n ->
    let text = show n in let alias = text in read-text alias + read-text text
TextWalk = { remaining: I64, text: String, total: I64 }
text-step : TextWalk -> Step[TextWalk, I64]
text-step = fn { remaining, text, total } ->
    remaining | match
        0 -> Stop total
        next -> Again TextWalk {
            remaining = next - 1,
            text,
            total = total + string.length text,
        }
export local-owner-loop : I64 -> I64
local-owner-loop = fn n ->
    TextWalk { remaining = n, text = show n, total = 0 } | loop text-step
export local-loop-alias : I64 -> I64
local-loop-alias = fn n ->
    let text = show n
    in let total = TextWalk { remaining = n, text, total = 0 } | loop text-step
    in total + string.length text

# Named stages retain eager semantics while their temporary range is removable.
export local-map-filter : I64 -> I64
local-map-filter = fn n ->
    let values = range 0 n
    in
        values
        | map (fn value -> value + 1)
        | filter (fn value -> value % 2 == 0)
        | fold add 0
