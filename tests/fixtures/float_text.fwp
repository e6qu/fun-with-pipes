# Ordinary and JSON text must match raw interpretation, including signed zero,
# subnormals, fixed/scientific boundaries and exactly represented large integers.
values64 : List[F64]
values64 = [0.0, -0.0, 0.1, 0.30000000000000004, -2.5, 123.456,
    0.00001, 0.000001, 0.000009999999999999999, 0.000010000000000000002,
    10000000000000000.0, 99999999999999984.0, 100000000000000000.0,
    9007199254740992.0, 9007199254740994.0, 4.9406564584124654e-324,
    2.2250738585072014e-308, 1.7976931348623157e308]
values32 : List[F32]
values32 = [0.0, -0.0, 0.1, -2.5, 123.456, 0.00001, 0.000001,
    1.401298464324817e-45, 1.1754943508222875e-38, 3.4028234663852886e38]
main = [values64 | echo, values64 | json.write | echo,
    values32 | echo, values32 | json.write | echo] | ignore
