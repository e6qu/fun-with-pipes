Point = { index: I64, value: F64 }
paired : Point -> Point -> Point ! {IO}
paired = fn right -> fn left ->
    let combine = fn (xpoint, ypoint) ->
        let printed = xpoint | .index | echo
        # A polynomial keeps this internal call above the ordinary inlining limit.
        # Both records are still used only through their numeric fields.
        in let x = xpoint | .value
        in let coefficient = ypoint | .value
        in let p1 = coefficient * x + coefficient
        in let p2 = p1 * x + coefficient
        in let p3 = p2 * x + coefficient
        in let p4 = p3 * x + coefficient
        in let p5 = p4 * x + coefficient
        in let p6 = p5 * x + coefficient
        in let p7 = p6 * x + coefficient
        in let p8 = p7 * x + coefficient
        in Point {
            index = (xpoint | .index) + (ypoint | .index),
            value = p8,
        }
    in combine (left, right)
mixed : Point -> Point -> Point ! {IO}
mixed = fn right -> fn left ->
    let printed = right | echo
    in Point {
        index = (left | .index) + (right | .index),
        value = (left | .value) + (right | .value),
    }
step : Point -> Point -> Point ! {IO}
step = fn total -> fn point ->
    let printed = (point | .index) + 100 | echo
    in Point {
        index = (total | .index) + (point | .index),
        value = (total | .value) + (point | .value),
    }
run : List[Point] -> List[Point] -> Point ! {IO}
run = fn left -> fn right ->
    let values = zip-with paired left right
    in fold step Point { index = 0, value = 0.0 } values
run-mixed : List[Point] -> List[Point] -> Point ! {IO}
run-mixed = fn left -> fn right ->
    let values = zip-with mixed left right
    in fold step Point { index = 0, value = 0.0 } values
aliases : List[Point] -> (Point, List[Point]) ! {IO}
aliases = fn points -> (run points points, points)
main =
    let point = Point { index = 3, value = 0.5 }
    in let points = [point, point]
    in [
        run [] points | show,
        run points [] | show,
        run points [point] | show,
        run points points | show,
        run-mixed points points | show,
        aliases points | show,
    ] | each print
