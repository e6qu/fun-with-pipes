seed : () -> U64 ! {IO}
seed = const 0u64 | tap (const "seed" | echo)
capture : () -> I64 ! {IO}
capture = const 7 | tap (const "capture" | echo)
input : () -> List[I64] ! {IO}
input = const [1, 2, 3] | tap (const "input" | echo)
main = input () | map (both id (const (capture ())) | hash) | fold bit.xor (seed ()) | echo
