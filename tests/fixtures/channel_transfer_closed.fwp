# A closed channel rejects every freshly created function. The compiler must
# still release both the rejected function and its captured string.
callbacks : I64 -> Channel[() -> String] ! {Async}
callbacks = channel.make
give : String -> () -> String
give = const
exchange : (Channel[() -> String], I64) -> () ! {Async, Error[String]}
exchange = fork channel.send .0 (.1 | rem 64 | add 1 | flip string.repeat "x" | give)
    | if id (const "closed channel accepted a message" | fail) (const ())
step : (Channel[() -> String], I64, I64) -> Step[(Channel[() -> String], I64, I64), I64] ! {Async, Error[String]}
step = if (fork lt .2 .1)
    (tap (both .0 .1 | exchange) | make { 0 = .0, 1 = .1 | add 1, 2 = .2 } | Again)
    (.1 | Stop)
export work : I64 -> I64 ! {Async, Error[String]}
work = make { 0 = const 1 | callbacks | tap channel.close, 1 = const 0, 2 = id } | loop step
main = 16 | work | echo
