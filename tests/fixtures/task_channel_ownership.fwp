value : String -> () -> String
value = const
sleeping : String -> () -> String ! {Async}
sleeping = curry (.0 | tap (const 1h | task.sleep))
awaiting : Task[String] -> () -> Option[String] ! {Async}
awaiting = curry (.0 | task.await)
start-sleeping : String -> Task[String] ! {Async}
start-sleeping = compose sleeping task.spawn
start-value : String -> Task[String] ! {Async}
start-value = compose value task.spawn
own-state : () -> String
own-state = run-state "initial" (const "owned" | tap put | const () | get) | .0
scope-failure : () -> () ! {Async, Error[String]}
scope-failure =
    tap (const "scope" | string.repeat 2 | start-sleeping | ignore)
    | const "expected"
    | fail
text-channel : I64 -> Channel[String] ! {Async}
text-channel = channel.make
Data =
    | End
    | Cell String Data
data-channel : I64 -> Channel[Data] ! {Async}
data-channel = channel.make
receive : Channel[String] -> () -> Option[String] ! {Async}
receive = curry (.0 | channel.recv)
send : Channel[String] -> () -> Bool ! {Async}
send = curry (.0 | flip channel.send ("pending" | string.repeat 2))
start-receive : Channel[String] -> Task[Option[String]] ! {Async}
start-receive = compose receive task.spawn
start-send : Channel[String] -> Task[Bool] ! {Async}
start-send = compose send task.spawn
undrained : I64 -> () ! {Async}
undrained =
    text-channel
    | tap (flip channel.send ("queued" | string.repeat 2))
    | tap channel.close
    | ignore
queue-failure : I64 -> () ! {Async, Error[String]}
queue-failure =
    text-channel
    | tap (flip channel.send ("failed" | string.repeat 2))
    | const "expected"
    | fail
filled-channel : I64 -> Channel[String] ! {Async}
filled-channel =
    text-channel
    | tap (flip channel.send ("nested" | string.repeat 2))
    | tap channel.close
nested-channel : I64 -> Channel[Channel[String]] ! {Async}
nested-channel = channel.make
routing-channel : I64 -> Channel[List[Channel[String]]] ! {Async}
routing-channel = channel.make
Route =
    | EndRoute
    | Route Channel[String] Route
route-channel : I64 -> Channel[Route] ! {Async}
route-channel = channel.make
nested-pair : I64 -> (Channel[String], Channel[Channel[String]]) ! {Async}
nested-pair =
    filled-channel
    | both id (const 1 | nested-channel)
    | tap (fork channel.send .1 .0)
nested-send : Channel[Channel[String]] -> () -> Bool ! {Async}
nested-send = curry (fork channel.send .0 (const 1 | filled-channel))
nested-receive : Channel[Channel[String]] -> () -> Option[Channel[String]] ! {Async}
nested-receive = curry (.0 | channel.recv)
nested-failure : I64 -> () ! {Async, Error[String]}
nested-failure = nested-pair | const "nested failure" | fail
nested-round : () -> () ! {Async, IO}
nested-round =
    const 1
    | nested-pair
    | both
        (.1 | tap channel.close | channel.recv | option.map channel.recv)
        (.0 | channel.recv)
    | echo
    | const 1
    | filled-channel
    | singleton
    | both id (const 1 | routing-channel)
    | tap (fork channel.send .1 .0)
    | .1
    | tap channel.close
    | channel.recv
    | option.map (map channel.recv)
    | echo
    | const 1
    | filled-channel
    | flip Route EndRoute
    | both id (const 1 | route-channel)
    | tap (fork channel.send .1 .0)
    | ignore
    | const 1
    | nested-pair
    | .1
    | tap channel.close
    | fork channel.send id (const 1 | filled-channel)
    | echo
    | const 1
    | nested-pair
    | .1
    | nested-send
    | task.spawn
    | tap (const () | task.yield)
    | tap task.cancel
    | task.await
    | echo
    | const 1
    | nested-channel
    | nested-receive
    | task.spawn
    | tap (const () | task.yield)
    | tap task.cancel
    | task.await
    | option.map ignore
    | echo
    | const 1
    | flip range 65
    | each (nested-pair | ignore)
    | const 1
    | attempt nested-failure
    | echo
round : () -> () ! {Async, IO}
round =
    const "input"
    | string.repeat 2
    | value
    | task.spawn
    | both task.await task.await
    | echo
    | const "early"
    | string.repeat 2
    | sleeping
    | task.spawn
    | tap task.cancel
    | task.await
    | echo
    | const "entered"
    | string.repeat 2
    | sleeping
    | task.spawn
    | tap (const () | task.yield)
    | tap task.cancel
    | task.await
    | echo
    | const "within"
    | string.repeat 2
    | value
    | task.within 1h
    | echo
    | const "older"
    | string.repeat 2
    | value
    | task.spawn
    | awaiting
    | task.spawn
    | task.await
    | echo
    | const own-state
    | task.spawn
    | task.await
    | echo
    | const ()
    | attempt (const scope-failure | task.scope)
    | echo
    | const (const "joined" | string.repeat 2 | start-value | ignore)
    | task.scope
    | const 0
    | flip range 65
    | map show
    | task.map (string.repeat 3)
    | length
    | echo
    | const 2
    | text-channel
    | tap (flip channel.send ("kept" | string.repeat 2))
    | tap channel.close
    | channel.recv
    | echo
    | const 1
    | text-channel
    | channel.recv-for 0ns
    | echo
    | const 1
    | text-channel
    | tap channel.close
    | flip channel.send "rejected"
    | echo
    | const 1
    | data-channel
    | tap (flip channel.send (Cell ("data" | string.repeat 2) End))
    | tap channel.close
    | channel.recv
    | echo
    | const 1
    | text-channel
    | start-receive
    | tap (const () | task.yield)
    | tap task.cancel
    | task.await
    | echo
    | const 1
    | text-channel
    | tap (flip channel.send ("full" | string.repeat 2))
    | start-send
    | tap (const () | task.yield)
    | tap task.cancel
    | task.await
    | echo
    | const 1
    | flip range 65
    | each undrained
    | const 1
    | attempt queue-failure
    | echo
    | nested-round
main = () | round
