# Hash the same values as a list, packed array, set and map of key/value pairs.
# Each hash includes its container's length and the scalar's canonical byte width.
check : List[a] -> (U64, (U64, (U64, U64))) where Ord[a], Hash[a]
check = both hash (both
    (array.from-list | hash)
    (both (set.from-list | hash) (map (both id id) | map.from-list | hash)))
empty : List[I16]
empty = []
Samples = { index: I16, values: Array[F32] }
sample : Array[F32] -> Samples
sample = make Samples { index = const -7i16, values = id }
hash-f32 : F32 -> U64
hash-f32 = repeat 2 | array.from-list | hash
hash-f64 : F64 -> U64
hash-f64 = repeat 2 | array.from-list | hash
main = [
    [-128i8, -1i8, 0i8, 127i8] | check | echo,
    [0u8, 127u8, 128u8, 255u8] | check | echo,
    [-32768i16, -1i16, 32767i16] | check | echo,
    [0u16, 32768u16, 65535u16] | check | echo,
    [-2147483648i32, 0i32, 2147483647i32] | check | echo,
    [0u32, 2147483648u32, 4294967295u32] | check | echo,
    [-9223372036854775808, 0, 9223372036854775807] | check | echo,
    [0u64, 9223372036854775808u64, 18446744073709551615u64] | check | echo,
    [-1isize, 0isize, 2147483647isize] | check | echo,
    [0usize, 4294967295usize] | check | echo,
    [-0.0f32, 0.0f32, -1.5f32, 3.25f32] | check | echo,
    [-0.0, 0.0, -1.5, 3.25] | check | echo,
    ["nan", "inf", "-inf"] | map (parse-float | option.map hash-f32) | echo,
    ["nan", "inf", "-inf"] | map (parse-float | option.map hash-f64) | echo,
    empty | check | echo,
    range 0 129 | check | echo,
    range -64i8 64i8
    | array.from-list
    | both hash (array.slice 2 99 | hash)
    | echo,
    repeat 64 -0.0f32
    | array.from-list
    | array.slice 2 50
    | both (sample | hash) array.to-list
    | echo,
    [(-7i16, -0.0), (9i16, 1.25)] | map.from-list | both hash map.to-list | echo,
    range 0 64 | array.from-list | both id (array.set 3 99) | hash | echo,
] | ignore
