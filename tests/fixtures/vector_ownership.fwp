    [2f128] | array.from-list | array.slice 0 0 | empty | option.map simd.sum | echo,
    [2f128] | array.from-list | four | echo,
    [1i128, 2i128, 3i128, 4i128, 5i128] | array.from-list | array.slice 1 4
        | both (four | option.map (simd.min (simd.splat 3i128) | simd.to-array | array.to-list)) (array.set 1 99i128 | option.map array.to-list) | echo,
    range 0i32 64i32 | map (simd.splat | simd._test-i4 | simd.sum) | sum | echo,
] | ignore
