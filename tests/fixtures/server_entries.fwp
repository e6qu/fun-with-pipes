# Values cross generated REST and MCP entries in both directions. The returned
# aliases must survive decoding cleanup; errors must release their input too.
# expose: rest, mcp

Payload = { text: String, values: List[I64] }

export copy : Payload -> Payload
copy = id

export duplicate : Payload -> (Payload, Payload)
duplicate = dup

export checked : I64 -> String ! {Error[String]}
checked = if (eq 0) (const "zero" | fail) (format "value {}")

export outcome : I64 -> Result[String, String]
outcome = if (eq 0) (const (Err "zero")) (format "value {}" | Ok)

export slow : Payload -> Payload ! {Async, IO}
slow = tap (const "entry waiting" | eprint) | tap (const 100ms | task.sleep)

# Tests stop HTTP servers through the runtime's normal shutdown path.
# Standard-input servers still finish when their input ends.
export stop : () -> String ! {Async}
stop = signal.request-shutdown | const "stopping"

# Each numeric type must cross the generated entry without a conversion to F64.
ExactNumbers = {
    unsigned: U64,
    wide: I128,
    u-wide: U128,
    precise: F128,
    precise-near-one: F128,
}

export exact : ExactNumbers -> ExactNumbers
exact = id

export exact-failure : ExactNumbers -> () ! {Error[ExactNumbers]}
exact-failure = fail
