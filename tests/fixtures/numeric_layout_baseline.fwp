export step : I64 -> (Array[I8], Array[U8], Array[I16], Array[U16], Array[I32], Array[U32], Array[F32], Array[F64])
step = make {
    0 = flip array.make (-128i8),
    1 = flip array.make 255u8,
    2 = flip array.make (-32768i16),
    3 = flip array.make 65535u16,
    4 = flip array.make (-2147483648i32),
    5 = flip array.make 4294967295u32,
    6 = flip array.make (-0.0f32),
    7 = flip array.make (-0.0),
}
export floats : F64 -> (F64, F64, F64)
floats = make { 0 = id, 1 = add 0.25, 2 = neg }
export scalar : F64 -> F64
scalar = add 0.125
main = [3 | step | echo, 1.25 | floats | echo, 1.25 | scalar | echo] | ignore
