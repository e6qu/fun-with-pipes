# Each event owns a callback; each callback keeps one shared socket alive.
# Testing its address avoids printing the OS-selected port.
Event = { check: () -> Bool ! {Network} }
events : I64 -> Channel[Event] ! {Async}
events = channel.make
udp-live : UdpSocket -> () -> Bool ! {Network}
udp-live = curry (.0 | udp.local-addr | string.length | gt 0)
listener-live : Listener -> () -> Bool ! {Network}
listener-live = curry (.0 | tcp.local-addr | string.length | gt 0)
connection-live : Conn -> () -> Bool ! {Network}
connection-live = curry (.0 | tcp.peer-addr | string.length | gt 0)
udp-event : () -> Event ! {Network, Error[IoError]}
udp-event =
    const "127.0.0.1:0" | udp.bind | udp-live | make Event { check = id }
listener-event : () -> Event ! {Network, Error[IoError]}
listener-event =
    const "127.0.0.1:0" | tcp.listen | listener-live | make Event { check = id }
connection-event : () -> Event ! {Async, Network, Error[IoError]}
connection-event =
    const "127.0.0.1:0"
    | tcp.listen
    | both (tcp.local-addr | tcp.connect) tcp.accept
    | .0
    | connection-live
    | make Event { check = id }
enqueue : Event -> Channel[Event] ! {Async}
enqueue = both (const 1 | events) id | tap (fork channel.send .0 .1) | .0
check-twice : Event -> Bool ! {Network}
check-twice = .check | both (apply ()) (apply ()) | eq (True, True)
received : Channel[Event] -> Bool ! {Async, Network}
received = channel.recv | option.map check-twice | option.unwrap-or False
require : Bool -> ()
require =
    if id (const ()) (const "socket ownership assertion failed" | prim.trap)
closed-udp : () -> Event ! {Network, Error[IoError]}
closed-udp =
    const "127.0.0.1:0"
    | udp.bind
    | both (udp-live | make Event { check = id }) id
    | tap (.1 | udp.close)
    | .0
# A waiting callback suspends in socket IO after it has left the queue.
# The stored function declares the task API's permitted effects. Before spawn,
# attempt turns IoError into a Result so no error escapes the child task.
Wait = { call: () -> () ! {Async, IO, Network, FileIO, Error[IoError]} }
waits : I64 -> Channel[Wait] ! {Async}
waits = channel.make
udp-wait : UdpSocket -> () -> () ! {Async, Network, Error[IoError]}
udp-wait = curry (.0 | udp.recv-from 1 | ignore)
listener-wait : Listener -> () -> () ! {Async, Network, Error[IoError]}
listener-wait = curry (.0 | tcp.accept | ignore)
connection-wait : (Conn, Conn) -> () -> () ! {Async, Network, Error[IoError]}
connection-wait = curry (.0 | .0 | tcp.read 1 | ignore)
new-udp-wait : () -> Wait ! {Network, Error[IoError]}
new-udp-wait =
    const "127.0.0.1:0" | udp.bind | udp-wait | make Wait { call = id }
new-listener-wait : () -> Wait ! {Network, Error[IoError]}
new-listener-wait =
    const "127.0.0.1:0" | tcp.listen | listener-wait | make Wait { call = id }
new-connection-wait : () -> Wait ! {Async, Network, Error[IoError]}
new-connection-wait =
    const "127.0.0.1:0"
    | tcp.listen
    | both (tcp.local-addr | tcp.connect) tcp.accept
    | connection-wait
    | make Wait { call = id }
cancel-received : Wait -> () ! {Async}
cancel-received =
    both (const 1 | waits) id
    | tap (fork channel.send .0 .1)
    | .0
    | channel.recv
    | option.map (.call
        | attempt
        | task.spawn
        | tap (const () | task.yield)
        | tap task.cancel
        | task.await)
    | eq (Some None)
    | require
# Closing through an alias must make an already retained callback fail normally.
closed-wait : () -> Wait ! {Network, Error[IoError]}
closed-wait =
    const "127.0.0.1:0"
    | udp.bind
    | both (udp-wait | make Wait { call = id }) id
    | tap (.1 | udp.close)
    | .0
call-closed : Wait -> () ! {Async, IO, Network, FileIO}
call-closed =
    both (const 1 | waits) id
    | tap (fork channel.send .0 .1)
    | .0
    | channel.recv
    | option.map (.call | attempt | apply () | result.is-ok)
    | eq (Some False)
    | require
send-pending : Channel[Event] -> () -> Bool ! {Async, Network, Error[IoError]}
send-pending = curry (fork channel.send .0 (.1 | udp-event))
fail-queued : Channel[Event] -> () ! {Error[String]}
fail-queued = const "expected" | fail
round : () -> () ! {Async, IO, Network, FileIO, Error[IoError]}
round =
    tap (udp-event | enqueue | received | require)
    | tap (listener-event | enqueue | tap channel.close | received | require)
    | tap (connection-event | enqueue | received | require)
    # Explicit close is visible through the callback's retained alias.
    | tap (closed-udp | enqueue | received | eq False | require)
    | tap (closed-wait | call-closed)
    | tap (new-udp-wait | cancel-received)
    | tap (new-listener-wait | cancel-received)
    | tap (new-connection-wait | cancel-received)
    # Dropping undrained queues releases their callbacks and sockets.
    | tap (udp-event | enqueue | ignore)
    | tap (listener-event | enqueue | tap channel.close | ignore)
    | tap (connection-event | enqueue | ignore)
    # A caught failure unwinds a filled queue.
    | tap (udp-event | enqueue | attempt fail-queued | ignore)
    # Cancel a sender blocked by a full queue. Its pending event owns a socket.
    | tap (udp-event | enqueue | send-pending | attempt | task.spawn | tap (const () | task.yield) | tap task.cancel | task.await | eq None | require)
    # Sending to a closed queue releases the rejected event too.
    | tap (udp-event | enqueue | tap channel.close | send-pending | apply () | eq False | require)
    | ignore
main =
    0
    | flip range 64
    | each (const () | round)
    | const "socket queues released"
    | print
