# The harness prepares input bytes and files with known modification times.
main = [
    # Repeatedly walk a nested tree and sum metadata sizes through ordinary pipes.
    range 0 64 | map (const "tree" | dir.walk | map (file.info | .size) | sum) | echo,
    dir.create "made",
    # Text writes replace the file. Embedded NUL is data, not a path terminator.
    "héllo\n世界\n" | file.write-new "made/text",
    range 0 64 | map (const "made/text" | file.read) | echo,
    "a\0b" | file.write-new "made/text",
    file.read "made/text" | echo,
    "" | file.write-new "made/text",
    file.read "made/text" | echo,
    file.read "empty" | echo,
    "input" | attempt (file.read | ignore) | echo,
    "absent" | attempt (file.read | ignore) | echo,
    "bad\0path" | attempt (file.read | ignore) | echo,
    "made" | attempt (file.write-new "bad\0path") | echo,
    "data" | attempt (file.write-new "absent/text") | echo,
    bytes.from-list [0u8, 255, 13, 10] | file.write-bytes "made/data",
    "héllo" | file.append "made/data",
    file.read-bytes "made/data" | bytes.to-list | echo,
    file.read-bytes "empty" | bytes.length | echo,
    file.read-bytes "input" | bytes.length | echo,
    file.info "input" | .size | echo,
    file.info "input" | .is-dir | echo,
    file.info "made" | .is-dir | echo,
    file.info "old" | .modified | echo,
    file.info "future" | .modified | echo,
    "made/data" | file.copy "made/copy",
    "made/copy" | file.rename "made/moved",
    file.exists "made/moved" | echo,
    file.is-dir "made" | echo,
    file.remove "made/data",
    file.remove "made/moved",
    file.remove "made/text",
    dir.remove "made",
    file.exists "made" | echo,
    "input/child" | attempt dir.create-all | echo,
    "input/" | attempt dir.create-all | echo,
    "input" | attempt dir.create-all | echo,
    "absent" | attempt (file.info | ignore) | echo,
    "absent" | attempt (file.read-bytes | ignore) | echo,
] | ignore
