# Send a newly created string, receive it immediately and check its length.
# The explicit loop keeps one channel and two integer counters alive; it does
# not build a list of inputs. `work n` returns n after n successful exchanges.
texts : I64 -> Channel[String] ! {Async}
texts = channel.make
width : I64 -> I64
width = rem 64 | add 1
text : I64 -> String
text = width | flip string.repeat "x"
exchange : (Channel[String], I64) -> () ! {Async, Error[String]}
exchange =
    tap (fork channel.send .0 (.1 | text))
    | both (.0 | channel.recv | option.map string.length | option.unwrap-or 0) (.1 | width)
    | uncurry eq
    | if id (const ()) (const "wrong queue value" | fail)
step : (Channel[String], I64, I64) -> Step[(Channel[String], I64, I64), I64] ! {Async, Error[String]}
step = if (fork lt .2 .1)
    (tap (both .0 .1 | exchange) | make { 0 = .0, 1 = .1 | add 1, 2 = .2 } | Again)
    (tap (.0 | channel.close) | .1 | Stop)
export work : I64 -> I64 ! {Async, Error[String]}
work = make { 0 = const 1 | texts, 1 = const 0, 2 = id } | loop step
main = 16 | work | echo
