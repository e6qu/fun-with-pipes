# A Kernel describes arithmetic to execute for each array element. Opcodes here
# mean input, constant, multiply, constant, add: x * 0.5 + 1.0.
kernel-of : Array[F64] -> Kernel
kernel-of = make Kernel {
    code = const ([0, 1, 4, 1, 2] | array.from-list),
    consts = const ([0.5, 1.0] | array.from-list),
    inputs = singleton,
    length = array.length,
}
# Keep input and result hashes, and compare fixed-order reductions for each
# worker count. Hashing preserves floating bits, including signed zero.
check-kernel = make {
    0 = id | hash,
    1 = kernel.run Cpu | hash,
    2 = kernel.run (CpuParallel 4) | hash,
    3 = kernel.sum Cpu,
    4 = kernel.sum (CpuParallel 4),
}
main = [
    [0, 1, 255, 256, 257, 4095, 4096, 4097]
    | map (range 0
        | map (int.to-float | mul 0.25)
        | array.from-list
        | kernel-of
        | check-kernel)
    | echo,
    [-0.0, 0.0, 3.5, -2.0, 0.00001]
    | array.from-list
    | array.slice 1 3
    | both id (kernel-of | check-kernel)
    | echo,
    [1, 2, 4, 256]
    | map (CpuParallel
        | flip kernel.run Kernel {
            code = [1] | array.from-list,
            consts = [-0.0] | array.from-list,
            inputs = [],
            length = 3,
        }
        | hash)
    | echo,
    range 0 32
    | map (const [1.0, 2.0, 3.0]
        | array.from-list
        | kernel-of
        | kernel.run Cpu
        | hash)
    | echo,
    range 0 32
    | map (const [1.0, 2.0, 3.0] | array.from-list | kernel-of | kernel.sum Cpu)
    | echo,
    Kernel {
        code = [1] | array.from-list,
        consts = [2.5] | array.from-list,
        inputs = [],
        length = -1,
    } | both (kernel.run Cpu | array.length) (kernel.sum Cpu) | echo,
] | ignore
