# One example of each lint rule.

# unused-binding: private, not main, never referred to
helper = add 1

used = mul 2

# a recursive binding that only refers to itself is still unused
rec countdown = match
    0 -> 0
    _ -> sub 1 | countdown

export twice : I64 -> I64
twice = used | id

# map-fusion
lengths = map words | map length

# trivial-match
apply-all = match
    _ -> const 0

# shadows-std
flatten = id

# missing-binding
orphan : I64 -> I64

# filter-count, filter-find
evens = filter (rem 2 | eq 0) | length

first-even = filter (rem 2 | eq 0) | head

# double-reverse
same = reverse | reverse

# bool-if
positive = if (gt 0) (const True) (const False)

main = [1, 2] | map twice | echo | ignore
