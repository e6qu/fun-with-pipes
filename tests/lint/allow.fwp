# `# fwp:allow(code, ...)` above a declaration silences rules inside it.

# fwp:allow(unused-binding)
helper = add 1

# a ruler, then the allowance
# fwp:allow(redundant-id, map-fusion)
twice = map (mul 2) | id | map show | map string.length

# only the listed rule is silenced
# fwp:allow(redundant-id)
again : List[I64] -> List[I64]
again = map show | map string.length

# a signature and its binding are one declaration
# fwp:allow(shadows-std)
reverse : List[a] -> List[a]
reverse = id

main = [[1, 2] | twice | echo, [3] | again | reverse | echo] | ignore
