# The greeting service.
# implementations of the methods of helloworld.Greeter
GreeterServer = {
    say-hello: HelloRequest -> HelloReply ! {Async, IO, Network, FileIO, Error[GrpcError]},
    watch: HelloRequest -> Channel[HelloReply] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
    collect: Iterator[HelloRequest] -> HelloReply ! {Async, IO, Network, FileIO, Error[GrpcError]},
    chat: Iterator[HelloRequest] -> Channel[HelloReply] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
    ping: () -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
}

# the routes of helloworld.Greeter: `impl | greeter.routes | grpc.serve address`
greeter.routes : GreeterServer -> List[GrpcRoute]
greeter.routes =
    fork
        Cons
        (.say-hello | greeter.say-hello.route)
        (fork
            Cons
            (.watch | greeter.watch.route)
            (fork
                Cons
                (.collect | greeter.collect.route)
                (fork
                    Cons
                    (.chat | greeter.chat.route)
                    (fork Cons (.ping | greeter.ping.route) (const Nil)))))
