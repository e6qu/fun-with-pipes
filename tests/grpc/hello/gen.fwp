# Generated by `fwp proto --import hello.proto`: types, codecs, clients and
# server routes for package helloworld. Do not edit; see docs/grpc.md.

Mood =
    | Mood.Unknown
    | Mood.Happy
    | Mood.Grumpy

mood.from-int : I64 -> Mood
mood.from-int = match
    1 -> Mood.Happy
    2 -> Mood.Grumpy
    _ -> const Mood.Unknown

mood.to-int : Mood -> I64
mood.to-int = match
    Mood.Unknown -> 0
    Mood.Happy -> 1
    Mood.Grumpy -> 2

mood.codec : PbCodec[Mood]
mood.codec = pb.enum mood.from-int mood.to-int Mood.Unknown

ProtobufTimestamp = { seconds: I64, nanos: I32 }

protobuf-timestamp.default : ProtobufTimestamp
protobuf-timestamp.default = ProtobufTimestamp { seconds = 0, nanos = 0 }

rec protobuf-timestamp.encode : ProtobufTimestamp -> Bytes
protobuf-timestamp.encode =
    pb.encode [.seconds | pb.field 1 pb.int64, .nanos | pb.field 2 pb.int32]

rec protobuf-timestamp.decode : Bytes -> ProtobufTimestamp ! {Error[GrpcError]}
protobuf-timestamp.decode =
    pb.decode
    | make ProtobufTimestamp {
        seconds = pb.get 1 pb.int64,
        nanos = pb.get 2 pb.int32,
    }

rec protobuf-timestamp.codec : PbCodec[ProtobufTimestamp]
protobuf-timestamp.codec =
    pb.message
        protobuf-timestamp.encode
        protobuf-timestamp.decode
        protobuf-timestamp.default

# The response message containing the greetings
HelloReply = { message: String }

hello-reply.default : HelloReply
hello-reply.default = HelloReply { message = "" }

rec hello-reply.encode : HelloReply -> Bytes
hello-reply.encode = pb.encode [.message | pb.field 1 pb.string]

rec hello-reply.decode : Bytes -> HelloReply ! {Error[GrpcError]}
hello-reply.decode =
    pb.decode | make HelloReply { message = pb.get 1 pb.string }

rec hello-reply.codec : PbCodec[HelloReply]
hello-reply.codec =
    pb.message hello-reply.encode hello-reply.decode hello-reply.default

# the `oneof extra` of HelloRequest
HelloRequestExtra =
    | HelloRequestExtra.Note String
    | HelloRequestExtra.At HelloRequestPoint

# The request message containing the user's name.
HelloRequest = {
    name: String,
    times: I32,
    tags: List[String],
    counts: Map[String, I64],
    mood: Option[Mood],
    extra: Option[HelloRequestExtra],
    when: ProtobufTimestamp,
    tree: Tree,
    blob: Bytes,
    delta: I64,
    f32: U32,
    ratio: F32,
}

hello-request-extra.fields : HelloRequestExtra -> List[PbField]
hello-request-extra.fields = match
    HelloRequestExtra.Note _ -> pb.always 6 pb.string
    HelloRequestExtra.At _ -> pb.always 7 hello-request-point.codec

hello-request.default : HelloRequest
hello-request.default = HelloRequest {
    name = "",
    times = 0,
    tags = [],
    counts = map.empty,
    mood = None,
    extra = None,
    when = protobuf-timestamp.default,
    tree = tree.default,
    blob = bytes.from-list [],
    delta = 0,
    f32 = 0,
    ratio = 0.0,
}

rec hello-request.encode : HelloRequest -> Bytes
hello-request.encode = pb.encode [
    .name | pb.field 1 pb.string,
    .times | pb.field 2 pb.int32,
    .tags | pb.repeated 3 pb.string,
    .counts | pb.map 4 pb.string pb.int64,
    .mood | pb.optional 5 mood.codec,
    .extra | pb.oneof hello-request-extra.fields,
    .when | pb.field 8 protobuf-timestamp.codec,
    .tree | pb.field 9 tree.codec,
    .blob | pb.field 10 pb.bytes,
    .delta | pb.field 11 pb.sint64,
    .f32 | pb.field 12 pb.fixed32,
    .ratio | pb.field 13 pb.float,
]

rec hello-request.decode : Bytes -> HelloRequest ! {Error[GrpcError]}
hello-request.decode =
    pb.decode
    | make HelloRequest {
        name = pb.get 1 pb.string,
        times = pb.get 2 pb.int32,
        tags = pb.get-repeated 3 pb.string,
        counts = pb.get-map 4 pb.string pb.int64,
        mood = pb.get-optional 5 mood.codec,
        extra = pb.first-of [
            pb.get-optional 6 pb.string | option.map HelloRequestExtra.Note,
            pb.get-optional 7 hello-request-point.codec
            | option.map HelloRequestExtra.At,
        ],
        when = pb.get 8 protobuf-timestamp.codec,
        tree = pb.get 9 tree.codec,
        blob = pb.get 10 pb.bytes,
        delta = pb.get 11 pb.sint64,
        f32 = pb.get 12 pb.fixed32,
        ratio = pb.get 13 pb.float,
    }

rec hello-request.codec : PbCodec[HelloRequest]
hello-request.codec =
    pb.message hello-request.encode hello-request.decode hello-request.default

HelloRequestPoint = { x: F64, y: F64 }

hello-request-point.default : HelloRequestPoint
hello-request-point.default = HelloRequestPoint { x = 0.0, y = 0.0 }

rec hello-request-point.encode : HelloRequestPoint -> Bytes
hello-request-point.encode =
    pb.encode [.x | pb.field 1 pb.double, .y | pb.field 2 pb.double]

rec hello-request-point.decode : Bytes -> HelloRequestPoint ! {Error[GrpcError]}
hello-request-point.decode =
    pb.decode
    | make HelloRequestPoint { x = pb.get 1 pb.double, y = pb.get 2 pb.double }

rec hello-request-point.codec : PbCodec[HelloRequestPoint]
hello-request-point.codec =
    pb.message
        hello-request-point.encode
        hello-request-point.decode
        hello-request-point.default

Tree = { left: Option[Tree], value: I32, kids: List[Tree] }

tree.default : Tree
tree.default = Tree { left = None, value = 0, kids = [] }

rec tree.encode : Tree -> Bytes
tree.encode = pb.encode [
    .left | pb.optional 1 tree.codec,
    .value | pb.field 2 pb.int32,
    .kids | pb.repeated 3 tree.codec,
]

rec tree.decode : Bytes -> Tree ! {Error[GrpcError]}
tree.decode =
    pb.decode
    | make Tree {
        left = pb.get-optional 1 tree.codec,
        value = pb.get 2 pb.int32,
        kids = pb.get-repeated 3 tree.codec,
    }

rec tree.codec : PbCodec[Tree]
tree.codec = pb.message tree.encode tree.decode tree.default

