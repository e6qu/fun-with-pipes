import gen

say-hello : gen.HelloRequest -> gen.HelloReply
say-hello = make gen.HelloReply { message = .name | flip concat "hello, " }

reply : String -> gen.HelloReply
reply = make gen.HelloReply { message = id }

watch : gen.HelloRequest -> Channel[gen.HelloReply] -> () ! {Async}
watch = curry (fork
    each
    (.1
        | channel.send
        | compose (show | flip concat "tick " | reply)
        | flip compose ignore)
    (.0 | .times | int.convert | option.unwrap-or 0 | add 1 | range 1))

collect : Iterator[gen.HelloRequest] -> gen.HelloReply
collect = iter.to-list | map .name | join "+" | reply

chat : Iterator[gen.HelloRequest] -> Channel[gen.HelloReply] -> () ! {Async}
chat = curry (fork
    each
    (.1 | channel.send | compose (.name | upper | reply) | flip compose ignore)
    (.0 | iter.to-list))

service : gen.GreeterServer
service = gen.GreeterServer {
    say-hello = say-hello,
    watch = watch,
    collect = collect,
    chat = chat,
    ping = id,
}

main =
    service
    | gen.greeter.routes
    | grpc.serve (args () | head | option.unwrap-or "127.0.0.1:50051")
