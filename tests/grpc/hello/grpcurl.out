$ grpcurl list
grpc.health.v1.Health
helloworld.Greeter
$ grpcurl describe helloworld.Greeter
helloworld.Greeter is a service:
service Greeter {
  rpc Chat ( stream .helloworld.HelloRequest ) returns ( stream .helloworld.HelloReply );
  rpc Collect ( stream .helloworld.HelloRequest ) returns ( .helloworld.HelloReply );
  rpc Ping ( .google.protobuf.Empty ) returns ( .google.protobuf.Empty );
  rpc SayHello ( .helloworld.HelloRequest ) returns ( .helloworld.HelloReply );
  rpc Watch ( .helloworld.HelloRequest ) returns ( stream .helloworld.HelloReply );
}
$ grpcurl describe helloworld.HelloRequest
helloworld.HelloRequest is a message:
message HelloRequest {
  string name = 1;
  int32 times = 2;
  repeated string tags = 3;
  map<string, int64> counts = 4;
  optional .helloworld.Mood mood = 5;
  oneof extra {
    string note = 6;
    .helloworld.HelloRequest.Point at = 7;
  }
  .google.protobuf.Timestamp when = 8;
  .helloworld.Tree tree = 9;
  bytes blob = 10;
  sint64 delta = 11;
  fixed32 f32 = 12;
  float ratio = 13;
  message Point {
    double x = 1;
    double y = 2;
  }
}
$ grpcurl describe google.protobuf.Timestamp
google.protobuf.Timestamp is a message:
message Timestamp {
  int64 seconds = 1;
  int32 nanos = 2;
}
$ grpcurl -d {"name": "Ada"} helloworld.Greeter/SayHello
{
  "message": "hello, Ada"
}
$ grpcurl -d {"name": "a"} {"name": "b"} helloworld.Greeter/Chat
{
  "message": "A"
}
{
  "message": "B"
}
