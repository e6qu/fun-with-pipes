# implementations of the methods of test.Greeter
GreeterServer = {
    say-hello: HelloRequest -> HelloReply ! {Async, IO, Network, FileIO, Error[GrpcError]},
    count: CountRequest -> Channel[CountResponse] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
    ticks: TicksRequest -> Channel[TicksResponse] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
    total: Iterator[TotalRequest] -> TotalResponse ! {Async, IO, Network, FileIO, Error[GrpcError]},
    shout: Iterator[ShoutRequest] -> Channel[ShoutResponse] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
    find: FindRequest -> HelloReply ! {Async, IO, Network, FileIO, Error[GrpcError]},
    slow: SlowRequest -> SlowResponse ! {Async, IO, Network, FileIO, Error[GrpcError]},
    whoami: WhoamiRequest -> WhoamiResponse ! {Async, IO, Network, FileIO, Error[GrpcError]},
    boom: BoomRequest -> BoomResponse ! {Async, IO, Network, FileIO, Error[GrpcError]},
    divide: DivideRequest -> DivideResponse ! {Async, IO, Network, FileIO, Error[GrpcError]},
    nap: NapRequest -> NapResponse ! {Async, IO, Network, FileIO, Error[GrpcError]},
}

# the routes of test.Greeter: `impl | greeter.routes | grpc.serve address`
greeter.routes : GreeterServer -> List[GrpcRoute]
greeter.routes =
    fork
        Cons
        (.say-hello | greeter.say-hello.route)
        (fork
            Cons
            (.count | greeter.count.route)
            (fork
                Cons
                (.ticks | greeter.ticks.route)
                (fork
                    Cons
                    (.total | greeter.total.route)
                    (fork
                        Cons
                        (.shout | greeter.shout.route)
                        (fork
                            Cons
                            (.find | greeter.find.route)
                            (fork
                                Cons
                                (.slow | greeter.slow.route)
                                (fork
                                    Cons
                                    (.whoami | greeter.whoami.route)
                                    (fork
                                        Cons
                                        (.boom | greeter.boom.route)
                                        (fork
                                            Cons
                                            (.divide | greeter.divide.route)
                                            (fork
                                                Cons
                                                (.nap | greeter.nap.route)
                                                (const Nil)))))))))))
