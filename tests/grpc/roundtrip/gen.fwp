# the `oneof result` of DivideResponse
DivideResponseResult =
    | DivideResponseResult.Value I64
    | DivideResponseResult.Error String

DivideResponse = { result: Option[DivideResponseResult] }

divide-response-result.fields : DivideResponseResult -> List[PbField]
divide-response-result.fields = match
    DivideResponseResult.Value _ -> pb.always 1 pb.sint64
    DivideResponseResult.Error _ -> pb.always 2 pb.string

divide-response.default : DivideResponse
divide-response.default = DivideResponse { result = None }

rec divide-response.encode : DivideResponse -> Bytes
divide-response.encode =
    pb.encode [.result | pb.oneof divide-response-result.fields]

rec divide-response.decode : Bytes -> DivideResponse ! {Error[GrpcError]}
divide-response.decode =
    pb.decode
    | make DivideResponse {
        result = pb.first-of [
            pb.get-optional 1 pb.sint64 | option.map DivideResponseResult.Value,
            pb.get-optional 2 pb.string | option.map DivideResponseResult.Error,
        ],
    }

rec divide-response.codec : PbCodec[DivideResponse]
divide-response.codec =
    pb.message
        divide-response.encode
        divide-response.decode
