# Calls the greeter of tests/grpc/greeter.fwp through the module that
# `fwp proto --import` generates from the .proto file `fwp proto --grpc`
# prints for it.

import gen

drained : (Channel[a] -> () ! {Async, Network, Error[GrpcError]}) -> List[a] ! {Async, Network, Error[GrpcError]}
drained =
    fork apply (const 100 | channel.make) tap
    | tap channel.close
    | channel.drain

calls : List[String -> () ! {Async, IO, Network, Error[GrpcError]}]
calls = [
    flip gen.greeter.say-hello gen.HelloRequest { name = "Ada", times = 1 }
    | .message
    | echo,
    flip gen.greeter.count gen.CountRequest { arg1 = 4 }
    | drained
    | map .value
    | echo,
    flip gen.greeter.ticks gen.TicksRequest { arg1 = 2 }
    | drained
    | map .value
    | echo,
    flip
        gen.greeter.total
        ([3, 4] | map (make gen.TotalRequest { arg1 = id }) | iter.from-list)
    | .value
    | echo,
    flip gen.greeter.shout (["x", "y"]
        | map (make gen.ShoutRequest { arg1 = id })
        | iter.from-list)
    | drained
    | map .value
    | echo,
    flip
        gen.greeter.firsts
        (1 | iter.count-from | iter.map (make gen.FirstsRequest { arg1 = id }))
    | drained
    | map .value
    | echo,
    attempt (flip gen.greeter.find gen.FindRequest { arg1 = "ghost" }) | echo,
    flip gen.greeter.whoami () | .value | echo,
    flip gen.greeter.divide gen.DivideRequest { arg1 = 8, arg2 = 0 }
    | .result
    | echo,
    flip gen.greeter.divide gen.DivideRequest { arg1 = 2, arg2 = 8 }
    | .result
    | echo,
    attempt (flip gen.greeter.boom gen.BoomRequest { arg1 = 1 }) | echo,
]

main =
    calls
    | map (apply (args () | head | option.unwrap-or "127.0.0.1:50051"))
    | ignore
