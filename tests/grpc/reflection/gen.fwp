# ---- descriptors

# the descriptors of the `.proto` files, which the routes carry for server
# reflection (`grpc.serve` answers grpcurl and other clients with them)
proto-files : List[GrpcFile]
proto-files = [
    GrpcFile {
        name = "reflection.proto",
        descriptor =
            grpc.base64-bytes
                "",
        symbols = [
            "grpc.reflection.v1.ServerReflectionRequest",
            "grpc.reflection.v1.ExtensionRequest",
            "grpc.reflection.v1.ServerReflectionResponse",
            "grpc.reflection.v1.FileDescriptorResponse",
            "grpc.reflection.v1.ExtensionNumberResponse",
            "grpc.reflection.v1.ListServiceResponse",
            "grpc.reflection.v1.ServiceResponse",
            "grpc.reflection.v1.ErrorResponse",
            "grpc.reflection.v1.ServerReflection",
        ],
        imports = ["descriptor.proto"],
    },
    GrpcFile {
        name = "descriptor.proto",
        descriptor =
            grpc.base64-bytes
                "",
        symbols = [
            "google.protobuf.FileDescriptorProto",
            "google.protobuf.DescriptorProto",
            "google.protobuf.FieldDescriptorProto",
            "google.protobuf.ServiceDescriptorProto",
            "google.protobuf.MethodDescriptorProto",
        ],
        imports = [],
    },
]

# ---- service grpc.reflection.v1.ServerReflection

# rpc ServerReflectionInfo(stream ServerReflectionRequest) returns (stream ServerReflectionResponse): a call to the service at an address
server-reflection.server-reflection-info : String -> Iterator[ServerReflectionRequest] -> Channel[ServerReflectionResponse] -> () ! {Async, Network, Error[GrpcError]}
server-reflection.server-reflection-info =
    grpc.bidi-streaming
        server-reflection-request.encode
        server-reflection-response.decode
        "/grpc.reflection.v1.ServerReflection/ServerReflectionInfo"

# the route serving `ServerReflectionInfo` with a function
server-reflection.server-reflection-info.route : (Iterator[ServerReflectionRequest] -> Channel[ServerReflectionResponse] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcRoute
server-reflection.server-reflection-info.route =
    grpc.bidi-streaming-handler
        server-reflection-request.decode
        server-reflection-response.encode
    | grpc.route "/grpc.reflection.v1.ServerReflection/ServerReflectionInfo"
    | grpc.with-files proto-files

# implementations of the methods of grpc.reflection.v1.ServerReflection
ServerReflectionServer = {
    server-reflection-info: Iterator[ServerReflectionRequest] -> Channel[ServerReflectionResponse] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
}

# the routes of grpc.reflection.v1.ServerReflection: `impl | server-reflection.routes | grpc.serve address`
server-reflection.routes : ServerReflectionServer -> List[GrpcRoute]
server-reflection.routes =
    fork
        Cons
        (.server-reflection-info
            | server-reflection.server-reflection-info.route)
        (const Nil)
