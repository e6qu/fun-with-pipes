# a recursive function returning a record of six fields
Stats = { n: I64, sum: I64, min: I64, max: I64, even: I64, odd: I64 }

rec stats : I64 -> Stats
stats = match
    0 -> Stats { n = 0, sum = 0, min = 1000000000, max = 0, even = 0, odd = 0 }
    _ -> fork add-one id (sub 1 | stats)

add-one : I64 -> Stats -> Stats
add-one = curry (make Stats {
    n = .1 | .n | add 1,
    sum = fork add .0 (.1 | .sum),
    min = fork min .0 (.1 | .min),
    max = fork max .0 (.1 | .max),
    even = fork add (.0 | rem 2 | eq 0 | if id (const 1) (const 0)) (.1 | .even),
    odd = fork add (.0 | rem 2 | eq 1 | if id (const 1) (const 0)) (.1 | .odd),
})

main = range 0 300 | map (const 20000 | stats | .sum) | sum | echo
