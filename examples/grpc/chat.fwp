# Generated by `fwp proto --import chat.proto`: types, codecs, clients and
# server routes for package chat. Do not edit; see docs/grpc.md.

Join = { user: String }

join.default : Join
join.default = Join { user = "" }

rec join.encode : Join -> Bytes
join.encode = pb.encode [.user | pb.field 1 pb.string]

rec join.decode : Bytes -> Join ! {Error[GrpcError]}
join.decode = pb.decode | make Join { user = pb.get 1 pb.string }

rec join.codec : PbCodec[Join]
join.codec = pb.message join.encode join.decode join.default

Message = { user: String, text: String }

message.default : Message
message.default = Message { user = "", text = "" }

rec message.encode : Message -> Bytes
message.encode =
    pb.encode [.user | pb.field 1 pb.string, .text | pb.field 2 pb.string]

rec message.decode : Bytes -> Message ! {Error[GrpcError]}
message.decode =
    pb.decode
    | make Message { user = pb.get 1 pb.string, text = pb.get 2 pb.string }

rec message.codec : PbCodec[Message]
message.codec = pb.message message.encode message.decode message.default

Posted = ()

posted.default : Posted
posted.default = ()

posted.encode : Posted -> Bytes
posted.encode = const (bytes.from-list [])

posted.decode : Bytes -> Posted ! {Error[GrpcError]}
posted.decode = pb.decode | const ()

posted.codec : PbCodec[Posted]
posted.codec = pb.empty

# ---- descriptors

# the descriptors of the `.proto` files, which the routes carry for server
# reflection (`grpc.serve` answers grpcurl and other clients with them)
proto-files : List[GrpcFile]
proto-files = [
    GrpcFile {
        name = "chat.proto",
        descriptor =
            grpc.base64-bytes
                "CgpjaGF0LnByb3RvEgRjaGF0IhoKBEpvaW4SEgoEdXNlchgBIAEoCVIEdXNlciIxCgdNZXNzYWdlEhIKBHVzZXIYASABKAlSBHVzZXISEgoEdGV4dBgCIAEoCVIEdGV4dCIICgZQb3N0ZWQyVQoEUm9vbRIjCgRQb3N0Eg0uY2hhdC5NZXNzYWdlGgwuY2hhdC5Qb3N0ZWQSKAoJU3Vic2NyaWJlEgouY2hhdC5Kb2luGg0uY2hhdC5NZXNzYWdlMAFiBnByb3RvMw==",
        symbols = ["chat.Join", "chat.Message", "chat.Posted", "chat.Room"],
        imports = [],
    },
]

# ---- service chat.Room

# Post a message to the room.
# rpc Post(Message) returns (Posted): a call to the service at an address
room.post : String -> Message -> Posted ! {Network, Error[GrpcError]}
room.post = grpc.unary message.encode posted.decode "/chat.Room/Post"

# the route serving `Post` with a function
room.post.route : (Message -> Posted ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcRoute
room.post.route =
    grpc.unary-handler message.decode posted.encode
    | grpc.route "/chat.Room/Post"
    | grpc.with-files proto-files

# The messages of the room from now on, starting with a greeting.
# rpc Subscribe(Join) returns (stream Message): a call to the service at an address
room.subscribe : String -> Join -> Channel[Message] -> () ! {Async, Network, Error[GrpcError]}
room.subscribe =
    grpc.server-streaming join.encode message.decode "/chat.Room/Subscribe"

# the route serving `Subscribe` with a function
room.subscribe.route : (Join -> Channel[Message] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcRoute
room.subscribe.route =
    grpc.server-streaming-handler join.decode message.encode
    | grpc.route "/chat.Room/Subscribe"
    | grpc.with-files proto-files

# Messages posted to the room go to everyone subscribed.
# implementations of the methods of chat.Room
RoomServer = {
    post: Message -> Posted ! {Async, IO, Network, FileIO, Error[GrpcError]},
    subscribe: Join -> Channel[Message] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
}

# the routes of chat.Room: `impl | room.routes | grpc.serve address`
room.routes : RoomServer -> List[GrpcRoute]
room.routes =
    fork
        Cons
        (.post | room.post.route)
        (fork Cons (.subscribe | room.subscribe.route) (const Nil))
