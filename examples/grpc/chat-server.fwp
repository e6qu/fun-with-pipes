# A chat room server: the service of chat.proto, implemented with the
# module `fwp proto --import chat.proto -o chat.fwp` generates.
#
#   fwp run chat-server.fwp 127.0.0.1:50051
#
# A hub task keeps the subscribers' channels: it hears of each joining
# subscriber and each posted message on its own channel, and passes each
# message to every subscriber. A subscriber's channel sends to its gRPC
# stream; once the subscriber is gone, sending fails and the hub forgets
# it.

import chat

# what the hub hears of
Event =
    | Event.Join String Channel[chat.Message]
    | Event.Post chat.Message

# send a message to the subscribers that are still there
broadcast : chat.Message -> List[Channel[chat.Message]] -> List[Channel[chat.Message]] ! {Async}
broadcast = curry (fork filter (.0 | flip channel.send) .1)

joined : String -> chat.Message
joined = make chat.Message { user = const "room", text = concat " joined" }

# the subscribers after an event
deliver : Event -> List[Channel[chat.Message]] -> List[Channel[chat.Message]] ! {Async}
deliver = match
    Event.Join _ _ -> curry3 (fork broadcast (.0 | joined) (fork Cons .1 .2))
    Event.Post _ -> broadcast

# one event: the hub's channel and the subscribers
step : (Channel[Event], List[Channel[chat.Message]]) -> Step[(Channel[Event], List[Channel[chat.Message]]), ()] ! {Async}
step = both (.0 | channel.recv) id | match
    (None, _) -> const (Stop ())
    (Some _, _) ->
        curry (make { 0 = .1 | .0, 1 = fork deliver .0 (.1 | .1) } | Again)

# Post: tell the hub
post : Channel[Event] -> chat.Message -> chat.Posted ! {Async}
post = curry (fork channel.send .0 (.1 | Event.Post) | const ())

# Subscribe: give the hub the stream's channel, and keep the stream open
# until the subscriber goes away (which cancels this call)
subscribe : Channel[Event] -> chat.Join -> Channel[chat.Message] -> () ! {Async}
subscribe = curry3 (fork channel.send .0 (fork Event.Join (.1 | .user) .2)
    | const 8760h
    | task.sleep)

main =
    16
    | channel.make
    | tap (make { 0 = id, 1 = const Nil } | iter.later (loop step) | task.spawn)
    | make chat.RoomServer { post = post, subscribe = subscribe }
    | chat.room.routes
    | grpc.serve (args () | head | option.unwrap-or "127.0.0.1:50051")
