# Calls the weather service of weather.fwp. Run on its own, the calls are
# ordinary calls; with `--service weather` they go to a server:
#
#   fwp run forecast-client.fwp
#   fwp serve --grpc weather.fwp --listen 127.0.0.1:50052 &
#   FWP_SERVICE_WEATHER=127.0.0.1:50052 fwp run --service weather forecast-client.fwp

import weather

oslo : weather.Place
oslo = weather.Place { name = "Oslo", lat = 60.0 }

main = [
    "Lisbon" | attempt weather.lookup | echo,
    "Atlantis" | attempt weather.lookup | echo,
    oslo | weather.now | echo,
    oslo | weather.forecast 3 | iter.to-list | map .high | echo,
    16
    | channel.make
    | tap (weather.watch oslo)
    | tap channel.close
    | channel.drain
    | map .celsius
    | echo,
    [oslo, oslo] | map weather.now | iter.from-list | weather.summarize | echo,
] | ignore
