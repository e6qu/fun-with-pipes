# A small JSON API server.
#
#     fwp run examples/server/api.fwp        # interpreted
#     fwp build examples/server/api.fwp && ./api
#
# FWP_ADDR sets the listen address (default 127.0.0.1:8080); the actual
# address is printed on stderr. With FWP_TLS_CERT and FWP_TLS_KEY (PEM
# files) it serves HTTPS. SIGINT/SIGTERM shut down gracefully: requests in
# flight get a few seconds to finish.

# GET /health
health : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
health = const (json.object [("status", Json.Str "ok")]) | json.response

# GET /items/:id
item : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
item =
    http.param "id"
    | option.and-then parse-int
    | or-fail { status = 404, message = "no such item" }
    | item-json
    | json.response

item-json : I64 -> Json
item-json =
    both
        (json.int | curry id "id")
        (format "item {}" | Json.Str | curry id "name")
    | fork Cons .0 (.1 | singleton)
    | json.object

# POST /items {"name": ...} (needs `Authorization: Bearer secret`)
create : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
create =
    auth.bearer "secret"
    | http.json-body
    | json.get "name"
    | option.and-then json.as-string
    | or-fail { status = 422, message = "name is required" }
    | Json.Str
    | curry id "name"
    | singleton
    | Cons ("id", json.int 1)
    | json.object
    | http.json 201

# GET /slow?ms=N
slow : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
slow =
    http.query-param "ms"
    | option.and-then parse-int
    | option.unwrap-or 100
    | tap (duration.from-millis | task.sleep)
    | format "slept {} ms"
    | http.text 200

# GET /stream: five lines, one chunk each
stream : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
stream = const count-to-five | http.stream 200 "text/plain"

count-to-five : Channel[Bytes] -> () ! {Async, IO, Network, FileIO}
count-to-five =
    channel.send
    | compose (format "line {}\n" | string.to-bytes)
    | flip compose ignore
    | flip each (range 1 6)

# GET /metrics (Prometheus text format)
metrics : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
metrics = const () | metrics.render | http.text 200

routes : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
routes = http.router [
    http.route "GET" "/health" health,
    http.route "GET" "/items/:id" item,
    http.route "POST" "/items" create,
    http.route "GET" "/slow" slow,
    http.route "GET" "/stream" stream,
    http.route "GET" "/metrics" metrics,
]

handler : Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
handler = http.count | timeout 5s | routes

config : ServerConfig
config = "unused" | http.config | with { shutdown-grace = 3s }

# the certificate and key of FWP_TLS_CERT and FWP_TLS_KEY
tls-files : () -> Option[TlsServer] ! {IO}
tls-files =
    const ()
    | both (const "FWP_TLS_CERT" | env.get) (const "FWP_TLS_KEY" | env.get)
    | match
        (Some _, Some _) -> curry (uncurry tls.server | Some)
        _ -> const None

# listen, with TLS when there is a certificate and key
listen : String -> Listener ! {IO, Network, Error[IoError]}
listen = fork listen-with (const () | tls-files) id

listen-with : Option[TlsServer] -> String -> Listener ! {IO, Network, Error[IoError]}
listen-with = curry (match
    (None, _) ->
        tcp.listen
        | tap (tcp.local-addr | format "listening on http://{}" | eprint)
    (Some _, _) -> curry (fork apply .1 (.0 | tls.listen)
        | tap (tcp.local-addr | format "listening on https://{}" | eprint)))

main =
    "FWP_ADDR"
    | env.get
    | option.unwrap-or "127.0.0.1:8080"
    | listen
    | flip http.serve-on (config, handler)
    | const "stopped"
    | eprint
