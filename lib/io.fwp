# Console streams, process settings and time.
#
# - Standard input supplies data; `read-line` returns `None` at its end.
# - Standard output carries results: `print "hi"` writes `hi` and a newline;
#   `write` omits the newline.
# - Standard error carries diagnostics; `eprint`/`ewrite` write there.
# - Environment variables are named settings inherited by a process.
# - `Duration` stores an elapsed interval, such as `50ms`, not a calendar date.

foreign "fwp" write : String -> () ! {IO}
foreign "fwp" eprint : String -> () ! {IO}
# Write text on stderr without a newline (prompts, progress).
foreign "fwp" ewrite : String -> () ! {IO}
foreign "fwp" read-line : () -> Option[String] ! {IO}
foreign "fwp" read-all : () -> String ! {IO}
foreign "fwp" read-lines : () -> List[String] ! {IO}
# Look up a name and copy its value. A name containing a zero byte (`\0`)
# is invalid and returns None, like a missing name.
foreign "fwp" env.get : String -> Option[String] ! {IO}
# All environment variables, sorted by name.
foreign "fwp" env.vars : () -> List[(String, String)] ! {IO}
# The absolute current working directory, copied into a string.
# Failure raises an IoError: an error value with kind and message fields.
# Its kind is "cwd"; no substitute path is returned.
# `attempt env.cwd ()` returns `Ok path` or `Err error`, so callers can handle
# an unavailable directory explicitly.
foreign "fwp" env.cwd : () -> String ! {IO, Error[IoError]}
# Elapsed time since process clock initialization; useful for measuring intervals.
# The clock cannot go backward. A Duration stores signed 64-bit nanoseconds
# (one billion per second). An unreadable clock or out-of-range elapsed time traps.
foreign "fwp" time.monotonic : () -> Duration ! {IO}
# Wall-clock nanoseconds since 1970-01-01 UTC, stored in a Duration record.
# Times before 1970 are negative. An unreadable or out-of-range clock traps.
# Clock corrections can change this value; use time.monotonic for elapsed time.
foreign "fwp" time.unix : () -> Duration ! {IO}

# Apply `f` to each line of standard input as it is read, in constant
# memory: `() | each-line (upper | print)`.
each-line : (String -> () ! {IO | e}) -> () -> () ! {IO | e}
each-line = io._line-step | loop

# `s | fold-lines f` folds `f` over the lines of standard input as they
# are read, from the state `s`: `0 | fold-lines (curry (.0 | add 1))`
# counts them.
fold-lines : (s -> String -> s ! {IO | e}) -> s -> s ! {IO | e} where Dup[s]
fold-lines = io._fold-step | loop

io._line-step : (String -> () ! {IO | e}) -> () -> Step[(), ()] ! {IO | e}
io._line-step = option.map | flip compose io._again | compose read-line

io._again : Option[()] -> Step[(), ()]
io._again = match
    Some -> const (Again ())
    None -> Stop ()

io._fold-step : (s -> String -> s ! {IO | e}) -> s -> Step[s, s] ! {IO | e} where Dup[s]
io._fold-step = curry (both id (const () | read-line)
    | if
        (.1 | option.is-none)
        (.0 | .1 | Stop)
        (both (.0 | .0 | uncurry) (both (.0 | .1) (.1 | option.unwrap-or ""))
            | uncurry (flip apply)
            | Again))

# The user's home directory (`HOME`).
env.home : () -> Option[String] ! {IO}
env.home = const "HOME" | env.get

duration.nanos : Duration -> I64
duration.nanos = .nanos

duration.millis : Duration -> I64
duration.millis = .nanos | div 1000000

duration.from-millis : I64 -> Duration
duration.from-millis = mul 1000000 | make Duration { nanos = id }

# Durations add and subtract (checked: overflow traps): `2s | add 500ms`,
# `t1 | sub t0`; `zero` makes `sum` work on lists of durations.
impl Add[Duration] =
    add = curry (make Duration {
        nanos = both (.0 | .nanos) (.1 | .nanos) | uncurry add,
    })

impl Sub[Duration] =
    sub = curry (make Duration {
        nanos = both (.0 | .nanos) (.1 | .nanos) | uncurry sub,
    })

impl Zero[Duration] =
    zero = Duration { nanos = 0 }

test "duration add" = 2s | add 500ms | eq 2500ms
test "duration sub" = 2s | sub 500ms | eq 1500ms
test "duration sum" = [1s, 250ms, 750ms] | sum | eq 2s
test "duration.millis" = 1500ms | duration.millis | eq 1500
test "duration.from-millis" = 2000 | duration.from-millis | eq 2s
