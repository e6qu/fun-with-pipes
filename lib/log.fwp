# Structured logs attach named fields to a message for filtering.
# The logfmt format writes `key=value` fields, one record per line, on standard
# error so normal output stays separate.
#
# Metrics report counts or resource measurements. Process memory includes more
# than stored fwp values; see [measurement terms](terminology.md#tests-and-measurements).

# `log.event level message fields`
log.event : String -> String -> List[(String, String)] -> () ! {IO}
log.event = curry3 (fork
        log._line-of
        (const () | time.unix | duration.millis)
        id
    | eprint)

log._line-of : I64 -> (String, String, List[(String, String)]) -> String
log._line-of = curry (fork
    concat
    log.fields
    (fork
        concat
        (.1 | .1 | log.quote)
        (both .0 (.1 | .0) | format "ts={} level={} msg=")))

log.fields : (I64, (String, String, List[(String, String)])) -> String
log.fields =
    .1 | .2 | map (both .0 (.1 | log.quote) | format " {}={}") | join ""

# a logfmt value: quoted, with backslashes, quotes and line breaks escaped
log.quote : String -> String
log.quote =
    replace "\\" "\\\\"
    | replace "\"" "\\\""
    | replace "\n" "\\n"
    | replace "\r" "\\r"
    | format "\"{}\""

log.info : String -> () ! {IO}
log.info = flip (log.event "info") []

log.warn : String -> () ! {IO}
log.warn = flip (log.event "warn") []

log.error : String -> () ! {IO}
log.error = flip (log.event "error") []

# Metrics store one numeric value per name for the process or library instance.
# `metrics.add "requests" 1.0` creates a counter or adds to an existing value;
# negative amounts subtract too. `metrics.set "load" 0.5` replaces its value and
# marks it as a gauge. An observation updates names ending in `_count` and `_sum`:
# observing 2.0 then 4.0 gives count 2.0 and sum 6.0. Adding or observing an
# existing name preserves its kind. Names are complete strings, including NUL.
# Repeated updates reuse registry entries; distinct names consume more storage.
foreign "fwp" metrics.add : String -> F64 -> () ! {IO}
foreign "fwp" metrics.set : String -> F64 -> () ! {IO}
foreign "fwp" metrics.observe : String -> F64 -> () ! {IO}
# Returns copied (name, kind, value) tuples in string order. A snapshot remains
# unchanged after later updates. Its list and text are freed when no longer used;
# the registry itself lives until the process exits or the library is closed.
foreign "fwp" metrics.snapshot : () -> List[(String, String, F64)] ! {IO}

metrics.inc : String -> () ! {IO}
metrics.inc = flip metrics.add 1.0

# Formats a snapshot as Prometheus text. Choose metric names valid for that
# protocol; this renderer does not validate or escape arbitrary registry names.
metrics.render : () -> String ! {IO}
metrics.render = metrics.snapshot | map metrics._line | join ""

metrics._line : (String, String, F64) -> String
metrics._line =
    if
        (.1 | eq "summary")
        metrics._sample
        (fork concat metrics._sample (both .0 .1 | format "# TYPE {} {}\n"))

metrics._sample : (String, String, F64) -> String
metrics._sample = both .0 .2 | format "{} {}\n"

test "log line" =
    ("info", "started", [("port", "8080")])
    | log._line-of 5
    | eq "ts=5 level=info msg=\"started\" port=\"8080\""
test "log.quote escapes" =
    "a\\b\"c\r\nd" | log.quote | eq "\"a\\\\b\\\"c\\r\\nd\""
test "metrics" =
    [
        metrics.inc "fwp_test_requests",
        metrics.inc "fwp_test_requests",
        metrics.set "fwp_test_load" 0.5,
        metrics.observe "fwp_test_latency" 2.0,
    ]
    | const ()
    | metrics.render
    | eq
        "fwp_test_latency_count 1.0\nfwp_test_latency_sum 2.0\n# TYPE fwp_test_load gauge\nfwp_test_load 0.5\n# TYPE fwp_test_requests counter\nfwp_test_requests 2.0\n"
