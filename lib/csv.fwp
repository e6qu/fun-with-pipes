# CSV is a sequence of rows containing text fields, usually separated by commas.
# A header names columns. A tab separator gives TSV.
#
# - RFC 4180 quoting permits separators/newlines inside double-quoted fields;
#   `""` inside a quoted field means one quote.
# - Separators are explicitly selectable one-byte values; lines end in `\n` or `\r\n`.
# - Reading is lenient: text after a closing quote stays in the field, an unclosed
#   quote extends to the end, and empty lines are skipped.
# - Plain parsing returns strings. Typed reading converts fields to record types
#   and reports conversion failures.

# `"a,b\n1,2\n" | csv.parse` is `[["a", "b"], ["1", "2"]]`.
csv.parse : String -> List[List[String]]
csv.parse = csv.parse-with ","

# `text | csv.parse-with ";"` reads fields separated by the first byte of
# the separator (`"\t"` for tab-separated values).
foreign "fwp" csv.parse-with : String -> String -> List[List[String]]

# Records of a record type from rows whose first row is the header: each
# field comes from the column of its name (a header `First Name` or
# `first_name` is the field `first-name`), parsed as a command-line
# argument (strings as they are, numbers, `true`, constructor names of
# enumerations in any case). An `Option` field is `None` when its cell is
# empty or its column missing. A missing column or a cell that does not
# parse is an `Err` with the row number (the header is row 1).
foreign "fwp" csv.decode : List[List[String]] -> Result[List[t], String] where Decode[t]

# `file.read "people.csv" | csv.parse-records` with a type annotation:
# `csv.parse` then `csv.decode`.
csv.parse-records : String -> Result[List[t], String] where Decode[t]
csv.parse-records = csv.parse | csv.decode

# Rows as CSV text: every line ends with `\n`, and a field is quoted when
# it contains a comma, a quote or a line break.
csv.encode : List[List[String]] -> String
csv.encode = csv.encode-with ","

# `rows | csv.encode-with "\t"`.
csv.encode-with : String -> List[List[String]] -> String
csv.encode-with = curry (fork map (.0 | csv._line) .1 | join "")

# One field, quoted when it needs to be: `"a,b" | csv.field ","` is
# `"\"a,b\""`.
csv.field : String -> String -> String
csv.field = curry (if
    (uncurry csv._needs-quotes)
    (.1 | replace "\"" "\"\"" | flip concat "\"" | concat "\"")
    .1)

csv._needs-quotes : String -> String -> Bool
csv._needs-quotes = curry (fork
    any
    (.1 | flip string.contains)
    (.0 | flip Cons ["\"", "\n", "\r"]))

# One record without its newline: `["a", "b c"] | csv.format-row ";"`.
csv.format-row : String -> List[String] -> String
csv.format-row = curry (if
    (.1 | eq [""])
    (const "\"\"")
    (fork join .0 (fork map (.0 | csv.field) .1)))

csv._line : String -> List[String] -> String
csv._line = then2 csv.format-row (concat "\n")

test "csv.parse" =
    "name,qty\r\n\"Smith, J\",\"say \"\"hi\"\"\"\n\nx,\"a\nb\"\n"
    | csv.parse
    | eq [["name", "qty"], ["Smith, J", "say \"hi\""], ["x", "a\nb"]]
test "csv.parse empty fields" = ",\n\"\"" | csv.parse | eq [["", ""], [""]]
test "csv.parse-with" = "a;b\tc" | csv.parse-with ";" | eq [["a", "b\tc"]]
test "csv.encode" =
    [["a", "b,c"], ["say \"hi\"", "x\ny"]]
    | csv.encode
    | eq "a,\"b,c\"\n\"say \"\"hi\"\"\",\"x\ny\"\n"
test "csv round trip" =
    [["", " a ", "\"", ",;"], [""]] | fork eq id (csv.encode | csv.parse)
