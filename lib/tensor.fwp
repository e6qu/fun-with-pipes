# Lazy tensor expressions. `realize` evaluates supported elementwise operations
# together without full-length intermediate arrays. An arbitrary `tensor.map`
# function is evaluated first on the CPU and becomes an input. Graph passes
# rewrite expressions before evaluation.
#
# Expressions implement the numeric traits (`Ring`, `Field`, `Floating`),
# so generic numeric code builds fused elementwise kernels. They run on a
# `Device`: `Cpu` or `CpuParallel n` (up to n workers). Elementwise results are the
# same on every CPU device and in both backends, bit for bit; reductions
# (`tensor.sum`) add blocks of 4096 elements from the left and then the
# block sums from the left, whatever the number of threads, so they are
# reproducible too. See docs/numerics.md.
#
# A tensor expression is a description of elementwise array arithmetic.
# A leaf supplies an input vector; a kernel executes the combined operations.
# Building the description costs work and storage, even before evaluating elements.
# Cpu uses one thread; CpuParallel accepts worker limits from 1 to 256.
# Availability checks that setting; worker startup can still fail.
# Tutorial 20 explains realization, reduction (combining elements) and gradients.

TensorExpr[N] =
    | TLeaf Vector[F64, N]
    | TFill F64
    | TAdd TensorExpr[N] TensorExpr[N]
    | TMul TensorExpr[N] TensorExpr[N]
    | TScale F64 TensorExpr[N]
    | TMap (F64 -> F64) TensorExpr[N]
    # minuend and subtrahend
    | TSub TensorExpr[N] TensorExpr[N]
    # dividend and divisor
    | TDiv TensorExpr[N] TensorExpr[N]
    | TUnary UnaryOp TensorExpr[N]

# The elementwise functions a kernel computes itself (`tensor.map` takes
# any function, but runs it on the CPU before the kernel).
UnaryOp =
    | OpNeg
    | OpSqrt
    | OpExp
    | OpLn
    | OpSin
    | OpCos
    | OpTan
    | OpAbs

tensor.lazy : Vector[F64, n] -> TensorExpr[n]
tensor.lazy = TLeaf

tensor.fill : F64 -> TensorExpr[n]
tensor.fill = TFill

# data-last builders: `x | tensor.add y`
tensor.add : TensorExpr[n] -> TensorExpr[n] -> TensorExpr[n]
tensor.add = flip TAdd

tensor.mul : TensorExpr[n] -> TensorExpr[n] -> TensorExpr[n]
tensor.mul = flip TMul

tensor.scale : F64 -> TensorExpr[n] -> TensorExpr[n]
tensor.scale = TScale

tensor.map : (F64 -> F64) -> TensorExpr[n] -> TensorExpr[n]
tensor.map = TMap

# `x | tensor.sub y` is x - y
tensor.sub : TensorExpr[n] -> TensorExpr[n] -> TensorExpr[n]
tensor.sub = flip TSub

# `x | tensor.div y` is x / y
tensor.div : TensorExpr[n] -> TensorExpr[n] -> TensorExpr[n]
tensor.div = flip TDiv

tensor.unary : UnaryOp -> TensorExpr[n] -> TensorExpr[n]
tensor.unary = TUnary

tensor.abs : TensorExpr[n] -> TensorExpr[n]
tensor.abs = TUnary OpAbs

# one element of a unary operation
tensor.apply-unary : UnaryOp -> F64 -> F64
tensor.apply-unary = match
    OpNeg -> neg
    OpSqrt -> sqrt
    OpExp -> exp
    OpLn -> ln
    OpSin -> sin
    OpCos -> cos
    OpTan -> tan
    OpAbs -> abs

impl Add[TensorExpr[n]] =
    add = flip TAdd

impl Sub[TensorExpr[n]] =
    sub = flip TSub

impl Mul[TensorExpr[n]] =
    mul = flip TMul

impl Div[TensorExpr[n]] =
    div = flip TDiv

impl Neg[TensorExpr[n]] =
    neg = TUnary OpNeg

impl Zero[TensorExpr[n]] =
    zero = TFill 0.0

impl One[TensorExpr[n]] =
    one = TFill 1.0

impl FromInt[TensorExpr[n]] =
    from-int = int.to-float | TFill

impl FromFloat[TensorExpr[n]] =
    from-float = TFill

impl Ring[TensorExpr[n]] = {}

impl Field[TensorExpr[n]] = {}

impl Floating[TensorExpr[n]] =
    sqrt = TUnary OpSqrt
    exp = TUnary OpExp
    ln = TUnary OpLn
    sin = TUnary OpSin
    cos = TUnary OpCos
    tan = TUnary OpTan

# element i of an expression
rec tensor.at : TensorExpr[n] -> I64 -> F64
tensor.at = match
    TLeaf ->
        curry (both .1 (.0 | .data) | uncurry array.get | option.unwrap-or 0.0)
    TFill -> const
    TAdd -> on (fork add) tensor.at
    TMul -> on (fork mul) tensor.at
    TScale -> mul | flip compose | compose tensor.at
    TMap -> flip (tensor.at | compose)
    TSub -> on (flip (fork sub)) tensor.at
    TDiv -> on (flip (fork div)) tensor.at
    TUnary -> curry (both (.1 | tensor.at) (.0 | tensor.apply-unary)
        | uncurry compose)

# The number of elements, or None for an expression made only of fills
# (a fill takes the length of what it is combined with). Combining two
# operands of different lengths is a trap.
rec tensor.length : TensorExpr[n] -> Option[I64]
tensor.length = match
    TLeaf -> vector.length | Some
    TFill -> const None
    TAdd -> on tensor._same-length tensor.length
    TMul -> on tensor._same-length tensor.length
    TScale -> const tensor.length
    TMap -> const tensor.length
    TSub -> on tensor._same-length tensor.length
    TDiv -> on tensor._same-length tensor.length
    TUnary -> const tensor.length

tensor._same-length : Option[I64] -> Option[I64] -> Option[I64]
tensor._same-length = curry (match
    (None, _) -> id
    (Some _, None) -> Some
    (Some _, Some _) -> curry (if
        (uncurry eq)
        (.0 | Some)
        (format "tensor: operands have different lengths ({} and {})"
            | prim.trap)))

# Evaluate an expression (on the CPU, one thread); a trap when it is made
# only of fills, whose length is unknown.
realize : TensorExpr[n] -> Vector[F64, n]
realize = realize-on Cpu

# element by element, through `tensor.at`
tensor._realize-at : TensorExpr[n] -> Array[F64]
tensor._realize-at = fork array.generate tensor._realized-length tensor.at

tensor._realized-length : TensorExpr[n] -> I64
tensor._realized-length = tensor.length | match
    Some -> id
    None ->
        prim.trap
            "tensor: cannot realize an expression of only fills (its length is unknown)"

rec graph.size : TensorExpr[n] -> I64
graph.size = match
    TLeaf -> const 1
    TFill -> const 1
    TAdd -> on add graph.size | then2 id (add 1)
    TMul -> on add graph.size | then2 id (add 1)
    TScale -> const (graph.size | add 1)
    TMap -> const (graph.size | add 1)
    TSub -> on add graph.size | then2 id (add 1)
    TDiv -> on add graph.size | then2 id (add 1)
    TUnary -> const (graph.size | add 1)

# internal
graph.fold-add : TensorExpr[a] -> TensorExpr[a] -> TensorExpr[a]
graph.fold-add = curry (match
    (TFill _, TFill _) -> then2 add TFill
    _ -> uncurry TAdd)

# internal
graph.fold-mul : TensorExpr[a] -> TensorExpr[a] -> TensorExpr[a]
graph.fold-mul = curry (match
    (TFill _, TFill _) -> then2 mul TFill
    _ -> uncurry TMul)

# internal
graph.fold-scale : F64 -> TensorExpr[a] -> TensorExpr[a]
graph.fold-scale = curry (match
    (_, TFill _) -> then2 mul TFill
    (_, TScale _ _) ->
        curry3 (both (both .0 .1 | uncurry mul) .2 | uncurry TScale)
    _ -> uncurry TScale)

# Constant folding: combine constants and nested scalings.
rec graph.constant-fold : TensorExpr[n] -> TensorExpr[n]
graph.constant-fold = match
    TAdd -> on graph.fold-add graph.constant-fold
    TMul -> on graph.fold-mul graph.constant-fold
    TScale -> graph.fold-scale | compose graph.constant-fold
    TMap -> TMap | compose graph.constant-fold
    TSub -> on TSub graph.constant-fold
    TDiv -> on TDiv graph.constant-fold
    TUnary -> TUnary | compose graph.constant-fold
    _ -> id

# ---------------------------------------------------------------- devices

# CPU execution policy. `CpuParallel n` permits up to n workers, including
# the calling thread; n must be between 1 and 256. Fewer work blocks use
# fewer workers. WebAssembly executes serially. No runtime code compilation.
Device =
    | Cpu
    | CpuParallel I64

# internal
foreign "fwp" device.run : I64 -> I64 -> Array[I64] -> Array[F64] -> List[Array[F64]] -> Array[F64]
# internal
foreign "fwp" device.sum : I64 -> I64 -> Array[I64] -> Array[F64] -> List[Array[F64]] -> F64

# Whether the CPU worker setting is valid for execution.
device.available : Device -> Bool
device.available = match
    Cpu -> True
    CpuParallel _ -> fork and (ge 1) (le 256)

device.name : Device -> String
device.name = match
    Cpu -> "cpu"
    CpuParallel _ -> format "cpu-parallel({})"

device._threads : Device -> I64
device._threads = match
    CpuParallel _ -> id
    Cpu -> 1

# A fused elementwise kernel: postfix code over `length` elements, with
# the constants and the input arrays in the order the code uses them.
Kernel = {
    code: Array[I64],
    consts: Array[F64],
    inputs: List[Array[F64]],
    length: I64,
}

# Opcodes: 0 an input, 1 a constant, 2 +, 3 -, 4 ×, 5 ÷, then the unary
# operations from 6 (OpNeg) to 13 (OpAbs). `tensor.map` subexpressions
# are evaluated first, on the CPU, and become inputs.
rec tensor._code : TensorExpr[n] -> List[I64]
tensor._code = match
    TLeaf -> const [0]
    TFill -> const [1]
    TAdd -> on (tensor._join 2) tensor._code
    TMul -> on (tensor._join 4) tensor._code
    TScale -> const (tensor._code | tensor._join 4 [1])
    TMap -> const (const [0])
    TSub -> on (tensor._join 3) tensor._code
    TDiv -> on (tensor._join 5) tensor._code
    TUnary -> curry (both (.1 | tensor._code) (.0 | tensor._opcode | singleton)
        | uncurry (flip append))

# the code of two operands, then op
tensor._join : I64 -> List[I64] -> List[I64] -> List[I64]
tensor._join =
    curry3 (fork Cons .1 (fork Cons .2 (.0 | singleton | singleton)) | flatten)

tensor._opcode : UnaryOp -> I64
tensor._opcode = match
    OpNeg -> 6
    OpSqrt -> 7
    OpExp -> 8
    OpLn -> 9
    OpSin -> 10
    OpCos -> 11
    OpTan -> 12
    OpAbs -> 13

rec tensor._consts : TensorExpr[n] -> List[F64]
tensor._consts = match
    TLeaf -> const []
    TFill -> singleton
    TAdd -> on (flip append) tensor._consts
    TMul -> on (flip append) tensor._consts
    TScale -> curry (both .0 (.1 | tensor._consts) | uncurry Cons)
    TMap -> const (const [])
    TSub -> on (flip append) tensor._consts
    TDiv -> on (flip append) tensor._consts
    TUnary -> const tensor._consts

rec tensor._inputs : TensorExpr[n] -> List[Array[F64]]
tensor._inputs = match
    TLeaf -> .data | singleton
    TFill -> const []
    TAdd -> on (flip append) tensor._inputs
    TMul -> on (flip append) tensor._inputs
    TScale -> const tensor._inputs
    TMap -> curry (uncurry TMap | tensor._realize-at | singleton)
    TSub -> on (flip append) tensor._inputs
    TDiv -> on (flip append) tensor._inputs
    TUnary -> const tensor._inputs

# The kernel of an expression over n elements.
tensor.kernel-of : I64 -> TensorExpr[n] -> Kernel
tensor.kernel-of = curry (make Kernel {
    code = .1 | tensor._code | array.from-list,
    consts = .1 | tensor._consts | array.from-list,
    inputs = .1 | tensor._inputs,
    length = .0,
})

# The kernel of an expression (a trap when it is made only of fills).
tensor.kernel : TensorExpr[n] -> Kernel
tensor.kernel = fork tensor.kernel-of tensor._realized-length id

# Compute the kernel's array. Invalid CPU worker counts trap before execution.
kernel.run : Device -> Kernel -> Array[F64]
kernel.run = curry (make {
    0 = .0 | device._threads,
    1 = .1 | .length,
    2 = .1 | .code,
    3 = .1 | .consts,
    4 = .1 | .inputs,
} | kernel._apply5 device.run)

kernel._apply5 : (a -> b -> c -> d -> e -> r) -> (a, b, c, d, e) -> r
kernel._apply5 = curry (both
        (both
                (both
                        (both (both .0 (.1 | .0) | uncurry id) (.1 | .1)
                            | uncurry id)
                        (.1 | .2)
                    | uncurry id)
                (.1 | .3)
            | uncurry id)
        (.1 | .4)
    | uncurry id)

# Sum in blocks of 4096 from the left, then add block sums from the left.
# Invalid CPU worker counts trap before execution.
kernel.sum : Device -> Kernel -> F64
kernel.sum = curry (make {
    0 = .0 | device._threads,
    1 = .1 | .length,
    2 = .1 | .code,
    3 = .1 | .consts,
    4 = .1 | .inputs,
} | kernel._apply5 device.sum)

# Evaluate an expression using the explicit CPU execution policy.
realize-on : Device -> TensorExpr[n] -> Vector[F64, n]
realize-on =
    curry (both .0 (.1 | tensor.kernel) | uncurry kernel.run | vector.wrap)

# Sum an expression in the fixed block order described by `kernel.sum`.
tensor.sum-on : Device -> TensorExpr[n] -> F64
tensor.sum-on = curry (both .0 (.1 | tensor.kernel) | uncurry kernel.sum)

tensor.sum : TensorExpr[n] -> F64
tensor.sum = tensor.sum-on Cpu

# ------------------------------------------------------- reverse mode

# The gradient of the sum of an expression's elements with respect to
# each of its leaves (`tensor.lazy` vectors, in order from the left), by
# reverse mode over the expression: the adjoint of each leaf is itself a
# fused expression, run on the device. `tensor.map` cannot be
# differentiated (a trap; `Floating` and the elementwise builders can);
# the derivative of `tensor.abs` at 0 is NaN.
tensor.grad-on : Device -> TensorExpr[n] -> List[Vector[F64, n]]
tensor.grad-on = curry (both
        (both (.1 | tensor._realized-length) .0 | uncurry tensor._adjoint-runner)
        (both .1 (const (TFill 1.0)) | uncurry tensor._adjoints)
    | uncurry map)

tensor.grad : TensorExpr[n] -> List[Vector[F64, n]]
tensor.grad = tensor.grad-on Cpu

tensor._adjoint-runner : I64 -> Device -> TensorExpr[n] -> Vector[F64, n]
tensor._adjoint-runner = curry3 (both .1 (both .0 .2 | uncurry tensor.kernel-of)
    | uncurry kernel.run
    | vector.wrap)

# the adjoints of the leaves of e, given the adjoint g of e
rec tensor._adjoints : TensorExpr[n] -> TensorExpr[n] -> List[TensorExpr[n]]
tensor._adjoints = match
    TLeaf -> const singleton
    TFill -> const (const [])
    TAdd -> curry3 (tensor._two .2 .2)
    TMul -> curry3 (tensor._two (fork TMul .2 .1) (fork TMul .2 .0))
    TScale -> curry3 (both .1 (both .0 .2 | uncurry TScale)
        | uncurry tensor._adjoints)
    TMap -> const (const
        (prim.trap "tensor.grad: tensor.map cannot be differentiated"))
    TSub -> curry3 (tensor._two .2 (.2 | TUnary OpNeg))
    TDiv -> curry3 (tensor._two
        (fork TDiv .2 .1)
        (fork TDiv (fork TMul .2 .0) (.1 | fork TMul id id) | TUnary OpNeg))
    TUnary -> curry3 (both
            .1
            (fork TMul .2 (both .0 .1 | uncurry tensor._derivative))
        | uncurry tensor._adjoints)

# operands a and b, given (a, b, g), get the adjoints `ga` and `gb`
rec tensor._two : ((TensorExpr[n], TensorExpr[n], TensorExpr[n]) -> TensorExpr[n]) -> ((TensorExpr[n], TensorExpr[n], TensorExpr[n]) -> TensorExpr[n]) -> (TensorExpr[n], TensorExpr[n], TensorExpr[n]) -> List[TensorExpr[n]]
tensor._two = curry3 (both
        (both (.2 | .0) (both .0 .2 | uncurry id) | uncurry tensor._adjoints)
        (both (.2 | .1) (both .1 .2 | uncurry id) | uncurry tensor._adjoints)
    | uncurry (flip append))

# the derivative of a unary operation at e
tensor._derivative : UnaryOp -> TensorExpr[n] -> TensorExpr[n]
tensor._derivative = match
    OpNeg -> const (TFill -1.0)
    OpSqrt -> TUnary OpSqrt | TDiv (TFill 0.5)
    OpExp -> TUnary OpExp
    OpLn -> TDiv (TFill 1.0)
    OpSin -> TUnary OpCos
    OpCos -> TUnary OpSin | TUnary OpNeg
    OpTan -> TUnary OpCos | fork TMul id id | TDiv (TFill 1.0)
    OpAbs -> fork TDiv id (TUnary OpAbs)

test "realize" =
    vector [1.0, 2.0]
    | tensor.lazy
    | tensor.add (tensor.fill 10.0)
    | tensor.scale 2.0
    | realize
    | vector.to-list
    | eq [22.0, 24.0]
test "map" =
    vector [1.0, 4.0]
    | tensor.lazy
    | tensor.map sqrt
    | realize
    | vector.to-list
    | eq [1.0, 2.0]
test "fill takes the other operand's length" =
    tensor.fill 1.0
    | tensor.add (vector [1.0, 2.0, 3.0] | tensor.lazy)
    | realize
    | vector.to-list
    | eq [2.0, 3.0, 4.0]
test "tensor.length" =
    vector [1.0, 2.0]
    | tensor.lazy
    | tensor.mul (tensor.fill 2.0)
    | tensor.length
    | eq (Some 2)
test "tensor.length of fills" =
    tensor.fill 2.0
    | tensor.scale 3.0
    | tensor._test-te
    | tensor.length
    | eq None
test "constant folding" =
    vector [1.0]
    | tensor.lazy
    | tensor.mul (tensor.fill 2.0 | tensor.add (tensor.fill 3.0))
    | graph.constant-fold
    | graph.size
    | eq 3
test "nested scale" =
    vector [1.0]
    | tensor.lazy
    | tensor.scale 2.0
    | tensor.scale 3.0
    | graph.constant-fold
    | (match
        TScale -> const
        _ -> const 0.0)
    | eq 6.0

tensor._test-te : TensorExpr[2] -> TensorExpr[2]
tensor._test-te = id
