# Automatic differentiation applies derivative rules during evaluation.
# For `f(x) = x*x + 2` at `x = 3`, the value is `11` and the derivative is `6`.
#
# | Mode | Intermediate information | Example |
# |---|---|---|
# | Forward: `Dual` | Value and derivative travel together | Squaring `(3, 1)` gives `(9, 6)`. |
# | Reverse: `Rev` | A tape records dependencies and local derivatives | Walk backward from the output to accumulate `6` at the input. |
#
# A gradient collects derivatives for all inputs of a scalar result. Nesting,
# such as `Dual[Dual[F64]]`, computes derivatives of derivatives. Generic numeric
# code states the required traits (`Field`, `Floating`, etc.). Both modes add work
# and retain floating-point rounding. See [the tape walkthrough](terminology.md#tape-and-backward-pass)
# and [precision/lifetime rules](numerics.md).

Dual[T] = { re: T, eps: T }

dual : t -> t -> Dual[t]
dual = curry (make Dual { re = .0, eps = .1 })

# a constant (zero derivative) and a variable (unit derivative)
dual.const : t -> Dual[t] where Zero[t]
dual.const = make Dual { re = id, eps = const zero }

dual.var : t -> Dual[t] where One[t]
dual.var = make Dual { re = id, eps = const one }

# Treat a value as a constant: its derivative is dropped.
stop-gradient : Dual[t] -> Dual[t] where Zero[t]
stop-gradient = update { eps = const zero }

# internal
dual.re2 : (Dual[t], Dual[t]) -> (t, t)
dual.re2 = both (.0 | .re) (.1 | .re)
# internal
dual.eps2 : (Dual[t], Dual[t]) -> (t, t)
dual.eps2 = both (.0 | .eps) (.1 | .eps)

impl Add[Dual[t]] where Add[t] =
    add = curry (make Dual {
        re = dual.re2 | uncurry add,
        eps = dual.eps2 | uncurry add,
    })

impl Sub[Dual[t]] where Sub[t] =
    sub = curry (make Dual {
        re = dual.re2 | uncurry sub,
        eps = dual.eps2 | uncurry sub,
    })

# product rule
impl Mul[Dual[t]] where Ring[t], Dup[t] =
    mul = curry (make Dual {
        re = dual.re2 | uncurry mul,
        eps =
            both
                (both (.0 | .re) (.1 | .eps) | uncurry mul)
                (both (.0 | .eps) (.1 | .re) | uncurry mul)
            | uncurry add,
    })

# quotient rule (data-last: `y | div x` is y / x)
impl Div[Dual[t]] where Field[t], Dup[t] =
    div = curry (make Dual {
        re = dual.re2 | uncurry div,
        eps =
            both
                (.0 | .re | fork mul id id)
                (both
                        (both (.1 | .re) (.0 | .eps) | uncurry mul)
                        (both (.1 | .eps) (.0 | .re) | uncurry mul)
                    | uncurry sub)
            | uncurry div,
    })

impl Neg[Dual[t]] where Neg[t] =
    neg = update { re = neg, eps = neg }

impl Zero[Dual[t]] where Zero[t] =
    zero = Dual { re = zero, eps = zero }

impl One[Dual[t]] where Zero[t], One[t] =
    one = Dual { re = one, eps = zero }

impl FromInt[Dual[t]] where FromInt[t], Zero[t] =
    from-int = from-int | dual.const

impl FromFloat[Dual[t]] where FromFloat[t], Zero[t] =
    from-float = from-float | dual.const

impl Ring[Dual[t]] where Ring[t], Dup[t] = {}

impl Field[Dual[t]] where Field[t], Dup[t] = {}

# chain rule: f(a + a'e) = f(a) + f'(a)·a'e
dual.chain : (t -> t) -> (t -> t) -> Dual[t] -> Dual[t] where Mul[t], Dup[t]
dual.chain = curry3 (make Dual {
    re = both .0 (.2 | .re) | uncurry id,
    eps = both (both .1 (.2 | .re) | uncurry id) (.2 | .eps) | uncurry mul,
})

impl Floating[Dual[t]] where Floating[t], Field[t], Neg[t], Dup[t] =
    sqrt = dual.chain sqrt (sqrt | mul (add one one) | flip div one)
    exp = dual.chain exp exp
    ln = dual.chain ln (flip div one)
    sin = dual.chain sin cos
    cos = dual.chain cos (sin | neg)
    tan = dual.chain tan (cos | fork mul id id | flip div one)

# d/dx f at x
derivative : (Dual[t] -> Dual[t]) -> t -> t where One[t]
derivative = flip compose .eps | compose dual.var

# seed input i of a point: x_i gets derivative 1, the others 0
dual.seed-one : I64 -> (I64, t) -> Dual[t] where Zero[t], One[t]
dual.seed-one = curry (make Dual {
    re = .1 | .1,
    eps = both .0 (.1 | .0) | uncurry eq | bool.to-num,
})

dual.seed : I64 -> List[t] -> List[Dual[t]] where Zero[t], One[t], Dup[t]
dual.seed = curry (both (.0 | dual.seed-one) (.1 | enumerate) | uncurry map)

# all partial derivatives of a scalar function at a point
gradient : (List[Dual[t]] -> Dual[t]) -> List[t] -> List[t] where Zero[t], One[t], Dup[t]
gradient = curry (both
        (both (.1 | flip dual.seed) (.0 | flip compose .eps) | uncurry compose)
        (.1 | length | range 0)
    | uncurry map)

# rows are outputs, columns are inputs
jacobian : (List[Dual[t]] -> List[Dual[t]]) -> List[t] -> List[List[t]] where Zero[t], One[t], Dup[t]
jacobian = curry (both
        (both (.1 | flip dual.seed) (.0 | flip compose (map .eps))
            | uncurry compose)
        (.1 | length | range 0)
    | uncurry map
    | list.transpose)

# second derivatives of a scalar function (nested duals)
hessian : (List[Dual[Dual[t]]] -> Dual[Dual[t]]) -> List[t] -> List[List[t]] where Zero[t], One[t], Dup[t]
hessian = gradient | jacobian

test "derivative of x^2" = 3.0 | derivative (fork mul id id) | eq 6.0
test "derivative of sin at 0" = 0.0 | derivative sin | eq 1.0
test "quotient rule" = 2.0 | derivative (fork div id (add 1.0)) | eq -0.25
test "stop-gradient" = 2.0 | derivative (fork mul id stop-gradient) | eq 2.0
test "gradient" =
    [1.0, 2.0]
    | gradient (fork
        mul
        (nth 0 | option.unwrap-or zero)
        (nth 1 | option.unwrap-or zero))
    | eq [2.0, 1.0]

# ------------------------------------------------------------ reverse mode
#
# Reverse-mode automatic differentiation with a tape. `Rev[T]` is a number
# that records each operation on the tape of the `grad` that made it (in
# the runtime, outside the program's values); `grad` then walks the tape
# backwards once, instead of reevaluating once per input direction as the
# forward gradient helper does. Recording and backward propagation add memory
# and arithmetic costs; pass counts do not give a wall-clock ratio. Like `Dual`, it
# implements the numeric traits, so generic numeric code (vectors,
# matrices, `where Field[t], Floating[t]`) differentiates unchanged.
# F16/BF16/F32/F64 adjoints accumulate in F64. F128 keeps F128 weights and
# adjoints. Nested reverse adjoints use typed arithmetic on the enclosing tape.
# A Rev value belongs to its grad:
# using it after that grad returned, or combining unrelated same-level tapes,
# is a trap. Nesting Rev wraps the enclosing value instead of mixing tape IDs.

Rev[T] = { value: T, vertex: I64 }

# The scalar protocol selects its tape representation at specialization time.
# F16/BF16/F32/F64 retain F64 accumulation; F128 uses typed F128 weights.
# Nested Rev scalars evaluate backward arithmetic on the enclosing tape.
trait ReverseScalar[T] : Field[T], Neg[T], Dup[T] =
    rev._seed : List[T] -> (I64, List[Rev[T]])
    rev._push : I64 -> T -> I64 -> T -> I64
    rev._backward : I64 -> List[I64] -> List[T] -> List[T]
    rev._inactive-zero : T -> Bool

foreign "fwp" ad.tape-owned : (t, t -> t -> t, t -> t -> t, t -> Bool) -> List[t] -> I64 where Dup[t]
# Record two parents and their derivative weights: parent-a, weight-a, parent-b,
# weight-b. Parent -1 means inactive. For example, `ad.push-owned node 1.0f128
# -1 0.0f128` records a unit derivative from node, with no second parent.
# Use within ad.scope; weights transfer to the native tape, while separately
# owned caller aliases remain valid. Both inactive parents return -1.
foreign "fwp" ad.push-owned : I64 -> t -> I64 -> t -> I64 where Dup[t]
foreign "fwp" ad.backward-owned : I64 -> List[I64] -> List[t] -> List[t] where Dup[t]

rev._push-float : I64 -> t -> I64 -> t -> I64 where Float[t]
rev._push-float = fn parent-a -> fn weight-a -> fn parent-b -> fn weight-b ->
    ad.push parent-a (float.convert weight-a) parent-b (float.convert weight-b)

rev._seed-owned : List[t] -> (I64, List[Rev[t]]) where ReverseScalar[t]
rev._seed-owned =
    both (ad.tape-owned (zero, add, mul, rev._inactive-zero)) enumerate
    | both .0 (both (.0 | rev._leaf) .1 | uncurry map)

impl ReverseScalar[F16] =
    rev._seed = rev._seed-float
    rev._push = rev._push-float
    rev._backward = rev._backward-float
    rev._inactive-zero = eq zero

impl ReverseScalar[BF16] =
    rev._seed = rev._seed-float
    rev._push = rev._push-float
    rev._backward = rev._backward-float
    rev._inactive-zero = eq zero

impl ReverseScalar[F32] =
    rev._seed = rev._seed-float
    rev._push = rev._push-float
    rev._backward = rev._backward-float
    rev._inactive-zero = eq zero

impl ReverseScalar[F64] =
    rev._seed = rev._seed-float
    rev._push = rev._push-float
    rev._backward = rev._backward-float
    rev._inactive-zero = eq zero

impl ReverseScalar[F128] =
    rev._seed = rev._seed-owned
    rev._push = ad.push-owned
    rev._backward = ad.backward-owned
    rev._inactive-zero = eq zero

impl ReverseScalar[Rev[t]] where ReverseScalar[t] =
    rev._seed = rev._seed-owned
    rev._push = ad.push-owned
    rev._backward = ad.backward-owned
    # A numerical zero can still have a nonzero derivative. Only constants
    # known inactive at every nested level may skip backward propagation.
    rev._inactive-zero = if (.vertex | lt 0) (.value | rev._inactive-zero) (const False)

# internal
foreign "fwp" ad.scope : (a -> b) -> a -> b where Dup[a]
# internal
foreign "fwp" ad.scope2 : (a -> b -> c) -> a -> b -> c where Dup[a], Dup[b]
# internal
foreign "fwp" ad.tape : I64 -> I64
# internal
foreign "fwp" ad.push : I64 -> F64 -> I64 -> F64 -> I64
# internal
foreign "fwp" ad.backward : I64 -> Array[I64] -> Array[F64] -> Array[F64]

# a constant: no gradient flows through it
rev.const : t -> Rev[t]
rev.const = make Rev { value = id, vertex = const -1 }

# An operation of two operands: `g (a, b)` gives the value of `op a b` and
# its partial derivatives with respect to a and b.
rev._op2 : ((t, t) -> (t, t, t)) -> Rev[t] -> Rev[t] -> Rev[t] where ReverseScalar[t], Dup[t]
rev._op2 = fn g -> fn a -> fn b ->
    let (value, weight-a, weight-b) = g (a | .value, b | .value)
    in Rev {
        value,
        vertex = rev._push (a | .vertex) weight-a (b | .vertex) weight-b,
    }

# An operation of one operand: `g a` gives the value and the derivative.
rev._op1 : (t -> (t, t)) -> Rev[t] -> Rev[t] where ReverseScalar[t], Dup[t]
rev._op1 = fn g -> fn a ->
    let (value, weight) = g (a | .value)
    in Rev { value, vertex = rev._push (a | .vertex) weight -1 zero }

impl Add[Rev[t]] where ReverseScalar[t], Ring[t], Dup[t] =
    add = rev._op2 (make { 0 = uncurry add, 1 = const one, 2 = const one })

# `sub a b` is b - a
impl Sub[Rev[t]] where ReverseScalar[t], Ring[t], Neg[t], Dup[t] =
    sub =
        rev._op2 (make { 0 = uncurry sub, 1 = const (neg one), 2 = const one })

impl Mul[Rev[t]] where ReverseScalar[t], Ring[t], Dup[t] =
    mul = rev._op2 (make { 0 = uncurry mul, 1 = .1, 2 = .0 })

# `div a b` is b / a
impl Div[Rev[t]] where ReverseScalar[t], Field[t], Neg[t], Dup[t] =
    div = rev._op2 (make {
        0 = uncurry div,
        1 = fork div .0 (uncurry div) | neg,
        2 = .0 | flip div one,
    })

impl Neg[Rev[t]] where ReverseScalar[t], Ring[t], Neg[t], Dup[t] =
    neg = rev._op1 (make { 0 = neg, 1 = const (neg one) })

impl Zero[Rev[t]] where Zero[t] =
    zero = Rev { value = zero, vertex = -1 }

impl One[Rev[t]] where One[t] =
    one = Rev { value = one, vertex = -1 }

impl FromInt[Rev[t]] where FromInt[t] =
    from-int = from-int | rev.const

impl FromFloat[Rev[t]] where FromFloat[t] =
    from-float = from-float | rev.const

impl Ring[Rev[t]] where ReverseScalar[t], Ring[t], Neg[t], Dup[t] = {}

impl Field[Rev[t]] where ReverseScalar[t], Field[t], Neg[t], Dup[t] = {}

impl Floating[Rev[t]] where ReverseScalar[t], Floating[t], Field[t], Neg[t], Dup[t] =
    sqrt =
        rev._op1 (make { 0 = sqrt, 1 = sqrt | fork add id id | flip div one })
    exp = rev._op1 (make { 0 = exp, 1 = exp })
    ln = rev._op1 (make { 0 = ln, 1 = flip div one })
    sin = rev._op1 (make { 0 = sin, 1 = cos })
    cos = rev._op1 (make { 0 = cos, 1 = sin | neg })
    tan = rev._op1 (make { 0 = tan, 1 = cos | fork mul id id | flip div one })

# input i of a tape
rev._leaf : I64 -> (I64, t) -> Rev[t]
rev._leaf = curry (make Rev {
    value = .1 | .1,
    vertex = both .0 (.1 | .0) | uncurry add,
})

# a new tape and the inputs on it
rev._seed-float : List[t] -> (I64, List[Rev[t]]) where Dup[t]
rev._seed-float =
    both (length | ad.tape) enumerate
    | both .0 (both (.0 | rev._leaf) .1 | uncurry map)

# the adjoints of a tape's inputs, seeding the given vertices (frees the
# tape)
rev._backward-float : I64 -> List[I64] -> List[t] -> List[t] where Float[t]
rev._backward-float = curry3 (make {
    0 = .0,
    1 = .1 | array.from-list,
    2 = .2 | map float.convert | array.from-list,
} | uncurry3 ad.backward | array.to-list | map float.convert)

rev._finish : (I64, Rev[t]) -> (t, List[t]) where ReverseScalar[t], One[t], Dup[t]
rev._finish =
    both
        (.1 | .value)
        (both .0 (.1 | .vertex | singleton)
            | uncurry rev._backward
            | apply [one])

# The value of a scalar function and its gradient at a point, in one
# forward and one backward pass.
value-and-grad : (List[Rev[t]] -> Rev[t]) -> List[t] -> (t, List[t]) where ReverseScalar[t], One[t], Dup[t]
value-and-grad = ad.scope2 rev._value-and-grad

# internal
rev._value-and-grad : (List[Rev[t]] -> Rev[t]) -> List[t] -> (t, List[t]) where ReverseScalar[t], One[t], Dup[t]
rev._value-and-grad = second | compose rev._seed | flip compose rev._finish

# All partial derivatives of a scalar function at a point (reverse mode;
# the same numbers as `gradient`, for any number of inputs at the cost of
# about one evaluation).
grad : (List[Rev[t]] -> Rev[t]) -> List[t] -> List[t] where ReverseScalar[t], One[t], Dup[t]
grad = ad.scope2 rev._grad

# internal
rev._grad : (List[Rev[t]] -> Rev[t]) -> List[t] -> List[t] where ReverseScalar[t], One[t], Dup[t]
rev._grad = rev._value-and-grad | flip compose .1

# `grad` of a function of a vector
grad-vector : (Vector[Rev[t], n] -> Rev[t]) -> Vector[t, n] -> Vector[t, n] where ReverseScalar[t], One[t], Dup[t]
grad-vector =
    compose (array.from-list | vector.wrap)
    | grad
    | compose vector.to-list
    | flip compose (array.from-list | vector.wrap)

rev._vjp-finish : List[t] -> (I64, List[Rev[t]]) -> List[t] where ReverseScalar[t], Dup[t]
rev._vjp-finish = curry (make { 0 = .1 | .0, 1 = .1 | .1 | map .vertex, 2 = .0 }
    | uncurry3 rev._backward)

# Vector-Jacobian product: `xs | vjp f v` is vᵀ·J where J is the Jacobian
# of f at xs (one backward pass, whatever the number of outputs).
vjp : (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> List[t] -> List[t] where ReverseScalar[t], Dup[t]
vjp = curry3 (ad.scope (uncurry3 rev._vjp))

# internal
rev._vjp : (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> List[t] -> List[t] where ReverseScalar[t], Dup[t]
rev._vjp = curry (both (.0 | second | compose rev._seed) (.1 | rev._vjp-finish)
    | uncurry compose)

# The Jacobian in reverse mode, one backward pass per output (rows are
# outputs, columns are inputs, as for `jacobian`). It first evaluates f once
# to count its outputs, then once per row. Each evaluation has its own tape scope.
rev.jacobian : (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> List[List[t]] where ReverseScalar[t], Zero[t], One[t], Dup[t]
rev.jacobian = curry (make { 0 = uncurry rev._outputs, 1 = .0, 2 = .1 }
    | both rev._row (.0 | range 0)
    | uncurry map)

# the number of outputs of f at xs
rev._outputs : (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> I64
rev._outputs =
    ad.scope2 (curry (both .0 (.1 | map rev.const) | uncurry id | length))

# row i of the Jacobian, of (number of outputs, f, xs)
rev._row : (I64, List[Rev[t]] -> List[Rev[t]], List[t]) -> I64 -> List[t] where ReverseScalar[t], Zero[t], One[t], Dup[t]
rev._row = curry (make {
    0 = .0 | .1,
    1 = both .1 (.0 | .0) | uncurry rev._basis,
    2 = .0 | .2,
} | uncurry3 vjp)

# unit vector i of length m
rev._basis : I64 -> I64 -> List[t] where Zero[t], One[t]
rev._basis = curry (both (.0 | eq | flip compose bool.to-num) (.1 | range 0)
    | uncurry map)

# Checkpointed vector-Jacobian products for repeated pure steps. A checkpoint
# stores ordinary values, not a live tape. Backward replays each segment once.
# `steps` must be nonnegative and `every` positive; neither has an implicit
# default. Each segment accumulates adjoints in F64, then converts its input
# adjoints to t, exactly as an explicit sequence of `vjp` calls would. At a
# nested reverse level those arithmetic operations use the enclosing scalar.
Checkpoint = { steps: I64, every: I64 }

vjp-checkpointed : Checkpoint -> (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> List[t] -> List[t] where ReverseScalar[t], Dup[t]
vjp-checkpointed = curry3 (rev._checkpoint-config | rev._checkpoint-run)

# Validate before evaluating the step, including the zero-step case.
rev._checkpoint-config : (Checkpoint, a, b) -> (Checkpoint, a, b) where Dup[a], Dup[b]
rev._checkpoint-config =
    if
        (.0 | .steps | lt 0)
        (const "autodiff: checkpoint steps must be nonnegative" | prim.trap)
        (if
            (.0 | .every | lt 1)
            (const "autodiff: checkpoint interval must be positive" | prim.trap)
            id)

rev._checkpoint-run : (Checkpoint, List[Rev[t]] -> List[Rev[t]], List[t]) -> List[t] -> List[t] where ReverseScalar[t], Dup[t]
rev._checkpoint-run = curry (if
    (.0 | .0 | .steps | eq 0)
    (both (.1 | length) (.0 | .2) | uncurry rev._checkpoint-length)
    (make {
        0 = .0 | .1 | rev._checkpoint-back,
        1 = .0 | .2,
        2 = make { 0 = .0 | .0, 1 = .0 | .1, 2 = .1 } | rev._checkpoints,
    } | uncurry3 fold))

# Replay exactly n steps in constant stack space, without retaining iterates.
rev._replay : I64 -> (a -> a) -> a -> a where Dup[a]
rev._replay = curry3 (loop
    (if
        (.0 | eq 0)
        (.2 | Stop)
        (make { 0 = .0 | sub 1, 1 = .1, 2 = both .1 .2 | uncurry id } | Again)))

rev._checkpoint-values : I64 -> (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> List[t] where ReverseScalar[t], Dup[t]
rev._checkpoint-values = curry3 (ad.scope
    (make { 0 = .0, 1 = .1, 2 = .2 | rev._seed | .1 }
        | uncurry3 rev._replay
        | map .value))

# Newest checkpoint first, ready for the backward fold. The forward scope
# retires even a tape whose outputs are constants or whose callback traps.
rev._checkpoints : (Checkpoint, List[Rev[t]] -> List[Rev[t]], List[t]) -> List[(I64, List[t])] where ReverseScalar[t], Dup[t]
rev._checkpoints = make {
    0 = .0 | .steps,
    1 = .0 | .every,
    2 = .1,
    3 = .2,
    4 = const [],
} | loop rev._checkpoint-step

rev._checkpoint-step : (I64, I64, List[Rev[t]] -> List[Rev[t]], List[t], List[(I64, List[t])]) -> Step[(I64, I64, List[Rev[t]] -> List[Rev[t]], List[t], List[(I64, List[t])]), List[(I64, List[t])]] where ReverseScalar[t], Dup[t]
rev._checkpoint-step =
    if
        (.0 | eq 0)
        (.4 | Stop)
        (both id (fork min .0 .1)
            | make {
                0 = fork sub .1 (.0 | .0),
                1 = .0 | .1,
                2 = .0 | .2,
                3 =
                    make { 0 = .1, 1 = .0 | .2, 2 = .0 | .3 }
                    | uncurry3 rev._checkpoint-values,
                4 = both (both .1 (.0 | .3)) (.0 | .4) | uncurry Cons,
            }
            | Again)

rev._checkpoint-length : I64 -> List[a] -> List[a] where Dup[a]
rev._checkpoint-length = curry (if
    (fork eq .0 (.1 | length))
    .1
    (const "autodiff: checkpoint seed count differs from output count"
        | prim.trap))

rev._checkpoint-back : (List[Rev[t]] -> List[Rev[t]]) -> List[t] -> (I64, List[t]) -> List[t] where ReverseScalar[t], Dup[t]
rev._checkpoint-back = curry3 (make {
    0 =
        both
            (both (.2 | .0) .0 | uncurry rev._replay)
            (.1 | length | rev._checkpoint-length)
        | uncurry compose,
    1 = .1,
    2 = .2 | .1,
} | uncurry3 vjp)

test "grad" =
    [1.0, 2.0]
    | grad (fork
        mul
        (nth 0 | option.unwrap-or zero)
        (nth 1 | option.unwrap-or zero))
    | eq [2.0, 1.0]
test "grad of sin, sqrt and division" =
    [0.0, 4.0]
    | grad (fork
        div
        (nth 1 | option.unwrap-or one | sqrt)
        (nth 0 | option.unwrap-or zero | sin | add 1.0))
    | eq [0.5, -0.0625]
test "value-and-grad" =
    [3.0]
    | value-and-grad (head | option.unwrap-or zero | fork mul id id)
    | eq (9.0, [6.0])
test "vjp" =
    [1.0, 2.0]
    | vjp
        (fork Cons (map (mul 3.0) | sum) (map exp | sum | ln | singleton))
        [1.0, 0.0]
    | eq [3.0, 3.0]
