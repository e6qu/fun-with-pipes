# A task is a scheduled computation, not necessarily a parallel OS thread.
# Tasks form a tree: a parent finishes after its children; cancellation reaches
# its subtree. A channel is a bounded queue of values.
#
# - Sending to a full channel waits; closing preserves messages, then receive gives `None`.
# - Await waits for completion; a deadline requests cancellation after a time limit.
# - Cancellation unwinds at cooperation points such as waits and generated-code
#   scheduling checks. `attempt` does not catch it.
# - Native tasks use lightweight stacks on an event loop. Interpreter tasks use
#   host threads with one executing language code at a time.
# - WebAssembly suspension needs the supported JSPI or Asyncify host/build path.
#
# [Lesson 6](tutorials/06-tasks-and-channels/README.md) follows a producer and consumer.

Task[a] = builtin
Channel[a] = builtin
# A non-owning reference to a channel. It keeps only expiration metadata alive.
WeakChannel[a] = builtin

# start a task; it may perform IO but must handle its own errors
foreign "fwp" task.spawn : (() -> a ! {Async, IO, Network, FileIO}) -> Task[a] ! {Async}
# wait for a task and its children; `None` if it produced no result
# cancelling a task does not erase a result it already produced
foreign "fwp" task.await : Task[a] -> Option[a] ! {Async}
# request cancellation of a task and its children; await to confirm completion
foreign "fwp" task.cancel : Task[a] -> () ! {Async}
# run a task with a deadline and wait for it
foreign "fwp" task.within : Duration -> (() -> a ! {Async, IO, Network, FileIO}) -> Option[a] ! {Async}
foreign "fwp" task.sleep : Duration -> () ! {Async}
foreign "fwp" task.yield : () -> () ! {Async}
# set (or tighten) the current task's deadline, passing a value through
foreign "fwp" task.deadline : Duration -> a -> a ! {Async}
foreign "fwp" task.cancelled : () -> Bool ! {Async}
# run a function and wait for every task it started; when it fails, those
# tasks are cancelled
foreign "fwp" task.scope : (() -> a ! {Async | e}) -> a ! {Async | e}

# bounded FIFO channels: `send` waits while the channel is full, which
# propagates backpressure; `recv` gives `None` once closed and drained
foreign "fwp" channel.make : I64 -> Channel[a] ! {Async}
foreign "fwp" channel.send : Channel[a] -> a -> Bool ! {Async}
foreign "fwp" channel.recv : Channel[a] -> Option[a] ! {Async}
foreign "fwp" channel.recv-for : Duration -> Channel[a] -> Option[a] ! {Async}
foreign "fwp" channel.close : Channel[a] -> () ! {Async}

# Observe a channel without keeping its queue or captured values alive.
# Closing a channel does not expire this reference; releasing its last owner does.
foreign "fwp" channel.downgrade : Channel[a] -> WeakChannel[a] ! {Async}
# Acquire an independent owner if the channel is still alive, otherwise None.
# The acquired channel obeys the same owning-cycle checks as any other channel.
foreign "fwp" channel.upgrade : WeakChannel[a] -> Option[Channel[a]] ! {Async}

# every value received from a channel until it is closed and drained
channel.drain : Channel[a] -> List[a] ! {Async}
channel.drain =
    make { 0 = id, 1 = const Nil } | loop channel._drain-step | reverse

channel._drain-step : (Channel[a], List[a]) -> Step[(Channel[a], List[a]), List[a]] ! {Async}
channel._drain-step = both (.0 | channel.recv) id | match
    (None, _) -> .1 | Stop
    (Some _, _) ->
        curry (make { 0 = .1 | .0, 1 = fork Cons .0 (.1 | .1) } | Again)

# run tasks for every element and collect their results in order
task.map : (a -> b ! {Async, IO, Network, FileIO}) -> List[a] -> List[Option[b]] ! {Async}
task.map = spawn-with | map | flip compose (map task.await)

spawn-with : (a -> b ! {Async, IO, Network, FileIO}) -> a -> Task[b] ! {Async}
spawn-with = then2 (flip compose | compose const) task.spawn
