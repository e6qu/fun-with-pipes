# fwp standard prelude.
#
# Argument order convention: the "subject" of an operation comes last, so
# that `x | sub 1` means x - 1, `x | div 2` means x / 2 and `x | lt 5`
# means x < 5.

# ---------------------------------------------------------------- primitives
I8 = builtin
I16 = builtin
I32 = builtin
I64 = builtin
I128 = builtin
U8 = builtin
U16 = builtin
U32 = builtin
U64 = builtin
U128 = builtin
ISize = builtin
USize = builtin
F16 = builtin
BF16 = builtin
F32 = builtin
F64 = builtin
F128 = builtin
String = builtin
Bytes = builtin
Trit = builtin
TInt[N] = builtin
Array[T] = builtin
Map[K, V] = builtin
Set[T] = builtin

Duration = { nanos: I64 }

# ------------------------------------------------------------- core data
Bool =
    | False
    | True

Ordering =
    | Less
    | Equal
    | Greater

Option[T] =
    | None
    | Some T

Result[T, E] =
    | Ok T
    | Err E

List[T] =
    | Nil
    | Cons T List[T]

# ------------------------------------------------------------- syntax
#
# Program syntax as ordinary values (homoiconicity). `quote e` is the
# syntax of `e`; `unquote!(s)` inside a quote splices a `Syntax` value.
# Macros are functions from syntax to syntax, run at compile time.

Syntax =
    | SName String
    | SCtor String
    | SInt I64
    | SFloat F64
    | SStr String
    | SSelect List[String]
    | SApply Syntax List[Syntax]
    | SPipe Syntax Syntax
    | SUnit
    | STuple List[Syntax]
    | SList List[Syntax]
    | SRecord List[(String, Syntax)]
    | SMatch List[(SynPat, Syntax)]
    | SComptime Syntax
    # any other construct, as source text
    | SOther String
    # a macro invocation `name!(args)`
    | SMacro String List[Syntax]

SynPat =
    | PHole
    | PInt I64
    | PStr String
    | PCtor String List[SynPat]
    | PBare String
    | PTuple List[SynPat]
    | PUnit

foreign "fwp" syntax.show : Syntax -> String

# `assert!(cond)` fails with the source text of `cond` when it is False.
assert-template = quote (unquote!(0) | match
    True -> ()
    False -> fail unquote!(1))

macro assert = fork assert-template id (syntax.show | flip concat "assertion failed: " | SStr)

# `dbg!(e)` prints `<source of e> = <value>` to stderr and returns the value.
dbg-template = quote (unquote!(0) | tap (show | flip concat unquote!(1) | eprint))

macro dbg = fork dbg-template id (syntax.show | concat " = " | SStr)

# ------------------------------------------------------------- reflection
#
# `type[T]` describes a type at compile time (and is a constant at run
# time): its name, type arguments and structure.

TypeInfo = { name: String, args: List[String], shape: TypeShape }

TypeShape =
    | ShapePrim
    | ShapeFunction
    | ShapeTuple List[String]
    | ShapeRecord List[FieldInfo]
    | ShapeVariants List[VariantInfo]

FieldInfo = { name: String, ty: String }

VariantInfo = { name: String, fields: List[String] }

# ------------------------------------------------------------- combinators
foreign "fwp" id : a -> a
foreign "fwp" const : a -> b -> a
foreign "fwp" flip : (a -> b -> c ! e) -> b -> a -> c ! e
foreign "fwp" compose : (a -> b ! e) -> (b -> c ! e) -> a -> c ! e
foreign "fwp" apply : a -> (a -> b ! e) -> b ! e
foreign "fwp" fork : (b -> c -> d ! e) -> (a -> b ! e) -> (a -> c ! e) -> a -> d ! e where Dup[a]
foreign "fwp" both : (a -> b ! e) -> (a -> c ! e) -> a -> (b, c) ! e where Dup[a]
foreign "fwp" dup : a -> (a, a) where Dup[a]
foreign "fwp" on : (b -> b -> c ! e) -> (a -> b ! e) -> a -> a -> c ! e
foreign "fwp" uncurry : (a -> b -> c ! e) -> (a, b) -> c ! e
foreign "fwp" curry : ((a, b) -> c ! e) -> a -> b -> c ! e
foreign "fwp" swap : (a, b) -> (b, a)
foreign "fwp" first : (a -> c ! e) -> (a, b) -> (c, b) ! e
foreign "fwp" second : (b -> c ! e) -> (a, b) -> (a, c) ! e
foreign "fwp" if : (a -> Bool ! e) -> (a -> b ! e) -> (a -> b ! e) -> a -> b ! e where Dup[a]
foreign "fwp" then2 : (a -> b -> c ! e) -> (c -> d ! e) -> a -> b -> d ! e
foreign "fwp" curry3 : ((a, b, c) -> d ! e) -> a -> b -> c -> d ! e
foreign "fwp" uncurry3 : (a -> b -> c -> d ! e) -> (a, b, c) -> d ! e
foreign "fwp" tap : (a -> b ! e) -> a -> a ! e where Dup[a]

# ------------------------------------------------------------- numeric traits
trait Add[T] =
    add : T -> T -> T

trait Sub[T] =
    sub : T -> T -> T

trait Mul[T] =
    mul : T -> T -> T

trait Div[T] =
    div : T -> T -> T

trait Rem[T] =
    rem : T -> T -> T

trait Neg[T] =
    neg : T -> T

trait Zero[T] =
    zero : T

trait One[T] =
    one : T

trait FromInt[T] =
    from-int : I64 -> T

trait FromFloat[T] =
    from-float : F64 -> T

trait Ring[T] : Add[T], Sub[T], Mul[T], Zero[T], One[T] = {}

trait Field[T] : Ring[T], Div[T] = {}

# Primitive implementations; the impls themselves are generated for every
# numeric primitive type.
foreign "fwp" prim.add : a -> a -> a
foreign "fwp" prim.sub : a -> a -> a
foreign "fwp" prim.mul : a -> a -> a
foreign "fwp" prim.div : a -> a -> a
foreign "fwp" prim.rem : a -> a -> a
foreign "fwp" prim.neg : a -> a
foreign "fwp" prim.zero : a
foreign "fwp" prim.one : a
foreign "fwp" prim.from-int : I64 -> a
foreign "fwp" prim.from-float : F64 -> a

# Explicit overflow behaviour (default arithmetic is checked and traps).
foreign "fwp" wrapping.add : a -> a -> a where Integer[a]
foreign "fwp" wrapping.sub : a -> a -> a where Integer[a]
foreign "fwp" wrapping.mul : a -> a -> a where Integer[a]
foreign "fwp" saturating.add : a -> a -> a where Integer[a]
foreign "fwp" saturating.sub : a -> a -> a where Integer[a]
foreign "fwp" saturating.mul : a -> a -> a where Integer[a]
foreign "fwp" overflowing.add : a -> a -> (a, Bool) where Integer[a]
foreign "fwp" overflowing.sub : a -> a -> (a, Bool) where Integer[a]
foreign "fwp" overflowing.mul : a -> a -> (a, Bool) where Integer[a]
foreign "fwp" checked.add : a -> a -> Option[a] where Integer[a]
foreign "fwp" checked.sub : a -> a -> Option[a] where Integer[a]
foreign "fwp" checked.mul : a -> a -> Option[a] where Integer[a]
foreign "fwp" checked.div : a -> a -> Option[a] where Integer[a]

# Bit operations.
foreign "fwp" bit.and : a -> a -> a where Integer[a]
foreign "fwp" bit.or : a -> a -> a where Integer[a]
foreign "fwp" bit.xor : a -> a -> a where Integer[a]
foreign "fwp" bit.not : a -> a where Integer[a]
foreign "fwp" bit.shl : U32 -> a -> a where Integer[a]
foreign "fwp" bit.shr : U32 -> a -> a where Integer[a]

# Explicit conversions (there are no implicit ones).
foreign "fwp" int.convert : a -> Option[b] where Integer[a], Integer[b]
foreign "fwp" int.to-float : a -> b where Integer[a], Float[b]
foreign "fwp" float.to-int : a -> Option[b] where Float[a], Integer[b]
foreign "fwp" float.convert : a -> b where Float[a], Float[b]

# Floating point. The elementary functions are methods of `Floating`, so
# generic numeric code also works for dual and complex numbers.
trait Floating[T] =
    sqrt : T -> T
    exp : T -> T
    ln : T -> T
    sin : T -> T
    cos : T -> T
    tan : T -> T

foreign "fwp" prim.sqrt : a -> a where Float[a] = "sqrt"
foreign "fwp" prim.exp : a -> a where Float[a] = "exp"
foreign "fwp" prim.ln : a -> a where Float[a] = "ln"
foreign "fwp" prim.sin : a -> a where Float[a] = "sin"
foreign "fwp" prim.cos : a -> a where Float[a] = "cos"
foreign "fwp" prim.tan : a -> a where Float[a] = "tan"

impl Floating[F64] =
    sqrt = prim.sqrt
    exp = prim.exp
    ln = prim.ln
    sin = prim.sin
    cos = prim.cos
    tan = prim.tan

impl Floating[F32] =
    sqrt = prim.sqrt
    exp = prim.exp
    ln = prim.ln
    sin = prim.sin
    cos = prim.cos
    tan = prim.tan

foreign "fwp" pow : a -> a -> a where Float[a]
foreign "fwp" floor : a -> a where Float[a]
foreign "fwp" ceil : a -> a where Float[a]
foreign "fwp" round : a -> a where Float[a]
foreign "fwp" abs : a -> a where Signed[a]

# ------------------------------------------------------------- comparison
foreign "fwp" eq : a -> a -> Bool where Eq[a]
foreign "fwp" ne : a -> a -> Bool where Eq[a]
foreign "fwp" lt : a -> a -> Bool where Ord[a]
foreign "fwp" le : a -> a -> Bool where Ord[a]
foreign "fwp" gt : a -> a -> Bool where Ord[a]
foreign "fwp" ge : a -> a -> Bool where Ord[a]
foreign "fwp" compare : a -> a -> Ordering where Ord[a]
foreign "fwp" min : a -> a -> a where Ord[a]
foreign "fwp" max : a -> a -> a where Ord[a]
foreign "fwp" hash : a -> U64 where Hash[a]
foreign "fwp" not : Bool -> Bool
foreign "fwp" and : Bool -> Bool -> Bool
foreign "fwp" or : Bool -> Bool -> Bool

# ------------------------------------------------------------- functor & monad
trait Functor[F] =
    fmap : (a -> b ! e) -> F[a] -> F[b] ! e

trait Applicative[F] : Functor[F] =
    pure : a -> F[a]
    ap : F[a -> b] -> F[a] -> F[b]

trait Monad[M] : Applicative[M] =
    bind : (a -> M[b] ! e) -> M[a] -> M[b] ! e

foreign "fwp" list.flat-map : (a -> List[b] ! e) -> List[a] -> List[b] ! e
foreign "fwp" list.ap : List[a -> b] -> List[a] -> List[b]

impl Functor[List] =
    fmap = map

impl Applicative[List] =
    pure = flip Cons Nil
    ap = list.ap

impl Monad[List] =
    bind = list.flat-map

impl Functor[Option] =
    fmap = option.map

impl Applicative[Option] =
    pure = Some
    ap = option.ap

impl Monad[Option] =
    bind = option.and-then

# ------------------------------------------------------------- effects
#
# Effects run in direct style; sequencing in a pipeline is monadic bind.
# `Error[x]` aborts to the nearest `attempt`, which turns it back into a
# `Result`. `try` goes the other way.

foreign "fwp" fail : x -> a ! {Error[x]}
foreign "fwp" attempt : (a -> b ! {Error[x] | e}) -> a -> Result[b, x] ! e

try : Result[a, x] -> a ! {Error[x]}
try = match
    Ok -> id
    Err -> fail

or-fail : x -> Option[a] -> a ! {Error[x]}
or-fail = curry (match
    (_, Some _) -> const id
    (_, None) -> fail)

foreign "fwp" get : () -> s ! {State[s]}
foreign "fwp" put : s -> () ! {State[s]}
foreign "fwp" modify : (s -> s) -> () ! {State[s]}
foreign "fwp" run-state : s -> (a -> b ! {State[s] | e}) -> a -> (b, s) ! e

foreign "fwp" random.u64 : () -> U64 ! {Random}
foreign "fwp" random.f64 : () -> F64 ! {Random}

# ------------------------------------------------------------- resources
#
# Resources are affine: they cannot be duplicated (no `Dup`) or captured by
# a partial application. Operations thread the resource through and return
# it; scoped helpers guarantee cleanup.

resource File = builtin

IoError = { kind: String, message: String }

foreign "fwp" file.open : String -> File ! {FileIO, Error[IoError]}
foreign "fwp" file.create : String -> File ! {FileIO, Error[IoError]}
foreign "fwp" file.close : File -> () ! {FileIO}
foreign "fwp" file.read-all : File -> (String, File) ! {FileIO, Error[IoError]}
foreign "fwp" file.write : String -> File -> File ! {FileIO, Error[IoError]}
foreign "fwp" file.with : String -> (File -> (a, File) ! {FileIO, Error[IoError] | e}) -> a ! {FileIO, Error[IoError] | e}
foreign "fwp" file.read : String -> String ! {FileIO, Error[IoError]}
foreign "fwp" file.write-new : String -> String -> () ! {FileIO, Error[IoError]}

# ------------------------------------------------------------- basic io
foreign "fwp" print : String -> () ! {IO}
foreign "fwp" show : a -> String where Display[a]
foreign "fwp" args : () -> List[String] ! {IO}
foreign "fwp" exit : I32 -> a ! {IO}

# Print any displayable value on its own line: `x | echo`.
echo : a -> () ! {IO} where Display[a]
echo = show | print

# Discard a value. Effects in a list or tuple happen left to right, so
# `[print "a", print "b"] | ignore` sequences them.
ignore : a -> ()
ignore = const ()
