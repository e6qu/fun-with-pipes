# A process is a running external program. Commands are lists: executable, then
# arguments. `PATH` names the directories searched for that executable.
#
# - Arguments pass directly: `*` stays literal; no shell expansion or redirection runs.
# - Exit status `0` means success; output and error streams are separate strings.
# - A missing executable raises `IoError` with kind `"spawn"`.
# - A zero byte (`\0`) in any argument is rejected with kind `"spawn"` before starting.
#
# Use a shell explicitly when its parsing is intended.

# What a finished program wrote, and its exit status (128 plus the signal
# number when a POSIX signal ended it). POSIX children start with ordinary
# SIGPIPE handling, even though the parent handles its own broken pipes.
ProcessOutput = { status: I32, stdout: String, stderr: String }

# `["git", "status", "--short"] | process.run` runs a program with empty
# input and collects its output.
process.run : List[String] -> ProcessOutput ! {Process, Error[IoError]}
process.run = process.run-input ""

# `cmd | process.run-input text` gives the program `text` as its standard
# input.
foreign "fwp" process.run-input : String -> List[String] -> ProcessOutput ! {Process, Error[IoError]}

# Run a program on the program's own standard input, output and error;
# its exit status.
foreign "fwp" process.call : List[String] -> I32 ! {Process, Error[IoError]}

# The standard output of a program that must succeed; otherwise an
# `IoError` with its standard error (`kind = "status"`).
process.output : List[String] -> String ! {Process, Error[IoError]}
process.output =
    process.run
    | if
        (.status | eq 0)
        .stdout
        (make IoError { kind = const "status", message = .stderr | trim } | fail)
