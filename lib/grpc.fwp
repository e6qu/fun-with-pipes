# gRPC: calling and serving gRPC services (docs/grpc.md).
#
# Exported functions become gRPC services with `fwp build --grpc` (or
# `--service` for a module of a larger program), with no code: their
# messages come from their types. This module is for what remains: the
# metadata and deadlines of calls, statuses (`GrpcError`), and the calls
# and handlers that code generated from a `.proto` file (`fwp proto
# --import`) is made of. Calls and servers run on the task scheduler: a
# call waits only in its own task, and a server runs calls concurrently.

# a failed call: a status code (`grpc.not-found`, ...) and a message. A
# served function that fails with `Error[GrpcError]` answers with that
# status; calls fail with it.
GrpcError = { code: I64, message: String }

# one side of a call: the client's, or the server's
GrpcStream = builtin

# a method served by `grpc.serve`: its path (`/package.Service/Method`),
# the function that handles a call, and the descriptors of the `.proto`
# files it comes from (for server reflection; routes that `fwp proto
# --import` generates carry them)
GrpcRoute = {
    handler: GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]},
    path: String,
    reflection: List[GrpcFile],
}

# A `.proto` file for server reflection: its name
# (`google/protobuf/timestamp.proto`), its serialized `FileDescriptorProto`,
# the full names of the messages, enums and services it defines, and the
# files it imports, directly or not.
GrpcFile = {
    name: String,
    descriptor: Bytes,
    symbols: List[String],
    imports: List[String],
}

# ----------------------------------------------------------- status codes

# the status codes
grpc.ok : I64
grpc.ok = 0

grpc.cancelled : I64
grpc.cancelled = 1

grpc.unknown : I64
grpc.unknown = 2

grpc.invalid-argument : I64
grpc.invalid-argument = 3

grpc.deadline-exceeded : I64
grpc.deadline-exceeded = 4

grpc.not-found : I64
grpc.not-found = 5

grpc.already-exists : I64
grpc.already-exists = 6

grpc.permission-denied : I64
grpc.permission-denied = 7

grpc.resource-exhausted : I64
grpc.resource-exhausted = 8

grpc.failed-precondition : I64
grpc.failed-precondition = 9

grpc.aborted : I64
grpc.aborted = 10

grpc.out-of-range : I64
grpc.out-of-range = 11

grpc.unimplemented : I64
grpc.unimplemented = 12

grpc.internal : I64
grpc.internal = 13

grpc.unavailable : I64
grpc.unavailable = 14

grpc.data-loss : I64
grpc.data-loss = 15

grpc.unauthenticated : I64
grpc.unauthenticated = 16

# the name of a status code: `grpc.code-name 5` is "NOT_FOUND"
grpc.code-name : I64 -> String
grpc.code-name =
    flip nth [
        "OK",
        "CANCELLED",
        "UNKNOWN",
        "INVALID_ARGUMENT",
        "DEADLINE_EXCEEDED",
        "NOT_FOUND",
        "ALREADY_EXISTS",
        "PERMISSION_DENIED",
        "RESOURCE_EXHAUSTED",
        "FAILED_PRECONDITION",
        "ABORTED",
        "OUT_OF_RANGE",
        "UNIMPLEMENTED",
        "INTERNAL",
        "UNAVAILABLE",
        "DATA_LOSS",
        "UNAUTHENTICATED",
    ]
    | option.unwrap-or "UNKNOWN"

# fail with a status: `grpc.fail grpc.not-found "no such book"`
grpc.fail : I64 -> String -> a ! {Error[GrpcError]}
grpc.fail = curry (make GrpcError { code = .0, message = .1 } | fail)

# ------------------------------------------------- metadata and deadlines

# the metadata (request headers, with lower-case names) of the call the
# current task serves; empty outside a call
foreign "fwp" grpc.metadata : () -> List[(String, String)] ! {Network}

# one metadata value of the call being served
grpc.header : String -> Option[String] ! {Network}
grpc.header = fork json.lookup id (const () | grpc.metadata)

# add a header to the response of the call the current task serves: sent
# with its first message (so set it before sending any)
foreign "fwp" grpc.set-header : String -> String -> () ! {Network}

# add a trailer to the response of the call the current task serves: sent
# with its status
foreign "fwp" grpc.set-trailer : String -> String -> () ! {Network}

# run a function whose calls compress their messages with gzip
# (`grpc-encoding: gzip`; servers then compress their responses too).
# Compressed messages are always accepted.
foreign "fwp" grpc.with-gzip : (() -> a ! {Network | e}) -> a ! {Network | e}

# run a function, and collect the response metadata (headers and
# trailers, with lower-case names) of the calls it makes that end
foreign "fwp" grpc.with-response-metadata : (() -> a ! {Network | e}) -> (a, List[(String, String)]) ! {Network | e}

# the response metadata (headers and trailers) a call has received so far
foreign "fwp" grpc.response-metadata : GrpcStream -> List[(String, String)] ! {Network}

# the subject of the client's certificate (`CN=alice,O=Example`) of the
# call the current task serves, when the server requires client
# certificates (mutual TLS); `None` otherwise
foreign "fwp" grpc.peer-subject : () -> Option[String] ! {Network}

# run a function whose calls connect over TLS with these options: a CA
# file, no verification, a server name, a client certificate (ALPN is h2).
# Connections are kept per address and options.
foreign "fwp" grpc.with-tls : TlsOptions -> (() -> a ! {Network | e}) -> a ! {Network | e}

# run a function whose calls send this metadata as well
foreign "fwp" grpc.with-metadata : List[(String, String)] -> (() -> a ! {Network | e}) -> a ! {Network | e}

# run a function whose calls must finish within a duration, or fail with
# `grpc.deadline-exceeded`. (A task's deadline, `task.deadline` or
# `task.within`, also applies to its calls, and cancels the task.)
foreign "fwp" grpc.with-deadline : Duration -> (() -> a ! {Network | e}) -> a ! {Network | e}

# ------------------------------------------------------------------ calls

# `grpc.unary encode decode path address request`: a unary call
foreign "fwp" grpc.unary : (a -> Bytes) -> (Bytes -> b ! {Error[GrpcError]}) -> String -> String -> a -> b ! {Network, Error[GrpcError]}

# a server-streaming call: each response goes to the channel
foreign "fwp" grpc.server-streaming : (a -> Bytes) -> (Bytes -> b ! {Error[GrpcError]}) -> String -> String -> a -> Channel[b] -> () ! {Async, Network, Error[GrpcError]}

# a client-streaming call: the requests are the iterator's elements
foreign "fwp" grpc.client-streaming : (a -> Bytes) -> (Bytes -> b ! {Error[GrpcError]}) -> String -> String -> Iterator[a] -> b ! {Network, Error[GrpcError]}

# a bidirectional call: a task of its own sends the requests while each
# response goes to the channel (the requests may be infinite: the call
# ends when the server ends it)
foreign "fwp" grpc.bidi-streaming : (a -> Bytes) -> (Bytes -> b ! {Error[GrpcError]}) -> String -> String -> Iterator[a] -> Channel[b] -> () ! {Async, Network, Error[GrpcError]}

# Lower level: start a call (`grpc.open address path`), send messages,
# end the requests, and receive messages (`None` at the end). A failed call
# fails with its status.
foreign "fwp" grpc.open : String -> String -> GrpcStream ! {Network, Error[GrpcError]}
foreign "fwp" grpc.send : Bytes -> GrpcStream -> () ! {Network, Error[GrpcError]}
foreign "fwp" grpc.close-send : GrpcStream -> () ! {Network}
foreign "fwp" grpc.recv : GrpcStream -> Option[Bytes] ! {Network, Error[GrpcError]}
foreign "fwp" grpc.cancel : GrpcStream -> () ! {Network}

# ---------------------------------------------------------------- serving

# serve routes on an address ("127.0.0.1:50051"; port 0 picks a free
# port, reported on standard error), with health checking
# (`grpc.health.v1.Health`) and server reflection (`grpc.reflection.v1`
# and `v1alpha`: the services of the routes, and the `.proto` files of
# routes that carry their descriptors), until the task is cancelled
grpc.serve : String -> List[GrpcRoute] -> () ! {Async, IO, Network, FileIO, Error[IoError]}
grpc.serve = curry (fork grpc._serve .0 (.1 | grpc.reflected))

foreign "fwp" grpc._serve : String -> List[GrpcRoute] -> () ! {Async, IO, Network, FileIO, Error[IoError]}
# certificate, key, client CA ("" for none), address, routes
foreign "fwp" grpc._serve-tls : String -> String -> String -> String -> List[GrpcRoute] -> () ! {Async, IO, Network, FileIO, Error[IoError]}

# serve routes like `grpc.serve`, over TLS (offering h2 with ALPN) with a
# certificate chain and private key (`tls.server "cert.pem" "key.pem"`,
# and `tls.with-client-ca "ca.pem"` to require client certificates);
# clients call `tls://host:port`
grpc.serve-tls : TlsServer -> String -> List[GrpcRoute] -> () ! {Async, IO, Network, FileIO, Error[IoError]}
grpc.serve-tls = curry3 (fork
    apply
    (.2 | grpc.reflected)
    (fork apply .1 (.0 | grpc._tls-serve)))

grpc._tls-serve : TlsServer -> String -> List[GrpcRoute] -> () ! {Async, IO, Network, FileIO, Error[IoError]}
grpc._tls-serve =
    fork
        apply
        (.client-ca | option.unwrap-or "")
        (fork apply .key-file (.cert-file | grpc._serve-tls))

# a route from a path and a handler
grpc.route : String -> (GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcRoute
grpc.route =
    curry (make GrpcRoute { path = .0, handler = .1, reflection = const [] })

# Bytes from their base64 text (empty if it is not base64), as generated
# modules write descriptors.
grpc.base64-bytes : String -> Bytes
grpc.base64-bytes =
    json.write | json.read | result.unwrap-or (bytes.from-list [])

# a route with the descriptors of the `.proto` file it comes from and of
# the files that file imports, which `grpc.serve` serves by reflection
grpc.with-files : List[GrpcFile] -> GrpcRoute -> GrpcRoute
grpc.with-files = curry (make GrpcRoute {
    path = .1 | .path,
    handler = .1 | .handler,
    reflection = .0,
})

# handlers of methods from a request decoder, a response encoder and a
# function; a request that cannot be decoded fails with
# `grpc.invalid-argument`
foreign "fwp" grpc.unary-handler : (Bytes -> a ! {Error[GrpcError]}) -> (b -> Bytes) -> (a -> b ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}
foreign "fwp" grpc.server-streaming-handler : (Bytes -> a ! {Error[GrpcError]}) -> (b -> Bytes) -> (a -> Channel[b] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}

grpc.client-streaming-handler : (Bytes -> a ! {Error[GrpcError]}) -> (b -> Bytes) -> (Iterator[a] -> b ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]} where Dup[a]
grpc.client-streaming-handler = grpc._client-streaming-handler grpc._iter

grpc.bidi-streaming-handler : (Bytes -> a ! {Error[GrpcError]}) -> (b -> Bytes) -> (Iterator[a] -> Channel[b] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]} where Dup[a]
grpc.bidi-streaming-handler = grpc._bidi-streaming-handler grpc._iter

foreign "fwp" grpc._client-streaming-handler : (GrpcCell[a] -> Iterator[a]) -> (Bytes -> a ! {Error[GrpcError]}) -> (b -> Bytes) -> (Iterator[a] -> b ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}
foreign "fwp" grpc._bidi-streaming-handler : (GrpcCell[a] -> Iterator[a]) -> (Bytes -> a ! {Error[GrpcError]}) -> (b -> Bytes) -> (Iterator[a] -> Channel[b] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}) -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}

# a received stream as a lazy iterator: forcing a position receives the
# message there, once
# internal
GrpcCell[a] = builtin
foreign "fwp" grpc._force : GrpcCell[a] -> Option[(a, GrpcCell[a])]

rec grpc._iter : GrpcCell[a] -> Iterator[a] where Dup[a]
grpc._iter = grpc._force | match
    None -> Done
    Some _ -> fork Yield .0 (.1 | iter.later grpc._iter)

# ------------------------------------------------------- server reflection

grpc._reflection-v1 : String
grpc._reflection-v1 =
    "/grpc.reflection.v1.ServerReflection/ServerReflectionInfo"

grpc._reflection-v1alpha : String
grpc._reflection-v1alpha =
    "/grpc.reflection.v1alpha.ServerReflection/ServerReflectionInfo"

# The routes with server reflection (`grpc.reflection.v1` and `v1alpha`)
# added, unless they serve it themselves: it lists the services of the
# routes and health checking, and answers with the files that routes
# carry (`grpc.with-files`).
grpc.reflected : List[GrpcRoute] -> List[GrpcRoute]
grpc.reflected =
    if
        (map .path | contains grpc._reflection-v1)
        id
        (fork append id grpc._reflection-routes)

# What server reflection answers with: the services, and the files.
# internal
GrpcReflection = { services: List[String], files: List[GrpcFile] }

# A reflection request: a file by name, the file of a symbol, the
# extension numbers of a type, the services, another request, or none.
# internal
GrpcAsk =
    | GrpcAsk.File String
    | GrpcAsk.Symbol String
    | GrpcAsk.Numbers String
    | GrpcAsk.Services
    | GrpcAsk.Other String
    | GrpcAsk.Bad

grpc._reflection-routes : List[GrpcRoute] -> List[GrpcRoute]
grpc._reflection-routes =
    make GrpcReflection {
        services =
            map (.path | split "/" | nth 1 | option.unwrap-or "")
            | append ["grpc.health.v1.Health"]
            | fold grpc._add-new [],
        files =
            list.flat-map .reflection
            | append [grpc._health-file]
            | fold grpc._add-new [],
    }
    | grpc._reflection-handler
    | fork
        Cons
        (grpc.route grpc._reflection-v1)
        (grpc.route grpc._reflection-v1alpha | singleton)

grpc._add-new : List[a] -> a -> List[a] where Eq[a]
grpc._add-new =
    curry (if (uncurry (flip contains)) .0 (fork append (.1 | singleton) .0))

grpc._reflection-handler : GrpcReflection -> GrpcStream -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}
grpc._reflection-handler =
    grpc._reflect
    | grpc.bidi-streaming-handler (make { 0 = id, 1 = pb.decode }) id

grpc._reflect : GrpcReflection -> Iterator[(Bytes, List[PbField])] -> Channel[Bytes] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}
grpc._reflect = curry3 (fork grpc._reflect-on (make { 0 = .0, 1 = .2 }) .1)

grpc._reflect-on : (GrpcReflection, Channel[Bytes]) -> Iterator[(Bytes, List[PbField])] -> () ! {Async, IO, Network, FileIO, Error[GrpcError]}
grpc._reflect-on = curry (both .0 (.1 | const) | loop grpc._reflect-step)

# one request at a time: the next request is received after the response
# to this one is sent
grpc._reflect-step : ((GrpcReflection, Channel[Bytes]), () -> Iterator[(Bytes, List[PbField])]) -> Step[((GrpcReflection, Channel[Bytes]), () -> Iterator[(Bytes, List[PbField])]), ()] ! {Async, IO, Network, FileIO, Error[GrpcError]}
grpc._reflect-step = fork grpc._reflect-next .0 (.1 | grpc._uncons)

grpc._reflect-next : (GrpcReflection, Channel[Bytes]) -> Option[((Bytes, List[PbField]), () -> Iterator[(Bytes, List[PbField])])] -> Step[((GrpcReflection, Channel[Bytes]), () -> Iterator[(Bytes, List[PbField])]), ()] ! {Async, IO, Network, FileIO, Error[GrpcError]}
grpc._reflect-next = curry (match
    (_, None) -> const (Stop ())
    (_, Some _) -> curry (tap (fork
            channel.send
            (.0 | .1)
            (fork grpc._answer (.0 | .0) (.1 | .0)))
        | both .0 (.1 | .1)
        | Again))

# force an iterator: its first element and the rest, not yet forced
grpc._uncons : (() -> Iterator[a]) -> Option[(a, () -> Iterator[a])]
grpc._uncons = apply () | match
    Done -> None
    Yield _ _ -> curry Some

# the response to a request (its bytes, and its fields)
grpc._answer : GrpcReflection -> (Bytes, List[PbField]) -> Bytes ! {Error[GrpcError]}
grpc._answer = curry (fork
        append
        (fork grpc._reply .0 (.1 | .1 | grpc._ask))
        (.1
            | fork
                append
                (.0 | pb.always 2 pb.bytes)
                (.1 | pb.get 1 pb.string | pb.field 1 pb.string))
    | pb.write)

grpc._ask : List[PbField] -> GrpcAsk
grpc._ask =
    find (fork and (.wire | eq 2) (.num | fork and (ge 3) (le 7)))
    | option.map (both .num (.data | string.from-bytes | option.unwrap-or ""))
    | match
        None -> GrpcAsk.Bad
        Some _ -> grpc._ask-of

grpc._ask-of : (I64, String) -> GrpcAsk
grpc._ask-of = match
    (3, _) -> GrpcAsk.File
    (4, _) -> GrpcAsk.Symbol
    (6, _) -> GrpcAsk.Numbers
    (7, _) -> const GrpcAsk.Services
    _ -> .1 | GrpcAsk.Other

grpc._reply : GrpcReflection -> GrpcAsk -> List[PbField]
grpc._reply = curry (match
    (_, GrpcAsk.File _) -> curry (fork
        apply
        (fork grpc._named-in (.0 | .files) .1)
        (fork grpc._file-answer (.1 | flip concat "unknown file ") .0))
    (_, GrpcAsk.Symbol _) -> curry (fork
        apply
        (fork grpc._defining (.0 | .files) .1)
        (fork grpc._file-answer (.1 | flip concat "unknown symbol ") .0))
    (_, GrpcAsk.Numbers _) ->
        const (pb.always 1 pb.string | pb.write | pb.always 5 pb.bytes)
    (_, GrpcAsk.Services) ->
        .services
        | map (pb.always 1 pb.string | pb.write)
        | pb.repeated 1 pb.bytes
        | pb.write
        | pb.always 6 pb.bytes
    (_, GrpcAsk.Other _) ->
        const (flip concat "no extension " | grpc._reflection-error 5)
    (_, GrpcAsk.Bad) ->
        const (grpc._reflection-error 3 "unsupported reflection request"))

grpc._reflection-error : I64 -> String -> List[PbField]
grpc._reflection-error = curry (fork
        append
        (.1 | pb.field 2 pb.string)
        (.0 | pb.field 1 pb.int64)
    | pb.write
    | pb.always 7 pb.bytes)

grpc._file-answer : String -> GrpcReflection -> Option[GrpcFile] -> List[PbField]
grpc._file-answer = curry3 (match
    (_, _, None) -> grpc._reflection-error 5 | const
    (_, _, Some _) -> const grpc._file-list)

# a file and the files it imports
grpc._file-list : GrpcReflection -> GrpcFile -> List[PbField]
grpc._file-list = curry (fork
        Cons
        .1
        (fork filter-map (.0 | .files | grpc._named-in) (.1 | .imports))
    | map .descriptor
    | pb.repeated 1 pb.bytes
    | pb.write
    | pb.always 4 pb.bytes)

grpc._named-in : List[GrpcFile] -> String -> Option[GrpcFile]
grpc._named-in = curry (fork find (.1 | grpc._has-name) .0)

grpc._has-name : String -> GrpcFile -> Bool
grpc._has-name = curry (fork eq .0 (.1 | .name))

# the file that defines a symbol (a message, an enum, a service, or
# something in one, such as a method)
grpc._defining : List[GrpcFile] -> String -> Option[GrpcFile]
grpc._defining = curry (fork find (.1 | grpc._defines) .0)

grpc._defines : String -> GrpcFile -> Bool
grpc._defines = curry (fork any (.0 | grpc._symbol-match) (.1 | .symbols))

grpc._symbol-match : String -> String -> Bool
grpc._symbol-match =
    curry (fork or (uncurry eq) (fork starts-with (.1 | concat ".") .0))

# grpc/health/v1/health.proto
grpc._health-file : GrpcFile
grpc._health-file = GrpcFile {
    name = "grpc/health/v1/health.proto",
    descriptor =
        grpc.base64-bytes
            "",
    symbols = [
        "grpc.health.v1.HealthCheckRequest",
        "grpc.health.v1.HealthCheckResponse",
        "grpc.health.v1.Health",
    ],
    imports = [],
}

test "grpc.code-name" =
    [grpc.not-found, grpc.unavailable, 99]
    | map grpc.code-name
    | eq ["NOT_FOUND", "UNAVAILABLE", "UNKNOWN"]

test "grpc.fail" =
    "x"
    | attempt (grpc.fail grpc.not-found)
    | eq (Err GrpcError { code = 5, message = "x" })
