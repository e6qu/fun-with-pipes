# JSON values. `null` is the explicit variant `Json.Null`, not a language
# null.

Json =
    | Json.Null
    | Json.Bool Bool
    | Json.Num F64
    | Json.Str String
    | Json.Arr List[Json]
    | Json.Obj List[(String, Json)]

# parse JSON text; errors name the byte offset
foreign "fwp" json.parse : String -> Result[Json, String]
# compact JSON text; integral numbers below 1e15 have no fraction
foreign "fwp" json.encode : Json -> String

# the value of the first pair with the given key
lookup : String -> List[(String, a)] -> Option[a]
lookup = eq | compose .0 | find | flip compose (option.map .1)

# field of an object
json.get : String -> Json -> Option[Json]
json.get = curry (match
    (_, Json.Obj _) -> lookup
    _ -> const None)

# element of an array
json.at : I64 -> Json -> Option[Json]
json.at = curry (match
    (_, Json.Arr _) -> nth
    _ -> const None)

json.as-string : Json -> Option[String]
json.as-string = match
    Json.Str _ -> Some
    _ -> const None

json.as-number : Json -> Option[F64]
json.as-number = match
    Json.Num _ -> Some
    _ -> const None

json.as-bool : Json -> Option[Bool]
json.as-bool = match
    Json.Bool _ -> Some
    _ -> const None

json.as-array : Json -> Option[List[Json]]
json.as-array = match
    Json.Arr _ -> Some
    _ -> const None

json.as-object : Json -> Option[List[(String, Json)]]
json.as-object = match
    Json.Obj _ -> Some
    _ -> const None

json.int : I64 -> Json
json.int = int.to-float | Json.Num

json.object : List[(String, Json)] -> Json
json.object = Json.Obj

json.strings : List[String] -> Json
json.strings = map Json.Str | Json.Arr

test "json round trip" = "{\"a\": [1, 2.5, true, null], \"b\": \"x\\ny\"}" | json.parse | result.map json.encode | eq (Ok "{\"a\":[1,2.5,true,null],\"b\":\"x\\ny\"}")
test "json get" = "{\"a\": {\"b\": [10, 20]}}" | json.parse | result.to-option | option.and-then (json.get "a") | option.and-then (json.get "b") | option.and-then (json.at 1) | option.and-then json.as-number | eq (Some 20.0)
test "json error" = "[1, 2" | json.parse | eq (Err "unexpected end of input at byte 5")
test "json bad escape" = "\"\\q\"" | json.parse | eq (Err "invalid escape at byte 2")
test "json trailing" = "1 2" | json.parse | eq (Err "trailing characters at byte 2")
test "json unicode" = "\"\\u00e9\\ud83d\\ude00\"" | json.parse | eq (Ok (Json.Str "é😀"))
test "json numbers" = [json.int 42, Json.Num 0.1, Json.Num -1.5e300, Json.Num 1e15] | Json.Arr | json.encode | eq "[42,0.1,-1.5e+300,1000000000000000.0]"
test "json escapes" = "a\"b\\c\td\u{1}" | Json.Str | json.encode | eq "\"a\\\"b\\\\c\\td\\u0001\""
