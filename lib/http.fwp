# HTTP/1.1 and HTTP/2 server and client.
#
# A handler is an ordinary function `Request -> Response`, and middleware is
# ordinary composition:
#
#     handler = timeout 2s | auth.bearer token | service | json.response
#
# The server runs every connection in its own task. It bounds the number of
# connections (accepting waits while all slots are taken), the size of
# request heads and bodies and the requests per connection; it applies idle,
# header, body, write and per-request timeouts; and on SIGINT/SIGTERM it
# stops accepting, lets in-flight requests finish within a grace period,
# then cancels the rest.
#
# With `tls` in its config the server speaks HTTPS, and the client speaks
# HTTPS to `https://` URLs (lib/tls.fwp): the same code runs over TLS
# connections, which are `Conn`s too.
#
# The server also speaks HTTP/2: over TLS when the client chooses "h2"
# with ALPN, and on cleartext connections that start with HTTP/2's
# connection preface (h2c with prior knowledge) or ask for it with
# `Upgrade: h2c`. Every stream runs in its
# own task, with the same handler, limits and timeouts. The client uses
# HTTP/2 when a TLS server chooses it, pooling one connection per origin.
# Responses can be compressed (`compress` in the config, or the
# `http.compress` middleware), request bodies with a content encoding
# are decompressed, and the client decompresses responses.

Request = {
    method: String,
    path: String,
    query: String,
    version: String,
    headers: List[(String, String)],
    body: Bytes,
    params: List[(String, String)],
    remote: String,
}

# a response body: complete, or streamed with chunked transfer encoding. A
# streaming body is produced by a function that the server runs in its own
# task, sending chunks into a bounded channel (which gives backpressure);
# `channel.send` returns False once the client has gone away.
#
# `Body.Upgrade f` (with status 101) switches the connection to another
# protocol: after the response head, the server runs `f` with the
# connection and the bytes it already read past the request, then closes
# the connection (WebSocket is built on it: lib/websocket.fwp).
Body =
    | Body.Full Bytes
    | Body.Stream (Channel[Bytes] -> () ! {Async, IO, Network, FileIO})
    | Body.Upgrade (Conn -> Bytes -> () ! {Async, IO, Network, FileIO})

Response = { status: I64, headers: List[(String, String)], body: Body }

HttpError = { status: I64, message: String }

ServerConfig = {
    addr: String,
    max-connections: I64,
    max-header-bytes: I64,
    max-body-bytes: I64,
    max-requests-per-connection: I64,
    idle-timeout: Duration,
    header-timeout: Duration,
    body-timeout: Duration,
    write-timeout: Duration,
    request-timeout: Duration,
    shutdown-grace: Duration,
    tls: Option[TlsServer],
    # serve HTTP/2 too (h2 with ALPN over TLS, h2c with prior knowledge
    # or `Upgrade: h2c`)
    http2: Bool,
    # compress responses of at least this many bytes with gzip (or
    # deflate) for clients that accept it (`Accept-Encoding`), and
    # streamed responses with gzip as they go
    compress: Option[I64],
    # the response to an error the server answers itself (a malformed
    # request, a body too large, a request timeout): its status and
    # message; `http.text` by default (REST servers answer JSON)
    error-response: I64 -> String -> Response,
}

# internal
foreign "fwp" http.parse-request-head : Bytes -> Result[(String, String, String, List[(String, String)]), String]
# internal
foreign "fwp" http.parse-response-head : Bytes -> Result[(String, I64, String, List[(String, String)]), String]
# a header that can be written as is: a token as its name, and no control
# characters (CR, LF, NUL, ...) but tabs in its value
# internal
foreign "fwp" http.field-ok : String -> String -> Bool
# the body length request headers declare: 0 without content-length, -1
# when it is not a plain decimal number or the header is repeated
# internal
foreign "fwp" http.content-length : List[(String, String)] -> I64

# ------------------------------------------------------------- responses

http.config : String -> ServerConfig
http.config = make ServerConfig {
    addr = id,
    max-connections = const 1024,
    max-header-bytes = const 16384,
    max-body-bytes = const 1048576,
    max-requests-per-connection = const 1000,
    idle-timeout = const 30s,
    header-timeout = const 10s,
    body-timeout = const 30s,
    write-timeout = const 30s,
    request-timeout = const 30s,
    shutdown-grace = const 5s,
    tls = const None,
    http2 = const True,
    compress = const None,
    error-response = const http.text,
}

# a response with a status, a content type and a body
http.respond : I64 -> String -> Bytes -> Response
http.respond = curry3 (make Response {
    status = .0,
    headers = .1 | curry id "content-type" | singleton,
    body = .2 | Body.Full,
})

http.text : I64 -> String -> Response
http.text = curry (both .0 (.1 | string.to-bytes)
    | uncurry (flip http.respond "text/plain; charset=utf-8"))

http.json : I64 -> Json -> Response
http.json = curry (both .0 (.1 | json.encode | string.to-bytes)
    | uncurry (flip http.respond "application/json"))

json.response : Json -> Response
json.response = http.json 200

http.stream : I64 -> String -> (Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> Response
http.stream = curry3 (make Response {
    status = .0,
    headers = .1 | curry id "content-type" | singleton,
    body = .2 | Body.Stream,
})

# add a header
http.with-header : String -> String -> Response -> Response
http.with-header = curry3 (make Response {
    status = .2 | .status,
    headers = fork Cons (both .0 .1) (.2 | .headers),
    body = .2 | .body,
})

# abort the handler with an error response
http.fail : I64 -> String -> a ! {Error[HttpError]}
http.fail = curry (make HttpError { status = .0, message = .1 } | fail)

http.reason : I64 -> String
http.reason = match
    100 -> "Continue"
    200 -> "OK"
    201 -> "Created"
    202 -> "Accepted"
    204 -> "No Content"
    301 -> "Moved Permanently"
    302 -> "Found"
    304 -> "Not Modified"
    400 -> "Bad Request"
    401 -> "Unauthorized"
    403 -> "Forbidden"
    404 -> "Not Found"
    405 -> "Method Not Allowed"
    406 -> "Not Acceptable"
    408 -> "Request Timeout"
    409 -> "Conflict"
    411 -> "Length Required"
    413 -> "Content Too Large"
    415 -> "Unsupported Media Type"
    422 -> "Unprocessable Content"
    429 -> "Too Many Requests"
    431 -> "Request Header Fields Too Large"
    500 -> "Internal Server Error"
    501 -> "Not Implemented"
    502 -> "Bad Gateway"
    503 -> "Service Unavailable"
    504 -> "Gateway Timeout"
    _ -> const ""

# ------------------------------------------------------------- requests

# a request header (names are case-insensitive)
http.header : String -> Request -> Option[String]
http.header = lower | json.lookup | compose .headers

http.query-param : String -> Request -> Option[String]
http.query-param = json.lookup | compose (.query | form.parse)

# a path parameter bound by the router (`/users/:id`)
http.param : String -> Request -> Option[String]
http.param = json.lookup | compose .params

# the subject of the client's certificate (`CN=alice,O=Example`), when the
# server requires client certificates (mutual TLS: `client-ca` in its
# `TlsServer`), which it has then verified
http.peer-subject : Request -> Option[String]
http.peer-subject = http.param ":tls-peer"

http.body-text : Request -> String
http.body-text = .body | string.from-bytes | option.unwrap-or ""

http.form : Request -> List[(String, String)]
http.form = http.body-text | form.parse

# the cookies of a request (`Cookie: a=1; b=2`), as name and value pairs
# (a value in double quotes without them)
http.cookies : Request -> List[(String, String)]
http.cookies =
    .headers
    | filter (.0 | eq "cookie")
    | list.flat-map (.1 | split ";")
    | filter-map (trim | string.split-once "=")
    | map (both (.0 | trim) (.1 | trim | http.unquote))

# a cookie of a request
http.cookie : String -> Request -> Option[String]
http.cookie = json.lookup | compose http.cookies

# internal
http.unquote : String -> String
http.unquote =
    if
        (fork
            and
            (fork and (starts-with "\"") (ends-with "\""))
            (string.length | ge 2))
        (fork apply id (string.length | sub 2 | string.slice 1))
        id

# the body as JSON; 400 if it is not
http.json-body : Request -> Json ! {Error[HttpError]}
http.json-body = http.body-text | json.parse | match
    Ok -> id
    Err -> flip concat "invalid JSON: " | http.fail 400

# ------------------------------------------------------------- middleware

# give the rest of the request this long (the handler is cancelled and the
# client gets 503 when it passes)
timeout : Duration -> a -> a ! {Async}
timeout = task.deadline

# require `Authorization: Bearer <token>`
auth.bearer : String -> Request -> Request ! {Error[HttpError]}
auth.bearer = curry (if
    (fork
        eq
        (.0 | format "Bearer {}")
        (.1 | http.header "authorization" | option.unwrap-or ""))
    .1
    (const "missing or invalid bearer token" | http.fail 401))

# count requests by method in the `http_requests_total` metric
http.count : Request -> Request ! {IO}
http.count = tap (const "http_requests_total" | metrics.inc)

# ------------------------------------------------------------- routing

Route = {
    method: String,
    pattern: List[String],
    handler: Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]},
}

# `http.route "GET" "/users/:id" handler`; method "*" matches any method
http.route : String -> String -> (Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}) -> Route
http.route = curry3 (make Route {
    method = .0,
    pattern = .1 | http.segments,
    handler = .2,
})

# internal
http.segments : String -> List[String]
http.segments = split "/" | filter (string.is-empty | not)

# dispatch to the first matching route; 404 or 405 otherwise
http.router : List[Route] -> Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
http.router = curry (fork http.dispatch id (uncurry http.find-route))

# internal
http.find-route : List[Route] -> Request -> Option[(Route, List[(String, String)])]
http.find-route = curry (fork filter-map (.1 | http.route-match) .0 | head)

# internal
http.route-match : Request -> Route -> Option[(Route, List[(String, String)])]
http.route-match = curry (if http.method-ok http.path-params (const None))

# internal
http.method-ok : (Request, Route) -> Bool
http.method-ok =
    fork
        or
        (fork eq (.0 | .method | http.head-as-get) (.1 | .method))
        (.1 | .method | eq "*")

# HEAD requests are routed like GET (the server omits the body)
# internal
http.head-as-get : String -> String
http.head-as-get = if (eq "HEAD") (const "GET") id

# internal
http.path-params : (Request, Route) -> Option[(Route, List[(String, String)])]
http.path-params =
    fork
        option.map
        (.1 | curry id)
        (fork http.match-path (.1 | .pattern) (.0 | .path | http.segments))

# bindings of `:name` segments if a pattern matches a path
# internal
http.match-path : List[String] -> List[String] -> Option[List[(String, String)]]
http.match-path = curry (if
    (both (.0 | length) (.1 | length) | uncurry eq)
    (uncurry (flip zip)
        | map http.seg-match
        | http.all-some
        | option.map (filter-map id))
    (const None))

# internal
http.seg-match : (String, String) -> Option[Option[(String, String)]]
http.seg-match =
    if
        (.0 | starts-with ":")
        (both (.0 | string.slice 1 1000000) .1 | Some | Some)
        (if (uncurry eq) (const (Some None)) (const None))

# all present
# internal
http.all-some : List[Option[a]] -> Option[List[a]]
http.all-some = fold http.all-some-step (Some []) | option.map reverse

# internal
http.all-some-step : Option[List[a]] -> Option[a] -> Option[List[a]]
http.all-some-step = curry (match
    (Some _, Some _) -> then2 (flip Cons) Some
    _ -> const None)

# internal
http.dispatch : (List[Route], Request) -> Option[(Route, List[(String, String)])] -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
http.dispatch = curry (match
    (_, None) -> http.missing
    (_, Some _) -> curry (fork
        apply
        (fork
            http.set-params
            (fork append (.1 | .1) (.0 | .1 | .params))
            (.0 | .1))
        (.1 | .0 | .handler)))

# internal
http.set-params : List[(String, String)] -> Request -> Request
http.set-params = curry (make Request {
    method = .1 | .method,
    path = .1 | .path,
    query = .1 | .query,
    version = .1 | .version,
    headers = .1 | .headers,
    body = .1 | .body,
    params = .0,
    remote = .1 | .remote,
})

# internal
http.missing : (List[Route], Request) -> Response ! {Error[HttpError]}
http.missing =
    if
        (fork any (.1 | .path | http.segments | http.matches-path) .0)
        (const "method not allowed" | http.fail 405)
        (const "not found" | http.fail 404)

# internal
http.matches-path : List[String] -> Route -> Bool
http.matches-path =
    flip http.match-path | flip compose option.is-some | compose .pattern

# ------------------------------------------------------------- server

# internal
Server = {
    listener: Listener,
    config: ServerConfig,
    handler: Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]},
    slots: Channel[()],
}

# `until`: the monotonic time by which the current request's head (and
# then its body) must have arrived
# internal
ConnState = {
    server: Server,
    conn: Conn,
    buffer: Bytes,
    served: I64,
    until: Duration,
}

# internal
Head =
    | Head.Closed
    | Head.Bad ConnState I64 String
    | Head.Got Bytes ConnState

# internal
Pending = {
    st: ConnState,
    method: String,
    target: String,
    version: String,
    headers: List[(String, String)],
    length: I64,
}

# internal
BodyEnd =
    | BodyEnd.Closed
    | BodyEnd.Late Pending
    | BodyEnd.Done Pending

# internal
Exchange = { st: ConnState, request: Request, keep: Bool }

# internal
Out = {
    conn: Conn,
    keep: Bool,
    head-only: Bool,
    response: Response,
    timeout: Duration,
}

# internal
http.no-bytes : Bytes
http.no-bytes = "" | string.to-bytes

# internal
http.crlf : Bytes
http.crlf = "\r\n" | string.to-bytes

# internal
http.crlf2 : Bytes
http.crlf2 = "\r\n\r\n" | string.to-bytes

# internal
http.last-chunk : Bytes
http.last-chunk = "0\r\n\r\n" | string.to-bytes

# internal
http.bytes-take : I64 -> Bytes -> Bytes
http.bytes-take = bytes.slice 0

# internal
http.bytes-drop : I64 -> Bytes -> Bytes
http.bytes-drop = flip bytes.slice 1000000000000

# Listen on `addr` and serve until a shutdown signal; HTTPS with `tls`
# (`http.config addr | with { tls = Some (tls.server "cert.pem" "key.pem") }`).
http.serve : ServerConfig -> (Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}) -> () ! {Async, IO, Network, Error[IoError]}
http.serve = curry (fork http.serve-on (.0 | http.listen) id)

# listen on a config's address, with TLS if it has `tls`
http.listen : ServerConfig -> Listener ! {Network, Error[IoError]}
http.listen = fork http.listen-with (both .tls .http2) .addr

# internal
http.listen-with : (Option[TlsServer], Bool) -> String -> Listener ! {Network, Error[IoError]}
http.listen-with = curry (match
    ((None, _), _) -> curry (.1 | tcp.listen)
    ((Some _, _), _) -> curry3 (fork
        apply
        .2
        (both .0 .1 | uncurry http.tls-server-for | tls.listen)))

# a TLS server that offers HTTP/2 and HTTP/1.1 with ALPN, preferring
# HTTP/2
# internal
http.tls-server : TlsServer -> TlsServer
http.tls-server = flip http.tls-server-for True

# a TLS server that offers HTTP/2 (unless not `http2`) and HTTP/1.1
# internal
http.tls-server-for : TlsServer -> Bool -> TlsServer
http.tls-server-for = curry (make TlsServer {
    cert-file = .0 | .cert-file,
    key-file = .0 | .key-file,
    alpn = .1 | if id (const ["h2", "http/1.1"]) (const ["http/1.1"]),
    client-ca = .0 | .client-ca,
})

# Serve on a listener (for example one bound to port 0; a listener from
# `tls.listen` serves HTTPS).
http.serve-on : Listener -> (ServerConfig, Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}) -> () ! {Async, IO, Network}
http.serve-on = curry (spawn-with http.accept-main | task.await | ignore)

# internal
http.accept-main : (Listener, (ServerConfig, Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]})) -> () ! {Async, IO, Network, FileIO}
http.accept-main =
    fork http.make-server id (.1 | .0 | .max-connections | channel.make)
    | tap (loop http.accept-step)
    | tap (.listener | tcp.stop)
    | fork task.deadline (.config | .shutdown-grace) id
    | ignore

# internal
http.make-server : (Listener, (ServerConfig, Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]})) -> Channel[()] -> Server
http.make-server = curry (make Server {
    listener = .0 | .0,
    config = .0 | .1 | .0,
    handler = .0 | .1 | .1,
    slots = .1,
})

# internal
http.accept-step : Server -> Step[Server, ()] ! {Async, IO, Network, FileIO}
http.accept-step =
    if (const () | signal.shutdown-requested) (const (Stop ())) http.accept-one

# take a connection slot (waits while all are in use), then accept
# internal
http.accept-one : Server -> Step[Server, ()] ! {Async, IO, Network, FileIO}
http.accept-one =
    tap (fork channel.send .slots (const ()))
    | fork
        http.accepted
        id
        (attempt (fork tcp.accept-for (const 100ms) .listener))

# internal
http.accepted : Server -> Result[Option[Conn], IoError] -> Step[Server, ()] ! {Async, IO, Network, FileIO}
http.accepted = curry (match
    (_, Ok None) -> http.release | Again
    (_, Ok (Some _)) -> curry (tap (spawn-with http.conn-main) | .0 | Again)
    (_, Err _) -> curry (tap
            (.1 | .message | flip concat "accept failed: " | log.error)
        | tap (const 10ms | task.sleep)
        | .0
        | http.release
        | Again))

# internal
http.release : Server -> Server ! {Async}
http.release = tap (.slots | channel.recv)

# internal
http.conn-main : (Server, Conn) -> () ! {Async, IO, Network, FileIO}
http.conn-main =
    tap (attempt http.serve-conn)
    | tap (.1 | tcp.close)
    | .0
    | http.release
    | ignore

# internal
http.serve-conn : (Server, Conn) -> () ! {Async, IO, Network, FileIO, Error[IoError]}
http.serve-conn = make ConnState {
    server = .0,
    conn = .1,
    buffer = const http.no-bytes,
    served = const 0,
    until = const 0s,
} | loop http.conn-step

# internal
http.conn-step : ConnState -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.conn-step = http.head-deadline | loop http.head-step | http.on-head

# a monotonic deadline a duration from now (capped at about a century)
# internal
http.later : Duration -> Duration ! {IO}
http.later =
    .nanos
    | min 3153600000000000000
    | fork add id (const () | time.monotonic | .nanos)
    | make Duration { nanos = id }

# the time left until a deadline (negative once it passed)
# internal
http.left : Duration -> Duration ! {IO}
http.left =
    fork sub (const () | time.monotonic | .nanos) .nanos
    | make Duration { nanos = id }

# internal
http.with-until : Duration -> ConnState -> ConnState
http.with-until = curry (make ConnState {
    server = .1 | .server,
    conn = .1 | .conn,
    buffer = .1 | .buffer,
    served = .1 | .served,
    until = .0,
})

# internal
http.head-deadline : ConnState -> ConnState ! {IO}
http.head-deadline =
    fork http.with-until (.server | .config | .header-timeout | http.later) id

# internal
http.head-step : ConnState -> Step[ConnState, Head] ! {Async, IO, Network, Error[IoError]}
http.head-step = fork http.head-found id (.buffer | bytes.find http.crlf2)

# internal
http.head-found : ConnState -> Option[I64] -> Step[ConnState, Head] ! {Async, IO, Network, Error[IoError]}
http.head-found = curry (match
    (_, Some _) -> curry (if
        (fork gt (.0 | .server | .config | .max-header-bytes) .1)
        (.0 | Head.Bad | apply 431 | apply "request header too large" | Stop)
        (fork
                Head.Got
                (fork http.bytes-take .1 (.0 | .buffer))
                (fork
                    http.with-buffer
                    (fork http.bytes-drop (.1 | add 4) (.0 | .buffer))
                    .0)
            | Stop))
    (_, None) -> http.head-more)

# internal
http.head-more : ConnState -> Step[ConnState, Head] ! {Async, IO, Network, Error[IoError]}
http.head-more =
    if
        (fork
            gt
            (.server | .config | .max-header-bytes)
            (.buffer | bytes.length))
        (Head.Bad | apply 431 | apply "request header too large" | Stop)
        (fork
            http.head-read
            id
            (both http.head-wait .conn | uncurry (flip tcp.read-for 16384)))

# before the first byte of a request: the idle timeout; after it, what is
# left of the header timeout (a client trickling bytes cannot hold the
# connection forever)
# internal
http.head-wait : ConnState -> Duration ! {IO}
http.head-wait =
    if
        (.buffer | bytes.length | eq 0)
        (.server | .config | .idle-timeout)
        (.until | http.left)

# internal
http.head-read : ConnState -> Option[Bytes] -> Step[ConnState, Head] ! {IO}
http.head-read = curry (match
    (_, None) ->
        if
            (.buffer | bytes.length | eq 0)
            (const (Stop Head.Closed))
            (Head.Bad | apply 408 | apply "request header timeout" | Stop)
    (_, Some _) -> curry (if
        (.1 | bytes.length | eq 0)
        (const (Stop Head.Closed))
        (fork
                http.with-buffer
                (fork bytes.append .1 (.0 | .buffer))
                (.0 | http.first-byte)
            | Again)))

# the header timeout counts from the first byte of the request
# internal
http.first-byte : ConnState -> ConnState ! {IO}
http.first-byte = if (.buffer | bytes.length | eq 0) http.head-deadline id

# internal
http.with-buffer : Bytes -> ConnState -> ConnState
http.with-buffer = curry (make ConnState {
    server = .1 | .server,
    conn = .1 | .conn,
    buffer = .0,
    served = .1 | .served,
    until = .1 | .until,
})

# internal
http.on-head : Head -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.on-head = match
    Head.Closed -> Stop ()
    Head.Bad _ _ _ -> curry3 (fork http.error-stop .1 (both .0 .2))
    Head.Got _ _ -> http.on-request

# answer with an error and close the connection
# internal
http.error-stop : I64 -> (ConnState, String) -> Step[ConnState, ()] ! {Async, Network, Error[IoError]}
http.error-stop = curry (make Out {
    conn = .1 | .0 | .conn,
    keep = const False,
    head-only = const False,
    response = http.error-of,
    timeout = .1 | .0 | .server | .config | .write-timeout,
} | http.write-out | const (Stop ()))

# the response to an error, by the server's `error-response`
# internal
http.error-of : (I64, (ConnState, String)) -> Response
http.error-of =
    fork
        apply
        (both .0 (.1 | .1))
        (.1 | .0 | .server | .config | .error-response | uncurry)

# HTTP/2's connection preface starts like a request head
# internal
http.on-request : Bytes -> ConnState -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.on-request = curry (if
    (fork and (.0 | eq http.preface-head) (.1 | .server | .config | .http2))
    (.1 | http.serve-h2)
    (fork http.on-parsed .1 (.0 | http.parse-request-head)))

# internal
http.preface-head : Bytes
http.preface-head = "PRI * HTTP/2.0" | string.to-bytes

# internal
http.preface-start : Bytes
http.preface-start = "PRI * HTTP/2.0\r\n\r\n" | string.to-bytes

# internal
http.on-parsed : ConnState -> Result[(String, String, String, List[(String, String)]), String] -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.on-parsed = curry (match
    (_, Err _) -> curry (http.error-stop 400)
    (_, Ok _) -> curry (make Pending {
        st = .0,
        method = .1 | .0,
        target = .1 | .1,
        version = .1 | .2,
        headers = .1 | .3,
        length = .1 | .3 | http.content-length,
    } | http.check-body))

# internal
http.check-body : Pending -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.check-body =
    if
        (.headers | json.lookup "transfer-encoding" | option.is-some)
        (http.pending-error
            501
            "request bodies with a transfer encoding are not supported")
        (if
            (.length | lt 0)
            (http.pending-error 400 "invalid content-length")
            (if
                (fork gt (.st | .server | .config | .max-body-bytes) .length)
                (http.pending-error 413 "request body too large")
                http.read-body))

# internal
http.pending-error : I64 -> String -> Pending -> Step[ConnState, ()] ! {Async, Network, Error[IoError]}
http.pending-error = curry3 (fork http.error-stop .0 (both (.2 | .st) .1))

# internal
http.read-body : Pending -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.read-body = http.body-deadline | loop http.body-step | http.on-body

# the whole body must arrive within the body timeout
# internal
http.body-deadline : Pending -> Pending ! {IO}
http.body-deadline =
    fork
        http.pending-st
        (fork
            http.with-until
            (.st | .server | .config | .body-timeout | http.later)
            .st)
        id

# internal
http.body-step : Pending -> Step[Pending, BodyEnd] ! {Async, IO, Network, Error[IoError]}
http.body-step =
    if
        (fork ge .length (.st | .buffer | bytes.length))
        (BodyEnd.Done | Stop)
        (fork
            http.body-read
            id
            (both (.st | .until | http.left) (.st | .conn)
                | uncurry (flip tcp.read-for 65536)))

# internal
http.body-read : Pending -> Option[Bytes] -> Step[Pending, BodyEnd]
http.body-read = curry (match
    (_, None) -> BodyEnd.Late | Stop
    (_, Some _) -> curry (if
        (.1 | bytes.length | eq 0)
        (const (Stop BodyEnd.Closed))
        (swap | uncurry http.pending-append | Again)))

# internal
http.pending-st : ConnState -> Pending -> Pending
http.pending-st = curry (make Pending {
    st = .0,
    method = .1 | .method,
    target = .1 | .target,
    version = .1 | .version,
    headers = .1 | .headers,
    length = .1 | .length,
})

# internal
http.pending-append : Bytes -> Pending -> Pending
http.pending-append = curry (fork
    http.pending-st
    (fork
        http.with-buffer
        (fork bytes.append .0 (.1 | .st | .buffer))
        (.1 | .st))
    .1)

# internal
http.on-body : BodyEnd -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.on-body = match
    BodyEnd.Closed -> Stop ()
    BodyEnd.Late _ -> http.pending-error 408 "request body timeout"
    BodyEnd.Done _ -> http.respond-to

# internal
http.respond-to : Pending -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.respond-to = if http.h2c-wanted http.upgrade-h2c (make Exchange {
    st =
        fork http.with-buffer (fork http.bytes-drop .length (.st | .buffer)) .st,
    request = http.request-of,
    keep = http.keep-alive,
} | http.exchange)

# internal
http.request-of : Pending -> Request ! {Network}
http.request-of = make Request {
    method = .method,
    path = .target | http.path-of,
    query =
        .target | string.split-once "?" | option.map .1 | option.unwrap-or "",
    version = .version,
    headers = .headers,
    body = fork http.bytes-take .length (.st | .buffer),
    params =
        .st
        | .conn
        | tls.peer-subject
        | option.map (curry id ":tls-peer")
        | option.to-list,
    remote = .st | .conn | tcp.peer-addr,
}

# internal
http.path-of : String -> String
http.path-of = fork option.unwrap-or id (string.split-once "?" | option.map .0)

# internal
http.keep-alive : Pending -> Bool ! {Async}
http.keep-alive =
    fork
        and
        (.version | eq "HTTP/1.1")
        (fork
            and
            (.headers
                | json.lookup "connection"
                | option.map lower
                | eq (Some "close")
                | not)
            (fork
                and
                (fork
                    gt
                    (.st | .served | add 1)
                    (.st | .server | .config | .max-requests-per-connection))
                (const () | signal.shutdown-requested | not)))

# internal
http.exchange : Exchange -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.exchange =
    fork http.exchanged id (fork http.answer (.st | .server) .request)

# internal
http.exchanged : Exchange -> Response -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.exchanged = curry (tap (http.out-of | http.write-out)
    | if
        (.1 | .body | http.is-upgrade)
        (fork http.upgrade-with (.1 | .body) (.0 | .st) | const (Stop ()))
        (.0 | if .keep (.st | http.next-served | Again) (const (Stop ()))))

# internal
http.out-of : (Exchange, Response) -> Out
http.out-of = make Out {
    conn = .0 | .st | .conn,
    keep = .0 | .keep,
    head-only = .0 | .request | .method | eq "HEAD",
    response = .1,
    timeout = .0 | .st | .server | .config | .write-timeout,
}

# internal
http.is-upgrade : Body -> Bool
http.is-upgrade = match
    Body.Upgrade _ -> const True
    _ -> const False

# run the protocol a connection switched to
# internal
http.upgrade-with : Body -> ConnState -> () ! {Async, IO, Network, FileIO}
http.upgrade-with = curry (match
    (Body.Upgrade _, _) ->
        curry (fork apply (both (.1 | .conn) (.1 | .buffer)) (.0 | uncurry))
    _ -> const ())

# the response to a request: its body decoded (`content-encoding`), the
# handler run, and the response compressed when the config says so
# internal
http.answer : Server -> Request -> Response ! {Async}
http.answer = curry (fork
    http.compressing
    (both (.0 | .config | .compress) .1)
    (fork
        http.decoded-or
        .0
        (fork http.decode-request (.0 | .config | .max-body-bytes) .1)))

# internal
http.decoded-or : Server -> Result[Request, (I64, String)] -> Response ! {Async}
http.decoded-or = curry (match
    (_, Ok _) -> http.run-handler
    (_, Err _) -> http.error-response-of)

# the server's response to an error: status and message
# internal
http.error-response-of : Server -> (I64, String) -> Response
http.error-response-of =
    curry (fork apply .1 (.0 | .config | .error-response | uncurry))

# the handler in its own task, with the request timeout
# internal
http.run-handler : Server -> Request -> Response ! {Async}
http.run-handler = curry (fork
    http.outcome
    (.0 | .config | .error-response)
    (fork
        task.within
        (.0 | .config | .request-timeout)
        (fork compose (.1 | const) (.0 | .handler | attempt))))

# internal
http.outcome : (I64 -> String -> Response) -> Option[Result[Response, HttpError]] -> Response
http.outcome = curry (match
    (_, None) -> apply 503 | apply "request timed out"
    (_, Some (Ok _)) -> const id
    (_, Some (Err _)) ->
        curry (fork apply (.1 | .message) (fork apply (.1 | .status) .0)))

# internal
http.next-served : ConnState -> ConnState
http.next-served = make ConnState {
    server = .server,
    conn = .conn,
    buffer = .buffer,
    served = .served | add 1,
    until = .until,
}

# internal
http.write-out : Out -> () ! {Async, Network, Error[IoError]}
http.write-out = http.checked | fork http.send-body id (.response | .body)

# A response that cannot be written as is (a header with CR or LF would
# let a handler's input split the response) is replaced by a 500.
# internal
http.checked : Out -> Out
http.checked =
    if
        (.response | http.response-ok)
        id
        (make Out {
            conn = .conn,
            keep = .keep,
            head-only = .head-only,
            response = const (http.text 500 "invalid response header"),
            timeout = .timeout,
        })

# internal
http.response-ok : Response -> Bool
http.response-ok =
    fork
        and
        (.status | fork and (ge 100) (le 999))
        (.headers | all (uncurry http.field-ok))

# write with the write timeout
# internal
http.put : Out -> Bytes -> () ! {Async, Network, Error[IoError]}
http.put = curry (fork
    apply
    (.0 | .conn)
    (both (.0 | .timeout) .1 | uncurry tcp.write-for))

# internal
http.send-body : Out -> Body -> () ! {Async, Network, Error[IoError]}
http.send-body = curry (match
    (_, Body.Full _) -> curry (fork
        http.put
        .0
        (fork
            bytes.append
            (if (.0 | .head-only) (const http.no-bytes) .1)
            (.0 | http.head-bytes)))
    (_, Body.Stream _) -> curry (tap (fork http.put .0 (.0 | http.head-bytes))
        | if (.0 | .head-only) (const ()) http.stream-body)
    (_, Body.Upgrade _) -> curry (fork http.put .0 (.0 | http.head-bytes)))

# internal
http.stream-body : (Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> () ! {Async, Network, Error[IoError]}
http.stream-body = fork http.stream-start id (const 8 | channel.make)

# internal
http.stream-start : (Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> Channel[Bytes] -> () ! {Async, Network, Error[IoError]}
http.stream-start = curry (fork
    http.stream-run
    id
    (fork spawn-with (.0 | .1 | http.closing) .1))

# internal
http.stream-run : ((Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}), Channel[Bytes]) -> Task[()] -> () ! {Async, Network, Error[IoError]}
http.stream-run = curry (fork
    http.stream-finish
    id
    (both (.0 | .0 | .0) (.0 | .1) | attempt (loop http.chunk-step)))

# the client is done (or gone): stop the producer
# internal
http.stream-finish : (((Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}), Channel[Bytes]), Task[()]) -> Result[(), IoError] -> () ! {Async, Error[IoError]}
http.stream-finish = curry (tap (.0 | .0 | .1 | channel.close)
    | tap (.0 | .1 | task.cancel)
    | .1
    | try)

# run a producer, then close its channel
# internal
http.closing : (Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> Channel[Bytes] -> () ! {Async, IO, Network, FileIO}
http.closing = flip both channel.close | flip compose ignore

# internal
http.chunk-step : (Out, Channel[Bytes]) -> Step[(Out, Channel[Bytes]), ()] ! {Async, Network, Error[IoError]}
http.chunk-step = fork http.chunk-got id (.1 | channel.recv)

# internal
http.chunk-got : (Out, Channel[Bytes]) -> Option[Bytes] -> Step[(Out, Channel[Bytes]), ()] ! {Async, Network, Error[IoError]}
http.chunk-got = curry (match
    (_, None) -> .0 | flip http.put http.last-chunk | Stop
    (_, Some _) -> curry (tap (fork http.put (.0 | .0) (.1 | http.chunk-frame))
        | .0
        | Again))

# chunk sizes: lower-case hexadecimal (negative numbers with a sign)
# internal
foreign "fwp" http.to-hex : I64 -> String = "int.to-hex"
# internal
foreign "fwp" http.parse-hex : String -> Option[I64] = "int.parse-hex"

# internal
http.chunk-frame : Bytes -> Bytes
http.chunk-frame =
    if
        (bytes.length | eq 0)
        (const http.no-bytes)
        (fork
            bytes.append
            (const http.crlf)
            (fork
                bytes.append
                id
                (bytes.length | http.to-hex | concat "\r\n" | string.to-bytes)))

# internal
http.head-bytes : Out -> Bytes
http.head-bytes = apply | flip map http.head-parts | join "" | string.to-bytes

# internal
http.head-parts : List[Out -> String]
http.head-parts = [
    .response | .status | both id http.reason | format "HTTP/1.1 {} {}\r\n",
    .response | .headers | map (format "{}: {}\r\n") | join "",
    .response | .body | http.framing,
    if
        (.response | .body | http.is-upgrade)
        (const "")
        (if
            .keep
            (const "connection: keep-alive\r\n")
            (const "connection: close\r\n")),
    const "\r\n",
]

# internal
http.framing : Body -> String
http.framing = match
    Body.Full _ -> bytes.length | format "content-length: {}\r\n"
    Body.Stream _ -> const "transfer-encoding: chunked\r\n"
    Body.Upgrade _ -> const ""

# ------------------------------------------------------------- compression

# gzip (RFC 1952) and the zlib format of HTTP's `deflate` content coding
# (RFC 1950), written from scratch; `-max` decompression gives up past
# that many bytes (a guard against decompression bombs)
foreign "fwp" gzip.compress : Bytes -> Bytes = "zlib.gzip"
foreign "fwp" gzip.decompress-max : I64 -> Bytes -> Result[Bytes, String] = "zlib.gunzip"
foreign "fwp" deflate.compress : Bytes -> Bytes = "zlib.deflate"
# the zlib format, or raw DEFLATE (which some servers send)
foreign "fwp" deflate.decompress-max : I64 -> Bytes -> Result[Bytes, String] = "zlib.inflate"

# a gzip stream in chunks: the header, then a chunk for each piece of data
# (compressed on its own and flushed, so the receiver decodes it as it
# arrives), then the end, with the CRC (`gzip._crc32` from 0) and length
# of all the data
# internal
gzip._header : Bytes
gzip._header = bytes.from-list [31, 139, 8, 0, 0, 0, 0, 0, 0, 255]
# internal
foreign "fwp" gzip._chunk : Bytes -> Bytes = "zlib.gzip-chunk"
# internal
foreign "fwp" gzip._crc32 : I64 -> Bytes -> I64 = "zlib.crc32"
# internal
foreign "fwp" gzip._end : I64 -> I64 -> Bytes = "zlib.gzip-end"

# decompress up to 64 MiB
gzip.decompress : Bytes -> Result[Bytes, String]
gzip.decompress = gzip.decompress-max 67108864

deflate.decompress : Bytes -> Result[Bytes, String]
deflate.decompress = deflate.decompress-max 67108864

# compress a handler's responses whose bodies have at least `min` bytes,
# with gzip or deflate, for clients that accept it (`Accept-Encoding`);
# streamed bodies, responses with a content encoding of their own and
# already compressed types (images, video, audio, archives) are left as
# they are
http.compress : I64 -> (Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}) -> Request -> Response ! {Async, IO, Network, FileIO, Error[HttpError]}
http.compress =
    curry3 (fork http.compressing (both (.0 | Some) .2) (fork apply .2 .1))

# internal
http.compressing : (Option[I64], Request) -> Response -> Response
http.compressing = curry (fork http.encode-response http.coding-for .1)

# the coding to compress a response with ("" for none)
# internal
http.coding-for : ((Option[I64], Request), Response) -> String
http.coding-for = if http.should-compress http.coding-of (const "")

# the client's preferred coding; streams are compressed with gzip only
# internal
http.coding-of : ((Option[I64], Request), Response) -> String
http.coding-of =
    fork
        http.stream-allows
        (.1 | .body | http.is-stream)
        (.0 | .1 | http.preferred-coding)

# internal
http.stream-allows : Bool -> String -> String
http.stream-allows = curry (if (fork and .0 (.1 | ne "gzip")) (const "") .1)

# internal
http.is-stream : Body -> Bool
http.is-stream = match
    Body.Stream _ -> const True
    _ -> const False

# internal
http.should-compress : ((Option[I64], Request), Response) -> Bool
http.should-compress =
    fork
        and
        (fork
            and
            (.0 | .0 | option.is-some)
            (fork
                or
                (.1 | .body | http.is-stream)
                (fork
                    ge
                    (.0 | .0 | option.unwrap-or 0)
                    (.1 | .body | http.full-length))))
        (.1 | http.compressible)

# internal
http.full-length : Body -> I64
http.full-length = match
    Body.Full _ -> bytes.length
    _ -> const -1

# internal
http.compressible : Response -> Bool
http.compressible =
    fork
        and
        (.status | fork and (ge 200) (fork and (ne 204) (ne 304)))
        (fork
            and
            (.headers
                | map (first lower)
                | json.lookup "content-encoding"
                | option.is-none)
            (.headers
                | map (first lower)
                | json.lookup "content-type"
                | option.unwrap-or ""
                | lower
                | http.compressible-type))

# internal
http.compressible-type : String -> Bool
http.compressible-type =
    fork
        or
        (starts-with "image/svg")
        (fork
                any
                (flip starts-with)
                (const [
                    "image/",
                    "video/",
                    "audio/",
                    "font/woff",
                    "application/zip",
                    "application/gzip",
                    "application/x-gzip",
                ])
            | not)

# gzip if the client accepts it, else deflate, else ""
# internal
http.preferred-coding : Request -> String
http.preferred-coding =
    http.accepted-codings
    | if
        (fork or (contains "gzip") (contains "*"))
        (const "gzip")
        (if (contains "deflate") (const "deflate") (const ""))

# the codings of `accept-encoding` headers, but those with `q=0`
# internal
http.accepted-codings : Request -> List[String]
http.accepted-codings =
    .headers
    | filter (.0 | lower | eq "accept-encoding")
    | list.flat-map (.1 | split ",")
    | filter http.coding-allowed
    | map (split ";" | head | option.unwrap-or "" | trim | lower)

# internal
http.coding-allowed : String -> Bool
http.coding-allowed =
    split ";"
    | drop 1
    | any (trim
        | lower
        | flip contains ["q=0", "q=0.", "q=0.0", "q=0.00", "q=0.000"])
    | not

# internal
http.encode-response : String -> Response -> Response
http.encode-response = curry (match
    ("gzip", _) -> http.encoded "gzip" gzip.compress
    ("deflate", _) -> http.encoded "deflate" deflate.compress
    _ -> .1)

# internal
http.encoded : String -> (Bytes -> Bytes) -> Response -> Response
http.encoded = curry3 (make Response {
    status = .2 | .status,
    headers =
        fork
            Cons
            (.0 | curry id "content-encoding")
            (fork
                Cons
                (const ("vary", "accept-encoding"))
                (.2 | .headers | filter (.0 | lower | ne "content-length"))),
    body = fork http.map-full .1 (.2 | .body),
})

# a whole body compressed, or a stream compressed with gzip as it goes
# (only gzip streams are chosen, `http.coding-of`)
# internal
http.map-full : (Bytes -> Bytes) -> Body -> Body
http.map-full = curry (match
    (_, Body.Full _) -> then2 (flip apply) Body.Full
    (_, Body.Stream _) -> curry (.1 | http.gzip-stream | Body.Stream)
    _ -> .1)

# a producer whose chunks go out gzipped: it writes to a channel of its
# own, which a loop compresses into the response's channel
# internal
http.gzip-stream : (Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> Channel[Bytes] -> () ! {Async, IO, Network, FileIO}
http.gzip-stream = curry (fork http.gzip-start id (const 8 | channel.make))

# internal
http.gzip-start : (Channel[Bytes] -> () ! {Async, IO, Network, FileIO}, Channel[Bytes]) -> Channel[Bytes] -> () ! {Async, IO, Network, FileIO}
http.gzip-start = curry (tap (fork spawn-with (.0 | .0 | http.closing) .1)
    | make { 0 = .0 | .1, 1 = .1, 2 = const 0, 3 = const 0 }
    | tap (fork channel.send .0 (const gzip._header))
    | loop http.gzip-step)

# the response's channel, the producer's, and the CRC and length so far
# internal
http.gzip-step : (Channel[Bytes], Channel[Bytes], I64, I64) -> Step[(Channel[Bytes], Channel[Bytes], I64, I64), ()] ! {Async}
http.gzip-step = fork http.gzip-got id (.1 | channel.recv)

# internal
http.gzip-got : (Channel[Bytes], Channel[Bytes], I64, I64) -> Option[Bytes] -> Step[(Channel[Bytes], Channel[Bytes], I64, I64), ()] ! {Async}
http.gzip-got = curry (match
    (_, None) -> fork channel.send .0 (fork gzip._end .2 .3) | const (Stop ())
    (_, Some _) -> curry (tap (fork channel.send (.0 | .0) (.1 | gzip._chunk))
        | make {
            0 = .0 | .0,
            1 = .0 | .1,
            2 = fork gzip._crc32 (.0 | .2) .1,
            3 = fork add (.0 | .3) (.1 | bytes.length),
        }
        | Again))

# a request whose body is decoded by its `content-encoding` (gzip or
# deflate), up to `max` bytes; the status and message of an error
# response otherwise
# internal
http.decode-request : I64 -> Request -> Result[Request, (I64, String)]
http.decode-request = curry (fork
    http.decode-with
    (.1
        | http.header "content-encoding"
        | option.map (trim | lower)
        | option.unwrap-or "identity")
    id)

# internal
http.decode-with : String -> (I64, Request) -> Result[Request, (I64, String)]
http.decode-with = curry (match
    ("identity", _) -> .1 | Ok
    ("gzip", _) -> http.decode-body gzip.decompress-max
    ("x-gzip", _) -> http.decode-body gzip.decompress-max
    ("deflate", _) -> http.decode-body deflate.decompress-max
    _ -> const (Err (415, "unsupported content encoding")))

# internal
http.decode-body : (I64 -> Bytes -> Result[Bytes, String]) -> (I64, Request) -> Result[Request, (I64, String)]
http.decode-body = curry (fork
    http.decoded-body
    (.1 | .1)
    (fork apply (.1 | .1 | .body) (fork apply (.1 | .0) .0)))

# internal
http.decoded-body : Request -> Result[Bytes, String] -> Result[Request, (I64, String)]
http.decoded-body = curry (match
    (_, Ok _) -> curry (fork http.with-body .1 .0 | Ok)
    (_, Err _) -> curry (.1
        | if
            (string.contains "too large")
            (const (Err (413, "request body too large")))
            (const (Err (400, "invalid compressed request body")))))

# a request with this (decoded) body
# internal
http.with-body : Bytes -> Request -> Request
http.with-body = curry (make Request {
    method = .1 | .method,
    path = .1 | .path,
    query = .1 | .query,
    version = .1 | .version,
    headers =
        .1
        | .headers
        | filter (.0 | fork and (ne "content-encoding") (ne "content-length")),
    body = .0,
    params = .1 | .params,
    remote = .1 | .remote,
})

# ------------------------------------------------------------- HTTP/2

# a request's stream on an HTTP/2 connection
# internal
H2Stream = builtin

# serve an HTTP/2 connection (its first bytes; limits: max-header-bytes,
# max-requests-per-connection, idle-timeout), running a function per stream
# internal
foreign "fwp" http._h2-serve : Conn -> Bytes -> (I64, I64, Duration) -> (H2Stream -> () ! {Async, IO, Network, FileIO}) -> Option[(String, String, List[(String, String)], Bytes)] -> () ! {Async, IO, Network, FileIO} = "http2.serve"
# (method, path, headers, remote address, the client's certificate)
# internal
foreign "fwp" http._h2-request : H2Stream -> (String, String, List[(String, String)], String, Option[String]) ! {Network} = "http2.request"
# the request body: `Err` 413 (too large), 408 (too late) or 0 (gone)
# internal
foreign "fwp" http._h2-body : I64 -> Duration -> H2Stream -> Result[Bytes, I64] ! {Async, Network} = "http2.body"
# internal
foreign "fwp" http._h2-respond : I64 -> List[(String, String)] -> Bytes -> Bool -> H2Stream -> Bool ! {Async, Network} = "http2.respond"
# internal
foreign "fwp" http._h2-data : Bytes -> Bool -> H2Stream -> Bool ! {Async, Network} = "http2.data"
# a request on the pooled connection of a key (made of the connection
# given): (method, scheme, authority, path, headers, body) to (status,
# headers, body)
# internal
foreign "fwp" http._h2-send : String -> Option[Conn] -> (String, String, String, String, List[(String, String)], Bytes) -> (I64, List[(String, String)], Bytes) ! {Async, Network, Error[IoError]} = "http2.send"
# internal
foreign "fwp" http._h2-pooled : String -> Bool ! {Network} = "http2.pooled"

# the connection started with HTTP/2's preface: serve it
# internal
http.serve-h2 : ConnState -> Step[ConnState, ()] ! {Async, IO, Network, FileIO}
http.serve-h2 =
    fork
        http.h2-run
        (both
            (fork bytes.append .buffer (const http.preface-start))
            (const None))
        id
    | const (Stop ())

# serve HTTP/2 on a connection, from what was read of it, with the request
# of an upgrade (stream 1)
# internal
http.h2-run : (Bytes, Option[(String, String, List[(String, String)], Bytes)]) -> ConnState -> () ! {Async, IO, Network, FileIO}
http.h2-run = curry (fork
    apply
    (.0 | .1)
    (fork
        apply
        (.1 | .server | http.h2-stream)
        (fork
            apply
            (.1
                | make {
                    0 = .server | .config | .max-header-bytes,
                    1 = .server | .config | .max-requests-per-connection,
                    2 = .server | .config | .idle-timeout,
                })
            (fork apply (.0 | .0) (.1 | .conn | http._h2-serve)))))

# a request that asks to switch to HTTP/2 (`Upgrade: h2c`, with
# `HTTP2-Settings`), on a server that serves it, over cleartext
# internal
http.h2c-wanted : Pending -> Bool ! {Network}
http.h2c-wanted =
    fork
        and
        (.st | .server | .config | .http2)
        (fork
            and
            (.headers | http.h2c-upgrade)
            (fork
                and
                (.headers | json.lookup "http2-settings" | option.is-some)
                (.st | .conn | tls.secure | not)))

# internal
http.h2c-upgrade : List[(String, String)] -> Bool
http.h2c-upgrade =
    fork
        and
        (json.lookup "upgrade"
            | option.unwrap-or ""
            | lower
            | split ","
            | map trim
            | contains "h2c")
        (json.lookup "connection"
            | option.unwrap-or ""
            | lower
            | string.contains "upgrade")

# switch: 101, then HTTP/2, whose stream 1 is the request
# internal
http.upgrade-h2c : Pending -> Step[ConnState, ()] ! {Async, IO, Network, FileIO, Error[IoError]}
http.upgrade-h2c =
    tap (fork tcp.write (const http.switching-h2c) (.st | .conn))
    | fork
        http.h2-run
        (both
            (fork http.bytes-drop .length (.st | .buffer))
            (make {
                0 = .method,
                1 = .target,
                2 = .headers,
                3 = fork http.bytes-take .length (.st | .buffer),
            } | Some))
        .st
    | const (Stop ())

# internal
http.switching-h2c : Bytes
http.switching-h2c =
    "HTTP/1.1 101 Switching Protocols\r\nconnection: Upgrade\r\nupgrade: h2c\r\n\r\n"
    | string.to-bytes

# internal
H2Out = { stream: H2Stream, head-only: Bool, response: Response }

# one stream: its request, the response
# internal
http.h2-stream : Server -> H2Stream -> () ! {Async, IO, Network, FileIO}
http.h2-stream = curry (fork
    http.h2-got
    id
    (fork
        apply
        .1
        (fork
            http._h2-body
            (.0 | .config | .max-body-bytes)
            (.0 | .config | .body-timeout))))

# internal
http.h2-got : (Server, H2Stream) -> Result[Bytes, I64] -> () ! {Async, IO, Network, FileIO}
http.h2-got = curry (match
    (_, Ok _) ->
        curry (fork http.h2-answer .0 (fork http.h2-request-of (.0 | .1) .1))
    (_, Err 0) -> const ()
    (_, Err _) -> http.h2-error)

# internal
http.h2-error : (Server, H2Stream) -> I64 -> () ! {Async, IO, Network, FileIO}
http.h2-error = curry (make H2Out {
    stream = .0 | .1,
    head-only = const False,
    response =
        fork
            http.error-response-of
            (.0 | .0)
            (.1 | both id http.h2-error-message),
} | http.h2-out)

# internal
http.h2-error-message : I64 -> String
http.h2-error-message = match
    413 -> "request body too large"
    408 -> "request body timeout"
    _ -> const "bad request"

# internal
http.h2-request-of : H2Stream -> Bytes -> Request ! {Network}
http.h2-request-of =
    curry (fork http.h2-request-from .1 (.0 | http._h2-request))

# internal
http.h2-request-from : Bytes -> (String, String, List[(String, String)], String, Option[String]) -> Request
http.h2-request-from = curry (make Request {
    method = .1 | .0,
    path = .1 | .1 | http.path-of,
    query =
        .1 | .1 | string.split-once "?" | option.map .1 | option.unwrap-or "",
    version = const "HTTP/2",
    headers = .1 | .2,
    body = .0,
    params = .1 | .4 | option.map (curry id ":tls-peer") | option.to-list,
    remote = .1 | .3,
})

# internal
http.h2-answer : (Server, H2Stream) -> Request -> () ! {Async, IO, Network, FileIO}
http.h2-answer = curry (make H2Out {
    stream = .0 | .1,
    head-only = .1 | .method | eq "HEAD",
    response = fork http.answer (.0 | .0) .1,
} | http.h2-out)

# internal
http.h2-out : H2Out -> () ! {Async, IO, Network, FileIO}
http.h2-out = http.h2-checked | fork http.h2-send-body id (.response | .body)

# internal
http.h2-checked : H2Out -> H2Out
http.h2-checked =
    if
        (.response | http.response-ok)
        id
        (make H2Out {
            stream = .stream,
            head-only = .head-only,
            response = const (http.text 500 "invalid response header"),
        })

# internal
http.h2-send-body : H2Out -> Body -> () ! {Async, IO, Network, FileIO}
http.h2-send-body = curry (match
    (_, Body.Full _) -> curry (fork
            apply
            (.0 | .stream)
            (fork
                apply
                (const True)
                (fork
                    apply
                    (if (.0 | .head-only) (const http.no-bytes) .1)
                    (fork
                        apply
                        (fork
                            Cons
                            (.1
                                | bytes.length
                                | show
                                | curry id "content-length")
                            (.0 | .response | .headers))
                        (.0 | .response | .status | http._h2-respond))))
        | ignore)
    (_, Body.Stream _) -> curry (tap (fork
            apply
            (.0 | .stream)
            (fork
                apply
                (.0 | .head-only)
                (fork
                    apply
                    (const http.no-bytes)
                    (fork
                        apply
                        (.0 | .response | .headers)
                        (.0 | .response | .status | http._h2-respond)))))
        | if (.0 | .head-only) (const ()) http.h2-stream-body)
    (_, Body.Upgrade _) -> curry (.0
        | .stream
        | http._h2-respond 501 [] http.no-bytes True
        | ignore))

# internal
http.h2-stream-body : (H2Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> () ! {Async, IO, Network, FileIO}
http.h2-stream-body = fork http.h2-stream-start id (const 8 | channel.make)

# internal
http.h2-stream-start : (H2Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}) -> Channel[Bytes] -> () ! {Async, IO, Network, FileIO}
http.h2-stream-start = curry (fork
    http.h2-stream-run
    id
    (fork spawn-with (.0 | .1 | http.closing) .1))

# internal
http.h2-stream-run : ((H2Out, Channel[Bytes] -> () ! {Async, IO, Network, FileIO}), Channel[Bytes]) -> Task[()] -> () ! {Async, Network}
http.h2-stream-run = curry (tap
        (both (.0 | .0 | .0 | .stream) (.0 | .1) | loop http.h2-chunk-step)
    | tap (.0 | .1 | channel.close)
    | .1
    | task.cancel)

# internal
http.h2-chunk-step : (H2Stream, Channel[Bytes]) -> Step[(H2Stream, Channel[Bytes]), ()] ! {Async, Network}
http.h2-chunk-step = fork http.h2-chunk-got id (.1 | channel.recv)

# internal
http.h2-chunk-got : (H2Stream, Channel[Bytes]) -> Option[Bytes] -> Step[(H2Stream, Channel[Bytes]), ()] ! {Async, Network}
http.h2-chunk-got = curry (match
    (_, None) -> .0 | http._h2-data http.no-bytes True | const (Stop ())
    (_, Some _) -> curry (if
        (fork apply (.0 | .0) (fork http._h2-data .1 (const False)))
        (.0 | Again)
        (const (Stop ()))))

# ------------------------------------------------------------- client

ClientRequest = {
    method: String,
    url: String,
    headers: List[(String, String)],
    body: Bytes,
}

ClientResponse = { status: I64, headers: List[(String, String)], body: Bytes }

http.get : String -> ClientResponse ! {Async, Network, Error[IoError]}
http.get = make ClientRequest {
    method = const "GET",
    url = id,
    headers = const [],
    body = const http.no-bytes,
} | http.send

http.post : String -> Bytes -> ClientResponse ! {Async, Network, Error[IoError]}
http.post = curry (make ClientRequest {
    method = const "POST",
    url = .0,
    headers = const [],
    body = .1,
} | http.send)

# How the client speaks HTTP: `Auto` uses HTTP/2 when a TLS server
# chooses it with ALPN (and HTTP/1.1 otherwise), `Http1` always HTTP/1.1,
# and `Http2` always HTTP/2 (on cleartext connections with prior
# knowledge: h2c).
HttpVersion =
    | HttpVersion.Auto
    | HttpVersion.Http1
    | HttpVersion.Http2

# The client's options: TLS for `https://` URLs, the HTTP version, and
# compression (the client sends `accept-encoding: gzip, deflate`, unless
# the request has an `accept-encoding` of its own, and decompresses
# responses with a `content-encoding` of gzip or deflate).
ClientOptions = { tls: TlsOptions, version: HttpVersion, compression: Bool }

# verify certificates with the system's CA certificates, HTTP/2 when the
# server chooses it, compression
http.client : ClientOptions
http.client = ClientOptions {
    tls = tls.options,
    version = HttpVersion.Auto,
    compression = True,
}

# send a request and read the whole response. `https://` URLs are fetched
# over TLS, verifying the server's certificate with the system's CA
# certificates; HTTP/2 connections (which TLS servers may choose) are kept
# and reused for later requests to the same origin, HTTP/1.1 ones are not
http.send : ClientRequest -> ClientResponse ! {Async, Network, Error[IoError]}
http.send = http.send-using http.client

# send a request, with these TLS options for `https://` URLs (for example
# `tls.options | tls.with-ca "ca.pem"`)
http.send-with : TlsOptions -> ClientRequest -> ClientResponse ! {Async, Network, Error[IoError]}
http.send-with = curry (fork http.send-using (.0 | http.client-tls) .1)

# internal
http.client-tls : TlsOptions -> ClientOptions
http.client-tls = make ClientOptions {
    tls = id,
    version = const HttpVersion.Auto,
    compression = const True,
}

# send a request with these options
# (`http.client | with { version = HttpVersion.Http2 }`)
http.send-using : ClientOptions -> ClientRequest -> ClientResponse ! {Async, Network, Error[IoError]}
http.send-using = curry (both .0 (fork
        http.with-accept-encoding
        (.0 | .compression)
        (.1 | http.check-request))
    | fork
        http.received
        (.0 | .compression)
        (fork http.send-to id (.1 | .url | url.parse | http.require-url)))

# internal
http.with-accept-encoding : Bool -> ClientRequest -> ClientRequest
http.with-accept-encoding = curry (if
    (fork
        and
        .0
        (.1 | .headers | any (.0 | lower | eq "accept-encoding") | not))
    (.1
        | make ClientRequest {
            method = .method,
            url = .url,
            headers =
                fork Cons (const ("accept-encoding", "gzip, deflate")) .headers,
            body = .body,
        })
    .1)

# internal
http.received : Bool -> ClientResponse -> ClientResponse ! {Error[IoError]}
http.received = curry (if
    (fork and .0 (.1 | .body | bytes.length | gt 0))
    (.1 | http.decode-response)
    .1)

# internal
http.decode-response : ClientResponse -> ClientResponse ! {Error[IoError]}
http.decode-response =
    fork
        http.decode-response-with
        (.headers
            | json.lookup "content-encoding"
            | option.map (trim | lower)
            | option.unwrap-or "identity")
        id

# internal
http.decode-response-with : String -> ClientResponse -> ClientResponse ! {Error[IoError]}
http.decode-response-with = curry (match
    ("gzip", _) -> http.client-decoded gzip.decompress
    ("x-gzip", _) -> http.client-decoded gzip.decompress
    ("deflate", _) -> http.client-decoded deflate.decompress
    _ -> .1)

# internal
http.client-decoded : (Bytes -> Result[Bytes, String]) -> ClientResponse -> ClientResponse ! {Error[IoError]}
http.client-decoded = then2 http.client-decode http.require-decoded

# internal
http.client-decode : (Bytes -> Result[Bytes, String]) -> ClientResponse -> Result[ClientResponse, String]
http.client-decode =
    curry (fork http.with-decoded .1 (fork apply (.1 | .body) .0))

# internal
http.with-decoded : ClientResponse -> Result[Bytes, String] -> Result[ClientResponse, String]
http.with-decoded = curry (match
    (_, Ok _) -> then2 http.client-with-body Ok
    (_, Err _) -> curry (.1 | Err))

# internal
http.require-decoded : Result[ClientResponse, String] -> ClientResponse ! {Error[IoError]}
http.require-decoded = match
    Ok -> id
    Err ->
        flip concat "invalid compressed response: "
        | make IoError { kind = const "http", message = id }
        | fail

# internal
http.client-with-body : ClientResponse -> Bytes -> ClientResponse
http.client-with-body = curry (make ClientResponse {
    status = .0 | .status,
    headers =
        .0
        | .headers
        | filter (.0 | fork and (ne "content-encoding") (ne "content-length")),
    body = .1,
})

# refuse a method or header that would not make one well-formed request
# (URLs with spaces or control characters do not parse)
# internal
http.check-request : ClientRequest -> ClientRequest ! {Error[IoError]}
http.check-request =
    if
        (fork
            and
            (fork http.field-ok .method (const ""))
            (.headers | all (uncurry http.field-ok)))
        id
        (const { kind = "http", message = "invalid request method or header" }
            | fail)

# internal
http.require-url : Option[Url] -> Url ! {Error[IoError]}
http.require-url = match
    Some _ -> id
    None -> fail { kind = "url", message = "invalid URL" }

# a pooled HTTP/2 connection to the origin, or a new connection
# internal
http.send-to : (ClientOptions, ClientRequest) -> Url -> ClientResponse ! {Async, Network, Error[IoError]}
http.send-to = curry (if
    (fork
        and
        (.0 | .0 | .version | http.not-http1)
        (http.pool-key | http._h2-pooled))
    (fork http.h2-exchange id (const None))
    (fork http.send-on id http.connect))

# internal
http.not-http1 : HttpVersion -> Bool
http.not-http1 = match
    HttpVersion.Http1 -> False
    _ -> const True

# connect to a URL's server: with TLS for https, offering HTTP/2 and
# HTTP/1.1 (by the version) with ALPN
# internal
http.connect : ((ClientOptions, ClientRequest), Url) -> Conn ! {Async, Network, Error[IoError]}
http.connect =
    if
        (.1 | .scheme | eq "https")
        (fork
            apply
            (.1 | http.host-port)
            (both (.0 | .0 | .tls) (.0 | .0 | .version)
                | uncurry http.tls-client
                | tls.connect-with))
        (.1 | http.host-port | tcp.connect)

# internal
http.tls-client : TlsOptions -> HttpVersion -> TlsOptions
http.tls-client = curry (make TlsOptions {
    ca-file = .0 | .ca-file,
    insecure = .0 | .insecure,
    server-name = .0 | .server-name,
    alpn = .1 | http.alpn-of,
    cert-file = .0 | .cert-file,
    key-file = .0 | .key-file,
})

# internal
http.alpn-of : HttpVersion -> List[String]
http.alpn-of = match
    HttpVersion.Auto -> ["h2", "http/1.1"]
    HttpVersion.Http1 -> ["http/1.1"]
    HttpVersion.Http2 -> ["h2"]

# internal
http.send-on : ((ClientOptions, ClientRequest), Url) -> Conn -> ClientResponse ! {Async, Network, Error[IoError]}
http.send-on = curry (if
    (fork http.speaks-h2 (.0 | .0 | .0 | .version) .1)
    (fork http.h2-exchange .0 (.1 | Some))
    http.send-h1)

# internal
http.speaks-h2 : HttpVersion -> Conn -> Bool ! {Network}
http.speaks-h2 = curry (match
    (HttpVersion.Auto, _) -> tls.alpn | eq "h2"
    (HttpVersion.Http1, _) -> const False
    (HttpVersion.Http2, _) -> const True)

# HTTP/1.1: one connection per request
# internal
http.send-h1 : (((ClientOptions, ClientRequest), Url), Conn) -> ClientResponse ! {Async, Network, Error[IoError]}
http.send-h1 =
    tap (fork tcp.write (both (.0 | .0 | .1) (.0 | .1) | http.request-bytes) .1)
    | both (.1 | http.read-all) (.1 | tcp.close)
    | .0
    | http.parse-client

# the pool's key of an origin's connections (with the TLS options)
# internal
http.pool-key : ((ClientOptions, ClientRequest), Url) -> String
http.pool-key = make {
    0 = .1 | .scheme,
    1 = .1 | http.host-port,
    2 = .0 | .0 | .tls | show,
} | format "{}://{} {}"

# HTTP/2: a request on the origin's pooled connection (made of `conn`,
# when given)
# internal
http.h2-exchange : ((ClientOptions, ClientRequest), Url) -> Option[Conn] -> ClientResponse ! {Async, Network, Error[IoError]}
http.h2-exchange = curry (fork
        apply
        (.0 | http.h2-request)
        (fork apply .1 (.0 | http.pool-key | http._h2-send))
    | make ClientResponse { status = .0, headers = .1, body = .2 })

# internal
http.h2-request : ((ClientOptions, ClientRequest), Url) -> (String, String, String, String, List[(String, String)], Bytes)
http.h2-request = make {
    0 = .0 | .1 | .method,
    1 = .1 | .scheme,
    2 = .1 | http.host-header,
    3 = .1 | http.target-of,
    4 = .0 | .1 | .headers | Cons ("user-agent", "fwp"),
    5 = .0 | .1 | .body,
}

# internal
http.host-port : Url -> String
http.host-port = both http.host-name .port | format "{}:{}"

# IPv6 literals in brackets
# internal
http.host-name : Url -> String
http.host-name = .host | if (string.contains ":") (format "[{}]") id

# the host header: with the port when it is not the scheme's default
# internal
http.host-header : Url -> String
http.host-header =
    if
        (fork eq .port (.scheme | http.default-port))
        http.host-name
        http.host-port

# internal
http.default-port : String -> I64
http.default-port = match
    "http" -> 80
    "ws" -> 80
    "https" -> 443
    "wss" -> 443
    _ -> const 0

# internal
http.request-bytes : (ClientRequest, Url) -> Bytes
http.request-bytes =
    fork
        bytes.append
        (.0 | .body)
        (apply | flip map http.request-parts | join "" | string.to-bytes)

# internal
http.request-parts : List[(ClientRequest, Url) -> String]
http.request-parts = [
    both (.0 | .method) (.1 | http.target-of) | format "{} {} HTTP/1.1\r\n",
    .1 | http.host-header | format "host: {}\r\n",
    const "user-agent: fwp\r\nconnection: close\r\n",
    .0 | .body | bytes.length | format "content-length: {}\r\n",
    .0 | .headers | map (format "{}: {}\r\n") | join "",
    const "\r\n",
]

# internal
http.target-of : Url -> String
http.target-of =
    if (.query | string.is-empty) .path (both .path .query | format "{}?{}")

# internal
http.read-all : Conn -> Bytes ! {Async, Network, Error[IoError]}
http.read-all = both id (const http.no-bytes) | loop http.read-all-step

# internal
http.read-all-step : (Conn, Bytes) -> Step[(Conn, Bytes), Bytes] ! {Async, Network, Error[IoError]}
http.read-all-step = fork http.read-all-got id (.0 | tcp.read 65536)

# internal
http.read-all-got : (Conn, Bytes) -> Bytes -> Step[(Conn, Bytes), Bytes]
http.read-all-got = curry (if
    (.1 | bytes.length | eq 0)
    (.0 | .1 | Stop)
    (both (.0 | .0) (fork bytes.append .1 (.0 | .1)) | Again))

# internal
http.parse-client : Bytes -> ClientResponse ! {Error[IoError]}
http.parse-client = fork http.client-split id (bytes.find http.crlf2)

# internal
http.client-split : Bytes -> Option[I64] -> ClientResponse ! {Error[IoError]}
http.client-split = curry (match
    (_, None) -> const (fail { kind = "http", message = "malformed response" })
    (_, Some _) -> curry (fork
        http.client-head
        (fork http.bytes-drop (.1 | add 4) .0)
        (fork http.bytes-take .1 .0 | http.parse-response-head)))

# internal
http.client-head : Bytes -> Result[(String, I64, String, List[(String, String)]), String] -> ClientResponse ! {Error[IoError]}
http.client-head = curry (match
    (_, Err _) ->
        curry (.1 | make IoError { kind = const "http", message = id } | fail)
    (_, Ok _) -> curry (make ClientResponse {
        status = .1 | .1,
        headers = .1 | .3,
        body = http.client-body,
    }))

# internal
http.client-body : (Bytes, (String, I64, String, List[(String, String)])) -> Bytes ! {Error[IoError]}
http.client-body =
    if
        (.1
            | .3
            | json.lookup "transfer-encoding"
            | option.map lower
            | eq (Some "chunked"))
        (.0 | http.dechunk)
        (fork
            http.take-length
            (.1 | .3 | json.lookup "content-length" | option.and-then parse-int)
            .0)

# internal
http.take-length : Option[I64] -> Bytes -> Bytes
http.take-length = curry (match
    (None, _) -> id
    (Some _, _) -> http.bytes-take)

# internal
http.dechunk : Bytes -> Bytes ! {Error[IoError]}
http.dechunk = both id (const http.no-bytes) | loop http.dechunk-step

# internal
http.dechunk-step : (Bytes, Bytes) -> Step[(Bytes, Bytes), Bytes] ! {Error[IoError]}
http.dechunk-step = fork http.dechunk-line id (.0 | bytes.find http.crlf)

# internal
http.dechunk-line : (Bytes, Bytes) -> Option[I64] -> Step[(Bytes, Bytes), Bytes] ! {Error[IoError]}
http.dechunk-line = curry (match
    (_, None) ->
        const (fail { kind = "http", message = "malformed chunked body" })
    (_, Some _) -> curry (fork
        http.dechunk-size
        id
        (fork http.bytes-take .1 (.0 | .0)
            | string.from-bytes
            | option.unwrap-or ""
            | http.chunk-size)))

# internal
http.chunk-size : String -> Option[I64]
http.chunk-size =
    fork option.unwrap-or id (string.split-once ";" | option.map .0)
    | trim
    | http.parse-hex

# internal
http.dechunk-size : ((Bytes, Bytes), I64) -> Option[I64] -> Step[(Bytes, Bytes), Bytes] ! {Error[IoError]}
http.dechunk-size = curry (match
    (_, None) ->
        const (fail { kind = "http", message = "malformed chunked body" })
    (_, Some 0) -> .0 | .1 | Stop
    (_, Some _) -> curry (both http.chunk-rest http.chunk-acc | Again))

# internal
http.chunk-rest : (((Bytes, Bytes), I64), I64) -> Bytes
http.chunk-rest =
    fork http.bytes-drop (fork add (.0 | .1) (.1 | add 4)) (.0 | .0 | .0)

# internal
http.chunk-acc : (((Bytes, Bytes), I64), I64) -> Bytes
http.chunk-acc =
    fork
        bytes.append
        (fork
            apply
            (.0 | .0 | .0)
            (both (.0 | .1 | add 2) .1 | uncurry bytes.slice))
        (.0 | .0 | .1)

test "hex" = [255 | http.to-hex, -16 | http.to-hex] | eq ["ff", "-10"]
test "parse-hex" =
    ["1A", "", "xyz"] | map http.parse-hex | eq [Some 26, None, None]
test "http.cookies" =
    Request {
        method = "GET",
        path = "/",
        query = "",
        version = "HTTP/1.1",
        headers = [("cookie", "a=1; b=\"two words\""), ("cookie", "c=")],
        body = http.no-bytes,
        params = [],
        remote = "",
    }
    | both (http.cookie "b") http.cookies
    | eq (Some "two words", [("a", "1"), ("b", "two words"), ("c", "")])
