# C interop: raw pointers and memory for `foreign "C"` functions.
#
#     foreign "C" strlen : String -> USize
#     repr(C) DivResult = { quot: I32, rem: I32 }
#     foreign "C" div : I32 -> I32 -> DivResult
#
# Pointers are only dereferenced under the `Unsafe` effect. `Option[Ptr[T]]`
# is a nullable pointer (`None` is NULL); fwp itself has no null.
#
# Foreign-function interoperation (FFI) calls C code from fwp. A pointer is an
# address, and Ptr[T] says what element type it addresses. mem.alloc takes bytes;
# ptr.at steps by elements. The programmer must ensure valid addresses and free
# raw allocations with mem.free. Unsafe records this obligation, not a proof.
# repr(C) requests C record layout; a callback is a function passed for C to call.
# Tutorial 9 follows a buffer from allocation through sorting to release.

Ptr[T] = builtin

# Zero-initialized bytes. Nonpositive counts allocate one byte; counts that
# exceed the target's address width trap before allocation.
foreign "fwp" mem.alloc : I64 -> Ptr[a] ! {Unsafe}
foreign "fwp" mem.free : Ptr[a] -> () ! {Unsafe}
# a NUL-terminated copy of a string, to be freed with mem.free
foreign "fwp" mem.string : String -> Ptr[U8] ! {Unsafe}
foreign "fwp" ptr.cast : Ptr[a] -> Ptr[b]
# The address of the n-th element; offsets wrap at the native pointer width.
# ISize/USize elements use ptrdiff_t/size_t storage: 4 bytes on a 32-bit target,
# 8 bytes on the maintained 64-bit targets.
foreign "fwp" ptr.at : I64 -> Ptr[a] -> Ptr[a] where Numeric[a]
foreign "fwp" ptr.read : Ptr[a] -> a ! {Unsafe} where Numeric[a]
foreign "fwp" ptr.write : a -> Ptr[a] -> () ! {Unsafe} where Numeric[a]
# the NUL-terminated string at a pointer
foreign "fwp" ptr.read-string : Ptr[a] -> String ! {Unsafe}
foreign "fwp" ptr.address : Ptr[a] -> U64
