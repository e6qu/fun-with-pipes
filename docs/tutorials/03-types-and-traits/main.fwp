pair-up : a -> (a, a) where Dup[a]
pair-up = both id id

trait Describe[T] =
    describe : T -> String

Temperature = { celsius: F64 }

impl Describe[Temperature] =
    describe = .celsius | format "{} °C"

impl Describe[Bool] =
    describe = match
        True -> "yes"
        False -> "no"

shout : a -> String where Describe[a]
shout = describe | upper

half : F32 -> F32
half = div 2

main = [
    7 | pair-up | echo,
    21.5 | make Temperature { celsius = id } | describe | print,
    True | shout | print,
    3 | half | echo,
] | ignore
